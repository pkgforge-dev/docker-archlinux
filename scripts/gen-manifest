#!/usr/bin/env bash
#
# Write one JSON file that lists every tag of an image: its digest, its
# platforms, its port and its anchor.
#
#   scripts/gen-manifest IMAGE OUT
#   scripts/gen-manifest ghcr.io/pkgforge-dev/archlinux manifest.json
#   scripts/gen-manifest docker.io/pkgforge/archlinux manifest-hub.json
#
# Call it once for each registry. The facts come from the registry, never
# from what a build believed it pushed.
#
# Each tag costs one manifest GET (scripts/lib.sh reg_get). The digest is the
# sha256 of the manifest bytes. MANIFEST_JOBS GETs run at once (default 8).
# A GET that answers 401 gets a new token and one more try. Any other answer
# that is not 200 stops the script.
# ⚠ On docker.io each manifest GET counts as a pull. Set REG_USER_docker_io
# and REG_PASS_docker_io to read with an account.
#
# The port of a tag comes from its alias prefix (scripts/ports aliases). The
# longest alias wins, because one alias can be the prefix of another (ppc and
# ppc64). The anchor is the rest of an <alias>-<anchor> tag. An anchor starts
# with a digit, and a dated tag starts with v.
#
# Environment:
#   MANIFEST_TAGS_FILE  read the tag names from this file and resolve no
#                       digest (a test seam)
#   MANIFEST_JOBS       GETs at once (default 8)
#   SOURCE_COMMIT       recorded in the file
#
# Exit status: 0 written, 1 the manifest cannot be made, 2 usage.
set -euo pipefail
shopt -s inherit_errexit

PROG=gen-manifest
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORTS="$ROOT/scripts/ports"

if [ "$#" -ne 2 ] || [ -z "$1" ] || [ -z "$2" ]; then
  echo "usage: gen-manifest IMAGE OUT" >&2
  exit 2
fi
image="$1"
out="$2"
need awk jq sha256sum

registry="${image%%/*}"
repo="${image#*/}"
case "$registry" in
  *.* | *:* | localhost) ;;
  *) die "the image must name its registry: $image" \
    "for example ghcr.io/OWNER/NAME or docker.io/ORG/NAME" ;;
esac
JOBS="${MANIFEST_JOBS:-8}"
[[ "$JOBS" =~ ^[1-9][0-9]*$ ]] || die "MANIFEST_JOBS '$JOBS' is not a positive number"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

#---------------------------------------------------------------------------#
# The tag list.
#---------------------------------------------------------------------------#
resolve=1
if [ -n "${MANIFEST_TAGS_FILE:-}" ]; then
  [ -f "$MANIFEST_TAGS_FILE" ] || die "no such tag file: $MANIFEST_TAGS_FILE"
  tr -d '\r' < "$MANIFEST_TAGS_FILE" | awk 'NF' > "$work/tags.txt"
  resolve=0
  note "tags read from $MANIFEST_TAGS_FILE, no digest is resolved"
else
  reg_tags "$registry" "$repo" "$work/tags.txt" || die "the tag list of $repo on $registry cannot be read" \
    "reproduce: scripts/registry-tags $registry $repo"
fi

total="$(awk 'END { print NR + 0 }' "$work/tags.txt")"
[ "$total" -gt 0 ] || die "$image has no tags" \
  "a repository that people pull from always has latest" \
  "reproduce: scripts/registry-tags $registry $repo"
note "$total tag(s) on $image"

#---------------------------------------------------------------------------#
# Alias -> port, from scripts/ports.
#---------------------------------------------------------------------------#
: > "$work/aliases.tsv"
for a in $("$PORTS" list); do
  "$PORTS" aliases "$a" | awk -v a="$a" 'NF { print $1 "\t" a }' >> "$work/aliases.tsv"
done
[ -s "$work/aliases.tsv" ] || die "scripts/ports gave no alias" "reproduce: scripts/ports field aliases"

# NR, tag, alias, port, anchor; "-" for none.
awk -F'\t' '
  NR == FNR { port[$1] = $2; next }
  {
    t = $0; best = ""; rest = "-"
    for (a in port) {
      if (t == a && length(a) > length(best)) { best = a; rest = "-" }
      else if (index(t, a "-") == 1 && length(a) > length(best)) {
        best = a
        r = substr(t, length(a) + 2)
        rest = (r ~ /^[0-9]/) ? r : "-"
      }
    }
    printf "%d\t%s\t%s\t%s\t%s\n", FNR, t, (best == "" ? "-" : best), (best == "" ? "-" : port[best]), rest
  }' "$work/aliases.tsv" "$work/tags.txt" > "$work/named.tsv"

#---------------------------------------------------------------------------#
# Digest and platforms of each tag, MANIFEST_JOBS at once.
#---------------------------------------------------------------------------#
# resolve_chunk K -> rows of chunk K in $work/rows.K, faults in $work/err.K
resolve_chunk() {
  local k="$1" n tag rest token code digest platforms rc
  token=""
  rc=0
  token="$(reg_token "$registry" "$repo")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "no token for $repo on $registry (reg_token exit $rc)" >> "$work/err.$k"
    return 1
  fi
  while IFS=$'\t' read -r n tag rest; do
    code="$(reg_get "$registry" "$repo" "$tag" "$work/body.$k" "$token")" || code=000
    if [ "$code" = 401 ]; then
      token="$(reg_token "$registry" "$repo")" || token=""
      code="$(reg_get "$registry" "$repo" "$tag" "$work/body.$k" "$token")" || code=000
    fi
    if [ "$code" != 200 ]; then
      echo "$registry answered HTTP $code for $tag. reproduce: curl -sSI https://$(reg_host "$registry")/v2/$repo/manifests/$tag" >> "$work/err.$k"
      return 1
    fi
    digest="sha256:$(sha256sum "$work/body.$k" | awk '{ print $1 }')"
    platforms="$(jq -r '
      if .manifests then
        [ .manifests[].platform
          | select(. != null and .os != "unknown")
          | .architecture + (if .variant then "/" + .variant else "" end) ]
        | sort | join(",")
      else "single" end' "$work/body.$k")"
    printf '%s\t%s\t%s\t%s\n' "$n" "$tag" "$digest" "${platforms:--}" >> "$work/rows.$k"
  done < "$work/chunk.$k"
}

if [ "$resolve" -eq 1 ]; then
  pids=()
  for ((k = 0; k < JOBS; k++)); do
    awk -F'\t' -v j="$JOBS" -v k="$k" '(NR - 1) % j == k' "$work/named.tsv" > "$work/chunk.$k"
    : > "$work/rows.$k"
    : > "$work/err.$k"
    resolve_chunk "$k" &
    pids+=("$!")
  done
  faults=0
  for ((k = 0; k < JOBS; k++)); do
    rc=0
    wait "${pids[$k]}" || rc=$?
    if [ "$rc" -ne 0 ]; then
      sed 's/^/  /' "$work/err.$k" >&2
      faults=$((faults + 1))
    fi
  done
  [ "$faults" -eq 0 ] || die "$faults of $JOBS reader(s) stopped; the manifest is not written" \
    "⛔ a tag with no digest is never written as a fact" \
    "the reasons are above"
  cat "$work"/rows.* | LC_ALL=C sort -t "$(printf '\t')" -k1,1n > "$work/resolved.tsv"
else
  awk -F'\t' '{ printf "%s\t%s\t-\t-\n", $1, $2 }' "$work/named.tsv" > "$work/resolved.tsv"
fi

# NR, tag, digest, platforms, alias, port, anchor
awk -F'\t' 'NR == FNR { a[$1] = $3 "\t" $4 "\t" $5; next } { print $0 "\t" a[$1] }' \
  "$work/named.tsv" "$work/resolved.tsv" | cut -f2- > "$work/rows.tsv"

rows="$(awk 'END { print NR + 0 }' "$work/rows.tsv")"
[ "$rows" = "$total" ] || die "read $total tags and made $rows rows" \
  "reproduce: scripts/gen-manifest $image /tmp/m.json"
resolved_count=0
[ "$resolve" -eq 1 ] && resolved_count="$total"

jq -n \
  --arg image "$image" \
  --arg registry "$registry" \
  --arg generated "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg source_commit "${SOURCE_COMMIT:--}" \
  --argjson total "$total" \
  --argjson resolved "$resolved_count" \
  --rawfile rows "$work/rows.tsv" \
  '{
     schema: "docker-archlinux/manifest/1",
     image: $image,
     registry: $registry,
     generated: $generated,
     source_commit: $source_commit,
     tag_count: $total,
     resolved_count: $resolved,
     tags: (
       $rows
       | split("\n")
       | map(select(length > 0))
       | map(split("\t"))
       | map({
           tag:      .[0],
           digest:   .[1],
           platforms: (if .[2] == "-" or .[2] == "" then [] elif .[2] == "single" then ["single"] else (.[2] | split(",")) end),
           alias:    (if .[3] == "-" then null else .[3] end),
           docker_architecture: (if .[4] == "-" then null else .[4] end),
           anchor:   (if .[5] == "-" then null else .[5] end)
         })
     )
   }' > "$out"

jq -e . "$out" > /dev/null || die "the manifest is not valid JSON: $out"
note "wrote $out: $total tag(s), $resolved_count with a digest"
