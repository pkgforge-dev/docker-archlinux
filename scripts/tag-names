#!/usr/bin/env bash
#
# Print the tags for one port, or for the multi-platform index.
#
#   scripts/tag-names [--existing FILE] arch ARCH VERSION ANCHOR IMAGE...
#   scripts/tag-names [--existing FILE] index VERSION IMAGE...
#   scripts/tag-names aliases ARCH
#
# ARCH is a port (scripts/ports list). VERSION is the build date, for example
# 2026.08.26, with no leading v. ANCHOR is the pacman version of the port.
# Each port has its own anchor, because the ports do not release together.
#
# The tag families:
#
#   latest               rolling   index
#   v<version>           pinned    index
#   <alias>              rolling   one platform
#   <alias>-v<version>   pinned    one platform
#   <alias>-<anchor>     pinned    one platform
#
# The aliases of a port come from ports/<arch>.conf. The first alias is the
# uname -m name. All aliases of a port name one manifest.
#
# ⛔ A pinned tag is made once and never points at another image. A rolling
# tag moves with each build. --existing FILE leaves out each pinned tag that
# is a line of FILE, and names it on stderr. FILE is the tag list of the
# target repository (scripts/registry-tags). Without --existing every tag is
# printed.
#
# aliases ARCH prints the aliases of ARCH on one line, separated by spaces.
#
# Exit status: 0 printed, 1 an unknown port, a bad tag or a bad argument.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORTS="$ROOT/scripts/ports"

die() {
  echo "tag-names: $*" >&2
  exit 1
}

# aliases_for ARCH -> the aliases of ARCH, on one line
aliases_for() {
  local list
  list="$("$PORTS" list)"
  grep -qxF -- "$1" <<< "$list" || die "unknown architecture: $1 (ports: $(tr '\n' ' ' <<< "$list"))"
  "$PORTS" aliases "$1" | awk 'NF { printf "%s%s", sep, $1; sep = " " } END { printf "\n" }'
}

valid_tag() {
  [[ "$1" =~ ^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$ ]]
}

existing=""

# The tags to print. Nothing is printed until each tag is checked.
OUT=()

# emit rolling|pinned TAG IMAGE...
emit() {
  local kind="$1" tag="$2" image
  shift 2
  valid_tag "$tag" || die "not a valid tag: $tag"
  if [ "$kind" = pinned ] && [ -n "$existing" ] && grep -qxF -- "$tag" "$existing"; then
    echo "tag-names: $tag is pinned and exists, so it stays where it is" >&2
    return 0
  fi
  for image in "$@"; do
    OUT+=("$image:$tag")
  done
}

if [ "${1:-}" = "--existing" ]; then
  existing="${2:-}"
  [ -n "$existing" ] || die "--existing needs the file of tags that the repository has"
  # ⛔ A list that cannot be read is not an empty list. Read as empty, it
  # would move every pinned tag.
  if [ ! -f "$existing" ] || [ ! -r "$existing" ]; then
    die "--existing $existing is not a readable file"
  fi
  shift 2
fi

mode="${1:-}"
case "$mode" in
  arch)
    shift
    [ "$#" -ge 4 ] || die "usage: tag-names arch ARCH VERSION ANCHOR IMAGE..."
    port="$1"
    version="$2"
    anchor="$3"
    shift 3
    [ -n "$version" ] || die "version is empty"
    [ -n "$anchor" ] || die "anchor is empty"
    # An assignment, not a word list in the for line: a die in a command
    # substitution inside the for line does not stop this script.
    alias_list="$(aliases_for "$port")"
    for alias in $alias_list; do
      emit rolling "$alias" "$@"
      emit pinned "$alias-v$version" "$@"
      emit pinned "$alias-$anchor" "$@"
    done
    ;;
  index)
    shift
    [ "$#" -ge 2 ] || die "usage: tag-names index VERSION IMAGE..."
    version="$1"
    shift
    [ -n "$version" ] || die "version is empty"
    emit rolling "latest" "$@"
    emit pinned "v$version" "$@"
    ;;
  aliases)
    shift
    [ "$#" -eq 1 ] || die "usage: tag-names aliases ARCH"
    aliases_for "$1"
    ;;
  *)
    die "usage: tag-names [--existing FILE] arch|index|aliases ..."
    ;;
esac

if [ "${#OUT[@]}" -gt 0 ]; then
  printf '%s\n' "${OUT[@]}"
fi
