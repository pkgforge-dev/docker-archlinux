#!/usr/bin/env bash
#
# Keep every workflow of the tree enabled on GitHub.
#
#   scripts/keep-schedules-enabled
#
# ⛔ GitHub disables the scheduled workflows of a repository after 60 days with
# no activity. A disabled schedule makes no run, so no run can report it. This
# script enables each workflow in state disabled_inactivity. It also enables
# each active workflow; GitHub accepts that and changes nothing.
#
# ⚠ A workflow that a person disabled stays disabled. The script prints it on a
# line that starts with "manual". scripts/watch-schedules reads that line and
# raises the issue schedules-stopped.
#
# Only workflows whose file is in this tree are read. GitHub keeps a record of a
# deleted workflow file, and the script leaves that record alone.
#
# Output, one line per workflow of the tree:
#   enabled   PATH  was STATE
#   manual    PATH  disabled by a person, left disabled
#   skipped   PATH  state STATE
#
# Environment: GH_TOKEN with actions: write, GITHUB_REPOSITORY (owner/name).
#
# Exit status: 0 every workflow of the tree is enabled or disabled by a person,
# 1 could not read or enable.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die() {
  echo "keep-schedules-enabled: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

need() {
  command -v "$1" > /dev/null || die "$1 is required"
}
need gh
need jq

slug="${GITHUB_REPOSITORY:-}"
case "$slug" in
  */*) ;;
  *) die "GITHUB_REPOSITORY is not owner/name: ${slug:-<unset>}" ;;
esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

gh api --paginate "repos/$slug/actions/workflows?per_page=100" > "$work/workflows.json"
jq -r '.workflows[] | "\(.id)\t\(.state)\t\(.path)"' "$work/workflows.json" | tr -d '\r' > "$work/workflows.tsv"

[ -s "$work/workflows.tsv" ] || die "GitHub listed no workflow for $slug" \
  "the token needs actions: read at least" \
  "reproduce: gh api repos/$slug/actions/workflows --jq '.workflows[].path'"

seen=0
while IFS=$'\t' read -r id state path; do
  [ -n "$id" ] || continue
  [ -f "$REPO_ROOT/$path" ] || continue
  seen=$((seen + 1))
  case "$state" in
    active | disabled_inactivity)
      gh api -X PUT "repos/$slug/actions/workflows/$id/enable" > /dev/null
      printf 'enabled   %-48s was %s\n' "$path" "$state"
      ;;
    disabled_manually)
      printf 'manual    %-48s disabled by a person, left disabled\n' "$path"
      ;;
    *)
      printf 'skipped   %-48s state %s\n' "$path" "$state"
      ;;
  esac
done < "$work/workflows.tsv"

[ "$seen" -gt 0 ] || die "no workflow that GitHub listed is in this tree" \
  "reproduce: gh api repos/$slug/actions/workflows --jq '.workflows[].path'"
echo "keep-schedules-enabled: $seen workflow(s) of the tree read"
