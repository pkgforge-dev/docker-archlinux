#!/usr/bin/env bash
#
# Print the number of whole days between two dates.
#
#   scripts/date-age 2026-01-01              days from that date to today (UTC)
#   scripts/date-age 2026-01-01 2026-02-15   days between the two dates: 45
#
# Each argument is YYYY-MM-DD or an ISO timestamp. Only the date part is read.
# The callers work in days: a dated tag has a date, and a cron tolerance is in
# days.
#
# ⭐ This is the only calendar routine for check-publish-recency,
# check-schedules-fired and check-keyring-pin. Do not write a second copy.
#
# ⛔ Do not use date -d, strftime or mktime. GNU date -d is not on every host,
# and strftime and mktime are gawk extensions that mawk does not have. The
# script uses integer arithmetic on the civil calendar.
#
# The result is negative when the first date is later than the second.
#
# Exit status:
#   0  the difference was printed
#   1  an argument is not a date
set -euo pipefail

die() {
  echo "date-age: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

from="${1:-}"
[ -n "$from" ] || die "usage: date-age <from> [<to>]" \
  "both may be YYYY-MM-DD or a full ISO timestamp"
to="${2:-$(date -u +%Y-%m-%d)}"

# Only the date part, so an ISO timestamp needs no separate parse.
from="${from:0:10}"
to="${to:0:10}"

for d in "$from" "$to"; do
  case "$d" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) die "not a date: $d" "expected YYYY-MM-DD, or an ISO timestamp starting with one" ;;
  esac
done

awk -v a="$from" -v b="$to" '
  # Days since 1970-01-01 on the civil calendar. The year starts in March, so
  # the leap day is the last day of the year and February needs no special case.
  function days(y, m, d,   era, yoe, doy, doe) {
    y -= (m <= 2)
    era = int((y >= 0 ? y : y - 399) / 400)
    yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
  }
  BEGIN {
    split(a, x, "-")
    split(b, y, "-")
    if (x[2] + 0 < 1 || x[2] + 0 > 12 || x[3] + 0 < 1 || x[3] + 0 > 31) {
      printf "date-age: not a real date: %s\n", a > "/dev/stderr"
      exit 1
    }
    if (y[2] + 0 < 1 || y[2] + 0 > 12 || y[3] + 0 < 1 || y[3] + 0 > 31) {
      printf "date-age: not a real date: %s\n", b > "/dev/stderr"
      exit 1
    }
    print days(y[1] + 0, y[2] + 0, y[3] + 0) - days(x[1] + 0, x[2] + 0, x[3] + 0)
  }' </dev/null
