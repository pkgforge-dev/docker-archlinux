#!/usr/bin/env bash
#
# Print the version of the anchor package of one port.
#
#   scripts/resolve-anchor ARCH
#   scripts/resolve-anchor --each ARCH
#
# The anchor package is pacman. Its version names the pinned tag
# <alias>-<anchor>. The ports are not in step, so each port has its own anchor.
#
# ARCH: the version from the database of the primary repository, which is the
# first repository of ports/ARCH.conf. The servers of its list are read in the
# order the build stage reads them: TRANSPORT and SKIP_SERVERS apply. The
# first server that serves a readable database with the package in it gives
# the version. Then the database of every other repository is read through its
# own list. ⛔ A repository that no server serves stops the port, because the
# build cannot install from it.
#
# --each ARCH: one line for each server of the primary list in the tree that
# is not plain http (in the lists of the tree: each https server), in list
# order:
#   SERVER VERSION   the server serves the primary database, with the package
#   SERVER -         it does not, or SKIP_SERVERS names it
# TRANSPORT does not apply. The transfers run at the same time.
#
# Environment:
#   ANCHOR_PACKAGE   default pacman
#   TRANSPORT, SKIP_SERVERS and the paths that scripts/lib-mirrors.sh reads
#
# Exit status: 0 the version (or the --each lines) is on stdout. 1 a
# repository has no readable database on any server, or an input cannot be
# read.
set -euo pipefail

PROG=resolve-anchor
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
# shellcheck source=scripts/lib-mirrors.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib-mirrors.sh"

ANCHOR_PACKAGE="${ANCHOR_PACKAGE:-pacman}"

usage() {
  die "usage: scripts/resolve-anchor [--each] ARCH" "ARCH is one of: $(port_list | tr '\n' ' ')"
}

each=0
if [ "${1:-}" = --each ]; then
  each=1
  shift
fi
[ "$#" -eq 1 ] || usage
arch="$1"
port_check "$arch"
need curl tar awk timeout od

parch="$(port_get "$arch" pacman_arch)"
repos="$(port_get "$arch" repos)"
primary="${repos%% *}"
lists="$(port_lists "$arch")"

# The list each repository reads, and every list name
declare -A list_of=()
names=()
while IFS= read -r line; do
  [ -n "$line" ] || continue
  names+=("${line%% *}")
  for r in ${line#* }; do
    list_of[$r]="${line%% *}"
  done
done <<< "$lists"
skip_check "${names[@]}"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# read_db SERVER REPO OUT -> 0 when OUT holds a readable database of REPO.
# DB_LISTING holds its members. Each failure is named on stderr.
read_db() {
  local url
  url="$(server_url "$1" "$2" "$parch")/$2.db"
  if ! fetch_db "$url" "$3"; then
    note "cannot read $url: $FETCH_WHY"
    return 1
  fi
  if ! db_open "$3"; then
    note "$url is not a readable database: $DB_WHY"
    return 1
  fi
}

#---------------------------------------------------------------------------#
# --each
#---------------------------------------------------------------------------#
if [ "$each" -eq 1 ]; then
  plist="${list_of[$primary]}"
  skips="$(skip_of "$plist")"
  https=()
  while IFS= read -r s; do
    case "$s" in
      http://*) ;;
      *) https+=("$s") ;;
    esac
  done < <(list_servers "$(list_file "$arch" "$plist")")
  i=0
  for s in "${https[@]}"; do
    if [ -n "$skips" ] && grep -qxF -e "$s" <<< "$skips"; then
      note "$plist: the build does not read $s (SKIP_SERVERS)"
      printf -- '-\n' > "$work/v.$i"
    else
      (
        v="-"
        if read_db "$s" "$primary" "$work/db.$i"; then
          v="$(db_version "$ANCHOR_PACKAGE")"
          [ -n "$v" ] || {
            note "$s serves $primary.db with no $ANCHOR_PACKAGE in it"
            v="-"
          }
        fi
        printf '%s\n' "$v" > "$work/v.$i"
      ) &
    fi
    i=$((i + 1))
  done
  wait
  i=0
  for s in "${https[@]}"; do
    v="-"
    [ ! -s "$work/v.$i" ] || v="$(cat "$work/v.$i")"
    printf '%s %s\n' "$s" "$v"
    i=$((i + 1))
  done
  exit 0
fi

#---------------------------------------------------------------------------#
# The primary repository gives the version
#---------------------------------------------------------------------------#
servers_of "$arch" "${list_of[$primary]}" build
version=""
from=""
for s in "${SERVERS[@]}"; do
  if ! read_db "$s" "$primary" "$work/db"; then
    continue
  fi
  version="$(db_version "$ANCHOR_PACKAGE")"
  if [ -n "$version" ]; then
    from="$s"
    break
  fi
  note "$(server_url "$s" "$primary" "$parch")/$primary.db has no $ANCHOR_PACKAGE, the next server is tried"
done
if [ -z "$version" ]; then
  die "no server of ${list_of[$primary]} gave the $ANCHOR_PACKAGE version for $arch" \
    "every server was tried, and each failure is above" \
    "regenerate the list with: scripts/gen-mirrorlist $arch"
fi
note "[$primary]: $ANCHOR_PACKAGE $version from $from"

#---------------------------------------------------------------------------#
# Every other repository must be readable too
#---------------------------------------------------------------------------#
missing=""
for repo in $repos; do
  [ "$repo" != "$primary" ] || continue
  servers_of "$arch" "${list_of[$repo]}" build
  got=""
  for s in "${SERVERS[@]}"; do
    if read_db "$s" "$repo" "$work/db"; then
      got="$s"
      break
    fi
  done
  if [ -z "$got" ]; then
    missing="$missing [$repo]"
  else
    note "[$repo]: readable from $got"
  fi
done
if [ -n "$missing" ]; then
  die "no server gave a readable database for$missing of $arch" \
    "the build cannot install from a repository it cannot read" \
    "each failure is above" \
    "regenerate the list with: scripts/gen-mirrorlist $arch"
fi

printf '%s\n' "$version"
