#!/usr/bin/env bash
#
# Refuse a build when the anchor of a port goes below what is already
# published for it.
#
#   scripts/check-anchor-floor ARCH ANCHOR
#
# ARCH is a port (scripts/ports list). ANCHOR is the pacman version that
# scripts/resolve-anchor gave for this build.
#
# The floor is the highest anchor in the published tags <alias>-<anchor> of
# ARCH, compared with scripts/vercmp. The tag list comes from GHCR first and
# from Docker Hub when GHCR gives no list or an empty list. With no tag of
# that shape there is no floor. When no registry gives a list, the check
# cannot run.
#
# ⛔ A stale package set is validly signed, so signatures do not stop a
# rollback. Some shipped mirrors are plain http. This check is the guard.
#
# A build below the floor passes in two cases only:
#   - ALLOW_ANCHOR_DOWNGRADE names ARCH, or is "all".
#   - An upstream revert: scripts/resolve-anchor --each ARCH shows at least 2
#     reachable https servers, and each of them serves ANCHOR.
#
# Environment:
#   FLOOR_IMAGE             the published GHCR image, ghcr.io/OWNER/NAME (required)
#   FLOOR_HUB_IMAGE         the published Docker Hub image, docker.io/ORG/NAME
#   ALLOW_ANCHOR_DOWNGRADE  none (default), all, or a list of ports
#   FLOOR_TAGS_FILE         read the tag list from this file, not a registry
#   RESOLVE_ANCHOR          the resolve-anchor command (default scripts/resolve-anchor)
#   SKIP_SERVERS, TRANSPORT given to resolve-anchor as they are
#
# Output, one line on stdout, the first word is the verdict:
#   nofloor ARCH ANCHOR             nothing is published for ARCH
#   ok      ARCH ANCHOR FLOOR       ANCHOR is at or above the floor
#   allowed ARCH ANCHOR FLOOR       below, and ALLOW_ANCHOR_DOWNGRADE names ARCH
#   revert  ARCH ANCHOR FLOOR N     below, and N https servers serve ANCHOR
#   behind  ARCH ANCHOR FLOOR       below, refused
#
# Exit status: 0 the build may go on, 3 refused (behind), 1 the check could
# not run or no tag can carry the anchor, 2 usage.
set -euo pipefail

PROG=check-anchor-floor
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORTS="$ROOT/scripts/ports"
VERCMP="$ROOT/scripts/vercmp"
RESOLVE_ANCHOR="${RESOLVE_ANCHOR:-$ROOT/scripts/resolve-anchor}"
ALLOW="${ALLOW_ANCHOR_DOWNGRADE:-none}"

if [ "$#" -ne 2 ]; then
  echo "usage: check-anchor-floor ARCH ANCHOR" >&2
  exit 2
fi
arch="$1"
anchor="$2"

need awk jq
[ -n "$anchor" ] || die "the anchor for $arch is empty" \
  "reproduce: scripts/resolve-anchor $arch"

ports_list="$("$PORTS" list)"
grep -qxF -- "$arch" <<< "$ports_list" || die "$arch is not a port" \
  "ports: $(tr '\n' ' ' <<< "$ports_list")" \
  "reproduce: scripts/ports list"

# ⛔ Each <alias>-<anchor> must be a tag (valid_tag in scripts/tag-names: no
# + and no :, at most 128 characters). Else the publish stops at this port.
alias_list="$("$PORTS" aliases "$arch")"
while IFS= read -r a; do
  [ -n "$a" ] || continue
  [[ "$a-$anchor" =~ ^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$ ]] ||
    die "the anchor '$anchor' of $arch is not a version that a tag can carry: '$a-$anchor'" \
      "a tag has only A-Z a-z 0-9 _ . - and at most 128 characters" \
      "reproduce: scripts/resolve-anchor $arch"
done <<< "$alias_list"

# The allow list is data from a dispatch input. Each word is checked.
allowed=0
case "$ALLOW" in
  none | "") ;;
  all) allowed=1 ;;
  *)
    for w in $ALLOW; do
      case "$w" in
        none | all) die "ALLOW_ANCHOR_DOWNGRADE mixes '$w' with port names: '$ALLOW'" ;;
      esac
      grep -qxF -- "$w" <<< "$ports_list" || die "ALLOW_ANCHOR_DOWNGRADE names '$w', which is not a port" \
        "it takes none, all, or port names from: $(tr '\n' ' ' <<< "$ports_list")"
      [ "$w" = "$arch" ] && allowed=1
    done
    ;;
esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

#---------------------------------------------------------------------------#
# The published tags.
#---------------------------------------------------------------------------#

# split_image IMAGE -> "REGISTRY REPO"
split_image() {
  local image="$1" first="${1%%/*}"
  case "$first" in
    *.* | *:* | localhost) printf '%s %s\n' "$first" "${image#*/}" ;;
    *) printf 'docker.io %s\n' "$image" ;;
  esac
}

# read_list IMAGE OUT -> 0 read (maybe empty), 1 could not read
read_list() {
  local reg repo
  read -r reg repo <<< "$(split_image "$1")"
  if reg_tags "$reg" "$repo" "$2"; then
    note "read $(awk 'END { print NR + 0 }' "$2") tag(s) from $1"
    return 0
  fi
  warn "the tag list of $1 cannot be read. reproduce: scripts/registry-tags $reg $repo"
  return 1
}

if [ -n "${FLOOR_TAGS_FILE:-}" ]; then
  [ -r "$FLOOR_TAGS_FILE" ] || die "FLOOR_TAGS_FILE $FLOOR_TAGS_FILE cannot be read"
  tr -d '\r' < "$FLOOR_TAGS_FILE" > "$work/tags"
  note "read $(awk 'END { print NR + 0 }' "$work/tags") tag(s) from $FLOOR_TAGS_FILE"
else
  [ -n "${FLOOR_IMAGE:-}" ] || die "FLOOR_IMAGE is not set" \
    "set it to the published GHCR image, for example ghcr.io/OWNER/archlinux"
  # ⛔ An empty list is a floor of nothing. It counts only when each registry
  # that was asked gave a list, and each list is empty.
  ghcr_rc=0
  read_list "$FLOOR_IMAGE" "$work/ghcr-tags" || ghcr_rc=$?
  if [ "$ghcr_rc" -eq 0 ] && [ -s "$work/ghcr-tags" ]; then
    cp "$work/ghcr-tags" "$work/tags"
  else
    hub_rc=0
    : > "$work/hub-tags"
    if [ -n "${FLOOR_HUB_IMAGE:-}" ]; then
      read_list "$FLOOR_HUB_IMAGE" "$work/hub-tags" || hub_rc=$?
    fi
    if [ "$hub_rc" -eq 0 ] && [ -s "$work/hub-tags" ]; then
      cp "$work/hub-tags" "$work/tags"
    elif [ "$ghcr_rc" -eq 0 ] && [ "$hub_rc" -eq 0 ]; then
      : > "$work/tags"
    else
      die "the floor cannot be read: no registry gave a tag list with tags in it" \
        "⛔ a guard that a transient can switch off is not a guard" \
        "reproduce: scripts/registry-tags $(split_image "$FLOOR_IMAGE")"
    fi
  fi
fi

#---------------------------------------------------------------------------#
# The floor: the highest <alias>-<anchor> over every alias of ARCH.
#
# The dated family <alias>-v<date> has the same prefix. An anchor starts
# with a digit and a date tag starts with v.
#---------------------------------------------------------------------------#
"$PORTS" aliases "$arch" > "$work/aliases"
awk 'NR == FNR { if (NF) a[$1 "-"] = 1; next }
     {
       for (p in a) {
         if (index($0, p) == 1) {
           v = substr($0, length(p) + 1)
           if (v ~ /^[0-9]/) print v
         }
       }
     }' "$work/aliases" "$work/tags" | LC_ALL=C sort -u > "$work/anchors"

floor=""
while IFS= read -r c; do
  [ -n "$c" ] || continue
  if [ -z "$floor" ] || [ "$("$VERCMP" "$c" "$floor")" -gt 0 ]; then
    floor="$c"
  fi
done < "$work/anchors"

if [ -z "$floor" ]; then
  echo "nofloor $arch $anchor"
  note "no <alias>-<anchor> tag is published for $arch, so there is no floor"
  exit 0
fi

cmp="$("$VERCMP" "$anchor" "$floor")"
if [ "$cmp" -ge 0 ]; then
  echo "ok $arch $anchor $floor"
  note "$arch: anchor $anchor is at or above the floor $floor"
  exit 0
fi

note "$arch: anchor $anchor is below the floor $floor"

if [ "$allowed" -eq 1 ]; then
  echo "allowed $arch $anchor $floor"
  warn "ALLOW_ANCHOR_DOWNGRADE='$ALLOW' takes the downgrade of $arch from $floor to $anchor"
  exit 0
fi

#---------------------------------------------------------------------------#
# The revert rule: every reachable https server serves the lower version.
#---------------------------------------------------------------------------#
each_rc=0
"$RESOLVE_ANCHOR" --each "$arch" > "$work/each" 2> "$work/each.err" || each_rc=$?
sed 's/^/  /' "$work/each.err" >&2
if [ "$each_rc" -ne 0 ]; then
  warn "resolve-anchor --each $arch exited $each_rc, so an upstream revert cannot be confirmed"
fi

read -r reachable same <<< "$(awk -v want="$anchor" '
  $1 ~ /^https:\/\// && NF >= 2 && $2 != "-" {
    n++
    if ($2 == want) s++
  }
  END { printf "%d %d\n", n, s }' "$work/each")"
sed 's/^/  server: /' "$work/each" >&2

if [ "$each_rc" -eq 0 ] && [ "$reachable" -ge 2 ] && [ "$reachable" -eq "$same" ]; then
  echo "revert $arch $anchor $floor $reachable"
  warn "$arch goes from $floor to $anchor: all $reachable reachable https servers serve $anchor, so this is an upstream revert"
  exit 0
fi

echo "behind $arch $anchor $floor"
echo "$PROG: $arch is refused: the anchor $anchor is below the published floor $floor" >&2
echo "  reachable https servers: $reachable, serving $anchor: $same (a revert needs at least 2, all serving it)" >&2
echo "  if upstream reverted, dispatch the build with allow_anchor_downgrade = $arch" >&2
echo "  reproduce: scripts/resolve-anchor --each $arch; scripts/vercmp $anchor $floor" >&2
exit 3
