#!/usr/bin/env bash
#
# Keep one pull request open for each kind of freshness change, and none when
# the change is not necessary.
#
#   scripts/propose-change <branch> <title> <body-file> <path>...
#   scripts/propose-change --withdraw <branch> <note>
#
# ⭐ One branch for each kind of change, with no date in its name. Each run
# writes the branch again. A bump that nobody merged yet is updated in place
# and does not get a second pull request.
#
# ⭐ --withdraw closes the pull request of a branch when the check finds
# nothing to change. The change came another way, or upstream moved back. An
# open freshness pull request is then always one to merge.
#
# ⛔ The script does not write over a branch whose head commit is not by
# github-actions[bot]. A person who pushes a fix to the branch keeps it. The
# script then prints the author and does nothing, for a proposal and for a
# withdrawal.
#
# ⛔ The pull request gets its required check. A pull request that the
# GITHUB_TOKEN opens starts no workflow. workflow_dispatch is the one event
# that the token can start. So the script starts ci.yml on the branch, and the
# result shows on the commit of the pull request.
#
# Environment: GH_TOKEN with contents: write, pull-requests: write and
# actions: write; GITHUB_REPOSITORY (owner/name). DEFAULT_BRANCH names the base
# branch; when it is not set, the script reads the default branch of the
# repository. Run it in the work tree, on the commit to build on, with a
# checkout that can push.
#
# Exit status: 0 proposed, withdrawn, left to a person, or nothing to do;
# 1 could not.
set -euo pipefail

BOT_NAME="github-actions[bot]"
BOT_EMAIL="41898282+github-actions[bot]@users.noreply.github.com"

die() {
  echo "propose-change: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

need() {
  command -v "$1" > /dev/null || die "$1 is required"
}
need git
need gh
need jq

slug="${GITHUB_REPOSITORY:-}"
case "$slug" in
  */*) ;;
  *) die "GITHUB_REPOSITORY is not owner/name: ${slug:-<unset>}" ;;
esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# open_pr BRANCH -> sets pr to the number of the open pull request that the
# bot opened from BRANCH of this repository, or to nothing
#
# ⛔ gh pr list --head matches the branch name only. A pull request from a fork
# with the same branch name is listed too. Without the filter, a proposal
# writes its title and body into that pull request, and a withdrawal closes
# it.
open_pr() {
  gh pr list --repo "$slug" --head "$1" --state open --json number,isCrossRepository,author \
    > "$work/prs.json"
  pr="$(jq -r '[.[] | select(.isCrossRepository == false)
    | select(.author.login == "app/github-actions" or .author.login == "github-actions[bot]")]
    | sort_by(.number) | .[0].number // empty' "$work/prs.json")"
}

check_branch() {
  case "$1" in
    freshness/*) ;;
    *) die "a proposed change goes on a freshness/ branch, and $1 is not one" ;;
  esac
}

# person_on BRANCH: sets who to the author of the head commit of the remote
# BRANCH when that author is not the bot. who stays empty when the bot made
# the head commit or the branch does not exist. Called directly, never inside
# $( ), so set -e stops the script when git fails.
person_on() {
  local rc=0
  who=""
  git ls-remote --exit-code origin "refs/heads/$1" > "$work/remote.txt" || rc=$?
  case "$rc" in
    0) ;;
    2) return 0 ;;
    *) die "git ls-remote origin refs/heads/$1 ended $rc" "reproduce: git ls-remote origin refs/heads/$1" ;;
  esac
  git fetch -q --depth=1 origin "refs/heads/$1"
  git log -1 --format='%an <%ae>' FETCH_HEAD > "$work/author.txt"
  who="$(awk 'NR == 1' "$work/author.txt")"
  if [ "$who" = "$BOT_NAME <$BOT_EMAIL>" ]; then
    who=""
  fi
}

if [ "${1:-}" = "--withdraw" ]; then
  [ "$#" -eq 3 ] || die "usage: propose-change --withdraw <branch> <note>"
  branch="$2"
  note="$3"
  check_branch "$branch"
  open_pr "$branch"
  if [ -z "$pr" ]; then
    echo "propose-change: no open pull request on $branch; nothing to withdraw"
    exit 0
  fi
  person_on "$branch"
  if [ -n "$who" ]; then
    echo "propose-change: left to a person: the head commit of $branch is by $who; #$pr stays open"
    exit 0
  fi
  gh pr close "$pr" --repo "$slug" --comment "$note" --delete-branch
  echo "propose-change: #$pr withdrawn; $branch deleted"
  exit 0
fi

[ "$#" -ge 4 ] || die "usage: propose-change <branch> <title> <body-file> <path>..."
branch="$1"
title="$2"
body="$3"
shift 3
check_branch "$branch"
[ -f "$body" ] || die "no body file at $body"

base="${DEFAULT_BRANCH:-}"
if [ -z "$base" ]; then
  gh api "repos/$slug" > "$work/repo.json"
  base="$(jq -r '.default_branch // empty' "$work/repo.json")"
  [ -n "$base" ] || die "the repository record of $slug has no default_branch" \
    "reproduce: gh api repos/$slug --jq .default_branch"
fi

person_on "$branch"
if [ -n "$who" ]; then
  echo "propose-change: left to a person: the head commit of $branch is by $who; the branch is not written"
  exit 0
fi

git add -A -- "$@"
rc=0
git diff --cached --quiet || rc=$?
case "$rc" in
  0)
    echo "propose-change: nothing changed under $*; nothing to propose"
    exit 0
    ;;
  1) ;;
  *) die "git diff --cached ended $rc" ;;
esac

git -c user.name="$BOT_NAME" -c user.email="$BOT_EMAIL" commit -q -m "$title"
git push --force origin "HEAD:refs/heads/$branch"

open_pr "$branch"
if [ -n "$pr" ]; then
  gh pr edit "$pr" --repo "$slug" --title "$title" --body-file "$body" > /dev/null
  echo "propose-change: #$pr updated in place; $branch is now $(git rev-parse --short HEAD)"
else
  gh pr create --repo "$slug" --base "$base" --head "$branch" \
    --title "$title" --body-file "$body"
fi

gh workflow run ci.yml --repo "$slug" --ref "$branch"
echo "propose-change: CI started on $branch"
