#!/usr/bin/env python3
#
# Render the status site from what scripts/status-collect measured.
#
#   python3 -I scripts/status-render IN OUT_SITE
#
# IN holds status.json (required), history.jsonl and evidence/ (optional).
# OUT_SITE gets:
#   index.html                   one static page: inline CSS, light and dark.
#                                Each time is UTC text in a <time> element.
#                                One inline script puts the local time and the
#                                age of each time in its title
#   badges/<arch>.svg            image age and state of one port
#   badges/all.svg               ports whose image is current, of all ports
#   badges/latest.svg            platforms in the index tag latest
#   badges/registries.svg        GHCR tags that Docker Hub carries
#   badges/build.svg             last build of each port: passed, of all
#   badges/size-<arch>.svg       compressed image size of one port
#   badges/packages-<arch>.svg   package count of one port
#   charts/freshness.svg         image age per port, against the build interval
#   charts/size.svg              compressed and installed size per port
#   charts/packages.svg          package count per port
#   charts/coverage.svg          tags per port on GHCR, and on Docker Hub
#   charts/build.svg             job time of the last build per port, and its result
#   charts/history-age.svg       image age per port, last 30 days
#   charts/history-size.svg      compressed size per port, last 30 days
#   charts/history-build.svg     build result per port and day, last 30 days
#   charts/narrow/<chart>.svg    the same charts 420 px wide, for a phone
#   status.json, history.json, history.jsonl, evidence/   the data
#
# A value that could not be read is "unknown", never 0. A figure over part of
# the ports says which part: "6 of 8 measured". A state colour always comes
# with a shape and a word. A port keeps one colour slot in every chart: the
# slots follow the port order of status.json, and the palette is colour-blind
# safe. Each SVG has a title, axis labels, a legend and its own dark style.
#
# An age counts to the measurement time, generated_epoch. A badge or a chart
# is an image and runs no script, so it keeps its UTC time or its age.
#
# Standard library only. Run it with python3 -I. Run without -I, it starts
# itself again with -I.
#
# Exit status: 0 rendered, 1 the input could not be read, 2 usage.

import sys
import os

if not sys.flags.isolated:
    os.execv(sys.executable, [sys.executable, "-I"] + sys.argv)

import datetime
import html
import json
import math
import shutil

PROG = "status-render"

FONT = ('system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", '
        'Arial, "Noto Sans", "Liberation Sans", sans-serif')
MONO = 'ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace'

# The categorical slots, light and dark, in their validated order.
SLOTS_LIGHT = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100",
               "#e87ba4", "#008300", "#4a3aa7", "#e34948"]
SLOTS_DARK = ["#3987e5", "#d95926", "#199e70", "#c98500",
              "#d55181", "#008300", "#9085e9", "#e66767"]
# Slot 0: the grey of a series that is no port.
OTHER_LIGHT = "#a3a29c"
OTHER_DARK = "#6b6a65"
# State colours, never used for a series. Each comes with a shape and a word.
STATE = {"good": "#0ca30c", "warning": "#fab219",
         "critical": "#d03b3b", "none": "#898781", "unknown": "#898781"}

# Badge names that are no port. A port with one of these names stops the render.
RESERVED = {"all", "latest", "registries", "build"}

WIDE = 760
NARROW = 420
PAD = 24
DAY = 86400


def warn(msg):
    sys.stderr.write("%s: warning: %s\n" % (PROG, msg))


def die(msg, *more):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    for m in more:
        sys.stderr.write("  %s\n" % m)
    sys.exit(1)


#---------------------------------------------------------------------------#
# Formatting. None is "unknown": a value that was not read is never 0.
#---------------------------------------------------------------------------#
def num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)


def esc(s):
    return html.escape("" if s is None else str(s), quote=True)


def fmt_int(n):
    return "unknown" if not num(n) else "{:,}".format(int(n))


def fmt_pct(r):
    if not num(r):
        return "unknown"
    if r >= 1:
        return "100%"
    if r <= 0:
        return "0%"
    if r < 0.001:
        return "<0.1%"
    v = math.floor(r * 1000) / 10
    return ("%.1f" % v).rstrip("0").rstrip(".") + "%"


def fmt_age(s):
    if not num(s):
        return "unknown"
    s = max(s, 0)
    if s < 3600:
        return "%d min" % round(s / 60)
    if s < 48 * 3600:
        return "%.1f h" % (s / 3600)
    return "%.1f d" % (s / DAY)


def fmt_interval(s):
    """A whole interval: 1 d, 12 h, 90 min."""
    if num(s) and s >= DAY and s % DAY == 0:
        return "%d d" % (s // DAY)
    return fmt_age(s).replace(".0 h", " h").replace(".0 d", " d")


def fmt_size(b):
    """Bytes in binary units, 3 digits at most: 812 B, 2.4 KiB, 61 MiB."""
    if not num(b):
        return "unknown"
    v = float(b)
    unit = "B"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if v < 1023.5 or unit == "TiB":
            break
        v /= 1024
    if unit == "B":
        return "%d B" % round(v)
    return ("%.1f %s" if v < 9.95 else "%.0f %s") % (v, unit)


def fmt_dur(s):
    """A job time: 45 s, 14 min, 1 h 9 min."""
    if not num(s):
        return "unknown"
    s = max(int(round(s)), 0)
    if s < 60:
        return "%d s" % s
    if s < 3600:
        return "%d min" % round(s / 60)
    return "%d h %d min" % (s // 3600, (s % 3600) // 60)


def fmt_ago(s):
    if not num(s):
        return "unknown"
    s = max(s, 0)
    if s < 60:
        return "now"
    if s < 3600:
        return "%d min ago" % (s // 60)
    if s < DAY:
        return "%d h ago" % (s // 3600)
    return "%d d ago" % (s // DAY)


def fmt_hours(h):
    """An axis tick in hours: 0, 15 min, 1 h, 1 d, 7 d."""
    if h == 0:
        return "0"
    if h < 1:
        return "%d min" % round(h * 60)
    if h < 24 or h % 24:
        return ("%.1f" % h).rstrip("0").rstrip(".") + " h"
    return "%d d" % (h // 24)


def utc(epoch):
    return datetime.datetime.fromtimestamp(epoch, tz=datetime.timezone.utc)


def parse_time(s):
    if not isinstance(s, str):
        return None
    try:
        d = datetime.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError:
        return None
    return d.replace(tzinfo=datetime.timezone.utc).timestamp()


def time_html(epoch):
    """A time on the page: UTC text in a <time> element, or "unknown". The
    script of the page gives each <time> the local time as its title."""
    if not num(epoch):
        return "unknown"
    d = utc(epoch)
    return '<time datetime="%s">%s UTC</time>' % (d.strftime("%Y-%m-%dT%H:%M:%SZ"),
                                                  d.strftime("%Y-%m-%d %H:%M"))


def time_iso(iso):
    return time_html(parse_time(iso))


def median(values):
    v = sorted(x for x in values if num(x))
    if not v:
        return None
    n = len(v)
    if n % 2:
        return v[n // 2]
    return (v[n // 2 - 1] + v[n // 2]) / 2


def short_digest(d):
    if not isinstance(d, str) or not d.startswith("sha256:"):
        return "unknown"
    return d[7:19]


# Text width, estimated from the proportions of a UI sans. A layout leaves
# room, so an estimate a little wide is safe and one too narrow is not.
NARROW_CHARS = set("il.,:;'|!()[]{}1 ")
WIDE_CHARS = set("mwMW@%")


def text_w(s, size, bold=False):
    w = 0.0
    for c in str(s):
        if c in NARROW_CHARS:
            w += 0.30
        elif c in WIDE_CHARS:
            w += 0.86
        elif c.isupper():
            w += 0.66
        elif c.isdigit():
            w += 0.58
        else:
            w += 0.54
    return w * size * (1.07 if bold else 1.0)


# Verdana at 11 px, the font a badge is laid out for. Verdana is wide, so a
# system font fits in the same box.
VERDANA = {" ": 3.9, "%": 12.3, ".": 4.0, ",": 4.0, ":": 4.7, "-": 5.0,
           "_": 7.0, "/": 4.9, "·": 4.0, "(": 4.6, ")": 4.6, "<": 9.2,
           "a": 6.7, "b": 6.8, "c": 5.8, "d": 6.8, "e": 6.6, "f": 3.9,
           "g": 6.8, "h": 7.0, "i": 3.0, "j": 3.8, "k": 6.5, "l": 3.0,
           "m": 10.7, "n": 7.0, "o": 6.7, "p": 6.8, "q": 6.8, "r": 4.7,
           "s": 5.8, "t": 4.3, "u": 7.0, "v": 6.5, "w": 9.0, "x": 6.5,
           "y": 6.5, "z": 5.8}


def badge_w(s):
    w = 0.0
    for c in s:
        if c in VERDANA:
            w += VERDANA[c]
        elif c.isdigit():
            w += 7.0
        elif c.isupper():
            w += 7.6
        else:
            w += 7.0
    return w


def nice_step(raw):
    if raw <= 0:
        return 1
    e = math.floor(math.log10(raw))
    f = raw / 10 ** e
    for n in (1, 2, 2.5, 5, 10):
        if f <= n + 1e-9:
            return n * 10 ** e
    return 10 ** (e + 1)


def nice_ticks(vmax, n=5, whole=False):
    """Ticks from 0 past vmax on a step of 1, 2, 2.5 or 5 times a power of
    10. whole: a count, so the step is a whole number and never 2.5."""
    if not num(vmax) or vmax <= 0:
        vmax = 1
    step = nice_step(vmax / n)
    if whole:
        step = max(1, step)
        if step != int(step) or str(int(step)).startswith("25"):
            step = nice_step(step * 1.5)
        step = max(1, int(step))
    top = math.ceil(vmax / step - 1e-9) * step
    ticks = []
    i = 0
    while i * step <= top + step / 1000:
        ticks.append(round(i * step, 10))
        i += 1
    return ticks, top


def hour_ticks(vmax, n=5):
    """Ticks in hours on steps a reader counts in: 1, 2, 3, 6, 12 h, days."""
    steps = [0.25, 0.5, 1, 2, 3, 6, 12, 24, 48, 72, 168, 336, 720]
    step = next((s for s in steps if vmax / s <= n), steps[-1])
    top = math.ceil(vmax / step - 1e-9) * step
    return [i * step for i in range(int(round(top / step)) + 1)], top


#---------------------------------------------------------------------------#
# Identity: a port keeps its slot, whatever else is on the page
#---------------------------------------------------------------------------#
EXTRA_LIGHT = []
EXTRA_DARK = []


def _mix(hex_colour, target, amount):
    out = ""
    for i in (1, 3, 5):
        c = int(hex_colour[i:i + 2], 16)
        t = int(target[i:i + 2], 16)
        out += "%02x" % round(c + (t - c) * amount)
    return "#" + out


def arch_slots(order):
    """{arch: slot}. The ports get the palette slots 1 to 8 in port order. A
    port past the eighth gets a grey step of its own, so two ports never
    share a colour."""
    slots = {}
    for i, a in enumerate(order):
        if i < len(SLOTS_LIGHT):
            slots[a] = i + 1
        else:
            k = i - len(SLOTS_LIGHT)
            slots[a] = -1 - k
            EXTRA_LIGHT.append(_mix(OTHER_LIGHT, "#5a5954", min(0.12 * (k + 1), 0.72)))
            EXTRA_DARK.append(_mix(OTHER_DARK, "#cfcec8", min(0.12 * (k + 1), 0.72)))
    return slots


def slot_class(slot):
    """The fill class of a slot: s1..s8, s0 for the grey, sx0, sx1 for a
    grey step (a CSS class cannot start with a minus sign)."""
    return "sx%d" % (-slot - 1) if slot < 0 else "s%d" % slot


def line_class(slot):
    """The stroke class of a slot, the twin of slot_class: l1..l8, l0, lx0."""
    return "lx%d" % (-slot - 1) if slot < 0 else "l%d" % slot


#---------------------------------------------------------------------------#
# States
#---------------------------------------------------------------------------#
LEVEL_RANK = {"good": 0, "none": 1, "unknown": 1, "warning": 1, "critical": 2}


def freshness(p, interval, tolerance):
    """(level, word) of the image age of one port."""
    if (p.get("ghcr") or {}).get("state") == "absent":
        return "none", "not published"
    age = p.get("age_seconds")
    if not num(age):
        return "unknown", "unknown"
    if age <= 2 * interval:
        return "good", "current"
    if age <= tolerance:
        return "warning", "late"
    return "critical", "stale"


def build_state(b):
    if not isinstance(b, dict):
        return "unknown", "no build found"
    r = b.get("result")
    return {"success": ("good", "passed"), "failure": ("critical", "failed"),
            "timed_out": ("critical", "timed out"), "cancelled": ("warning", "cancelled"),
            "startup_failure": ("critical", "failed to start"),
            "action_required": ("warning", "waits for approval"),
            "in_progress": ("none", "running"), "queued": ("none", "queued"),
            "waiting": ("none", "waiting"), "pending": ("none", "pending")}.get(r, ("unknown", str(r or "unknown")))


def match_state(m):
    if m is True:
        return "good", "same digest"
    if m is False:
        return "critical", "differs"
    return "unknown", "unknown"


def mirror_state(p):
    """(level, word) of the mirror-archlinux targets of one port. The lag and
    the file share come only from the targets that are not current."""
    m = p.get("mirror") or {}
    if m.get("current") is True:
        return "good", "current"
    if m.get("current") is False:
        behind = [t for t in m.get("targets") or [] if isinstance(t, dict) and t.get("current") is False]
        lags = [t["lag_seconds"] for t in behind if num(t.get("lag_seconds"))]
        ratios = [t["ratio_files"] for t in behind if num(t.get("ratio_files"))]
        # A target can be not current with lag 0: its files are incomplete.
        word = "behind %s" % fmt_age(max(lags)) if lags and max(lags) > 0 else "not current"
        if ratios and min(ratios) < 1:
            word += ", %s of files" % fmt_pct(min(ratios))
        return "warning", word
    return "unknown", "unknown"


def evidence_state(p):
    e = p.get("evidence") or {}
    if not num(e.get("packages")):
        return "unknown", "no evidence"
    if e.get("matches") is True:
        return "good", "of the published image"
    if e.get("matches") is False:
        return "warning", "of an older image"
    return "unknown", "image not read"


def scope(k, n, lead=", over"):
    """Empty when every port was measured, else ', over K of N measured'."""
    return "" if k == n else "%s %d of %d measured" % (lead, k, n)


#---------------------------------------------------------------------------#
# SVG
#---------------------------------------------------------------------------#
def chart_style():
    rules = []
    for i, c in enumerate(SLOTS_LIGHT):
        rules.append(".s%d{fill:%s}.l%d{stroke:%s}" % (i + 1, c, i + 1, c))
    rules.append(".s0{fill:%s}.l0{stroke:%s}" % (OTHER_LIGHT, OTHER_LIGHT))
    for i, c in enumerate(EXTRA_LIGHT):
        rules.append(".sx%d{fill:%s}.lx%d{stroke:%s}" % (i, c, i, c))
    for k, c in STATE.items():
        rules.append(".st-%s{fill:%s}" % (k, c))
    dark = []
    for i, c in enumerate(SLOTS_DARK):
        dark.append(".s%d{fill:%s}.l%d{stroke:%s}" % (i + 1, c, i + 1, c))
    dark.append(".s0{fill:%s}.l0{stroke:%s}" % (OTHER_DARK, OTHER_DARK))
    for i, c in enumerate(EXTRA_DARK):
        dark.append(".sx%d{fill:%s}.lx%d{stroke:%s}" % (i, c, i, c))
    return (
        ".bg{fill:#fcfcfb;stroke:rgba(11,11,11,.10)}"
        "text{font-family:%(f)s}"
        ".tt{font-size:16px;font-weight:600;fill:#0b0b0b}"
        ".hd{font-size:30px;font-weight:600;fill:#0b0b0b}"
        ".sub{font-size:13px;fill:#52514e}"
        ".lb{font-size:12px;fill:#0b0b0b}"
        ".gr{font-size:12px;font-weight:600;fill:#52514e;paint-order:stroke;stroke:#fcfcfb;"
        "stroke-width:5px;stroke-linejoin:round}"
        ".vl{font-size:12px;fill:#0b0b0b;font-variant-numeric:tabular-nums}"
        ".mu{fill:#6f6e69}"
        ".lg{font-size:12px;fill:#52514e}"
        ".tk{font-size:11px;fill:#6f6e69;font-variant-numeric:tabular-nums}"
        ".ax{font-size:12px;fill:#52514e}"
        ".note{font-size:13px;fill:#6f6e69}"
        ".grid{stroke:#e9e8e3;stroke-width:1}"
        ".base{stroke:#c3c2b7;stroke-width:1}"
        ".ref{stroke:#7d7b75;stroke-width:1;stroke-dasharray:4 3}"
        ".lead{stroke:#c3c2b7;stroke-width:1;fill:none}"
        ".track{fill:#ebeae5}"
        ".ring{stroke:#fcfcfb;stroke-width:2}"
        ".cut{stroke:#fcfcfb;stroke-width:2}"
        ".line{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}"
        ".hollow{fill:none;stroke:#898781;stroke-width:1.5}"
        ".cell{fill:#f1f0ec}"
        "%(rules)s"
        "@media (prefers-color-scheme:dark){"
        ".bg{fill:#1a1a19;stroke:rgba(255,255,255,.10)}"
        ".tt,.hd,.lb,.vl{fill:#ffffff}"
        ".sub,.gr,.ax,.lg{fill:#c3c2b7}"
        ".tk,.note,.mu{fill:#9a9890}"
        ".grid{stroke:#2a2a28}"
        ".base,.lead{stroke:#3d3d3a}"
        ".ref{stroke:#9a9890}"
        ".track{fill:#2e2e2c}"
        ".cell{fill:#232322}"
        ".ring,.cut,.gr{stroke:#1a1a19}"
        "%(dark)s}"
    ) % {"f": FONT, "rules": "".join(rules), "dark": "".join(dark)}


class Svg:
    def __init__(self, title, desc, w):
        self.title = title
        self.desc = desc
        self.w = w
        self.parts = []

    def add(self, s):
        self.parts.append(s)

    def text(self, x, y, s, cls, anchor=None):
        a = ' text-anchor="%s"' % anchor if anchor else ""
        self.add('<text x="%.1f" y="%.1f" class="%s"%s>%s</text>' % (x, y, cls, a, esc(s)))

    def render(self, height):
        w = self.w
        return (
            '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
            'viewBox="0 0 %d %d" role="img" aria-labelledby="title desc">\n'
            '<title id="title">%s</title>\n<desc id="desc">%s</desc>\n'
            '<style>%s</style>\n'
            '<rect class="bg" x="0.5" y="0.5" width="%d" height="%d" rx="12"/>\n'
            '%s\n</svg>\n'
        ) % (w, height, w, height, esc(self.title), esc(self.desc),
             chart_style(), w - 1, height - 1, "\n".join(self.parts))


def wrap(s, size, width):
    lines = []
    cur = ""
    for word in s.split():
        nxt = (cur + " " + word).strip()
        if cur and text_w(nxt, size) > width:
            lines.append(cur)
            cur = word
        else:
            cur = nxt
    if cur:
        lines.append(cur)
    return lines


def header(svg, title, headline, caption):
    """The title, the headline number and its caption. Returns the next y."""
    svg.text(PAD, 40, title, "tt")
    svg.text(PAD, 82, headline, "hd")
    y = 82
    x = PAD + text_w(headline, 30, True) + 14
    room = svg.w - PAD - x
    lines = wrap(caption, 13, room) if room > 200 else []
    if 0 < len(lines) <= 2:
        if len(lines) == 1:
            svg.text(x, y - 3, lines[0], "sub")
        else:
            svg.text(x, y - 18, lines[0], "sub")
            svg.text(x, y - 1, lines[1], "sub")
        return y + 30
    for ln in wrap(caption, 13, svg.w - 2 * PAD):
        y += 19
        svg.text(PAD, y, ln, "sub")
    return y + 30


def glyph(svg, level, cx, cy, r=5.0):
    if level == "good":
        svg.add('<circle cx="%.1f" cy="%.1f" r="%.1f" class="st-good"/>' % (cx, cy, r))
    elif level == "warning":
        t = r * 1.12
        svg.add('<path d="M%.1f %.1fl%.1f %.1fh%.1fz" class="st-warning"/>'
                % (cx, cy - t, t, 1.714 * t, -2 * t))
    elif level == "critical":
        svg.add('<path d="M%.1f %.1fl%.1f %.1f %.1f %.1f %.1f %.1fz" class="st-critical"/>'
                % (cx, cy - r, r, r, -r, r, -r, -r))
    else:
        svg.add('<circle cx="%.1f" cy="%.1f" r="%.1f" class="hollow"/>' % (cx, cy, r * 0.85))


def legend(svg, y, items):
    """items: (kind, class, label), kind box, line or glyph. Returns the next y."""
    x = PAD
    for kind, cls, label in items:
        w = 16 + text_w(label, 12) + 18
        if x + w - 18 > svg.w - PAD and x > PAD:
            x = PAD
            y += 20
        if kind == "box":
            svg.add('<rect x="%.1f" y="%.1f" width="10" height="10" rx="2" class="%s"/>'
                    % (x, y - 9, cls))
        elif kind == "line":
            extra = ' stroke-dasharray="4 3"' if cls == "ref" else ""
            svg.add('<path d="M%.1f %.1fh12" class="line %s"%s/>' % (x - 1, y - 4, cls, extra))
        else:
            glyph(svg, cls, x + 5, y - 4)
        svg.text(x + 16, y, label, "lg")
        x += w
    return y + 16


def hbar(x0, y, w, h, r=4, round_end=True):
    """A bar from x0 rightwards: square at the baseline, rounded data end."""
    if w <= 0:
        return ""
    if not round_end or w < 1:
        return "M%.1f %.1fh%.1fv%.1fh%.1fz" % (x0, y, w, h, -w)
    r = min(r, w, h / 2)
    return ("M%.1f %.1fh%.1fa%.1f %.1f 0 0 1 %.1f %.1fv%.1fa%.1f %.1f 0 0 1 %.1f %.1fh%.1fz"
            % (x0, y, w - r, r, r, r, r, h - 2 * r, r, r, -r, r, -(w - r)))


class Row:
    def __init__(self, kind, label, segments=None, value="", more="", short=None,
                 tip="", level=None):
        self.kind = kind            # group or bar
        self.label = label
        self.segments = segments or []   # (value, class); the outer end is rounded
        self.value = value          # ink, beside the bar
        self.more = more            # muted, after value; left out when narrow
        self.short = short          # replaces value when narrow
        self.tip = tip
        self.level = level


def bar_chart(svg, y, rows, vmax, ticks, tick_fmt, axis_label, ref=None, at_tip=False):
    """Horizontal bars, one per row, grouped by group rows. A bar longer than
    vmax is cut at the end of the scale and marked. The value stands in a
    column at the right, or at the tip of its bar. Returns the height."""
    narrow = svg.w < 600
    row_h = 24
    group_h = 28
    bar_h = 12

    def shown(r):
        if narrow:
            return (r.short if r.short is not None else r.value), ""
        return r.value, r.more

    label_w = max([text_w(r.label, 12) for r in rows if r.kind == "bar"] + [48]) + 22
    glyph_w = 16 if any(r.level for r in rows) else 0
    widths = []
    for r in rows:
        if r.kind != "bar":
            continue
        v, m = shown(r)
        widths.append(text_w(v, 12) + (8 + text_w(m, 12) if m else 0))
    value_w = max(widths + [30]) + 12 + glyph_w
    x0 = PAD + label_w
    x1 = svg.w - PAD - value_w
    if x1 - x0 < 120:
        x1 = x0 + 120
    plot_w = x1 - x0
    top = y + (18 if ref else 0)

    def sx(v):
        return x0 + (0 if vmax <= 0 else plot_w * min(max(v, 0), vmax) / vmax)

    yy = top
    marks = []
    for r in rows:
        if r.kind == "group":
            yy += group_h
            marks.append('<text x="%.1f" y="%.1f" class="gr">%s</text>' % (PAD, yy - 9, esc(r.label)))
            continue
        cy = yy + row_h / 2
        marks.append('<text x="%.1f" y="%.1f" class="lb">%s</text>' % (PAD + 8, cy + 4, esc(r.label)))
        segs = []
        pos = 0.0
        total = sum(v for v, _ in r.segments if v)
        for i, (v, cls) in enumerate(r.segments):
            if not v or v <= 0 or pos >= vmax:
                continue
            a = sx(pos)
            b = sx(pos + v)
            if pos > 0:
                a += 2          # the surface gap between two segments
            last = all(not s[0] or s[0] <= 0 for s in r.segments[i + 1:]) or pos + v >= vmax
            d = hbar(a, cy - bar_h / 2, b - a, bar_h, round_end=last)
            if d:
                segs.append('<path d="%s" class="%s"/>' % (d, cls))
            pos += v
        if total > vmax:
            # Cut at the end of the scale: two gaps across the bar.
            for dx in (16, 10):
                segs.append('<path d="M%.1f %.1fl4 -%d" class="cut"/>'
                            % (x1 - dx, cy + bar_h / 2 + 1, bar_h + 2))
        tip = "<title>%s</title>" % esc(r.tip) if r.tip else ""
        marks.append('<g>%s%s<rect x="%.1f" y="%.1f" width="%.1f" height="%d" '
                     'fill="#000" fill-opacity="0"/></g>'
                     % (tip, "".join(segs), x0, yy, svg.w - PAD - x0, row_h))
        vx = x1 + 12
        if at_tip:
            vx = (sx(min(total, vmax)) if total > 0 else x0) + 8
        if r.level:
            gl = Svg("", "", svg.w)
            glyph(gl, r.level, vx + 5, cy)
            marks.append("".join(gl.parts))
            vx += glyph_w
        v, m = shown(r)
        more = '<tspan class="mu" dx="8">%s</tspan>' % esc(m) if m else ""
        marks.append('<text x="%.1f" y="%.1f" class="vl">%s%s</text>' % (vx, cy + 4, esc(v), more))
        yy += row_h
    bottom = yy + 8
    for t in ticks:
        x = sx(t)
        svg.add('<path d="M%.1f %.1fV%.1f" class="%s"/>' % (x, top + 6, bottom, "base" if t == 0 else "grid"))
        svg.text(x, bottom + 16, tick_fmt(t), "tk", "middle")
    if ref and ref[0] <= vmax:
        x = sx(ref[0])
        svg.add('<path d="M%.1f %.1fV%.1f" class="ref"/>' % (x, top - 2, bottom))
        svg.text(x + 4, top + 2, ref[1], "tk")
    svg.add("\n".join(marks))
    svg.text(x0 + plot_w / 2, bottom + 38, axis_label, "ax", "middle")
    return bottom + 38 + 22


def time_ticks(x0, x1, plot_w):
    span = x1 - x0
    most = max(2, int(plot_w // 72))
    steps = [3600 * h for h in (3, 6, 12, 24, 48, 120, 240)]
    step = next((s for s in steps if span / s <= most), steps[-1])
    fmt = "%H:%M" if step < DAY else "%b %d"
    t = math.ceil(x0 / step) * step
    ticks = []
    while t <= x1:
        d = utc(t)
        label = d.strftime(fmt)
        if fmt == "%H:%M" and d.hour == 0:
            label = d.strftime("%b %d")
        ticks.append((t, label.replace(" 0", " ")))
        t += step
    return ticks


def line_chart(svg, y, series, slots, y_ticks, ty, y_fmt, y_label, x0, x1, ref=None):
    """One line per series. ty maps a value to 0..1 up the plot."""
    items = [("line", line_class(slots.get(a, 0)), a) for a, _ in series]
    if ref:
        items.append(("line", "ref", ref[1]))
    y = legend(svg, y, items)
    end_w = max([text_w("%s %s" % (a, y_fmt(v, True)), 12)
                 for a, pts in series for _, v in pts[-1:]] + [40])
    plot_l = PAD + 46
    plot_r = svg.w - PAD - end_w - 20
    top = y + 10
    bottom = top + (200 if svg.w >= 600 else 170)

    def sx(t):
        return plot_l + (plot_r - plot_l) * (t - x0) / max(x1 - x0, 1)

    def sy(v):
        return bottom - (bottom - top) * min(max(ty(v), 0.0), 1.0)

    for v in y_ticks:
        svg.add('<path d="M%.1f %.1fH%.1f" class="%s"/>' % (plot_l, sy(v), plot_r,
                                                          "base" if v == y_ticks[0] else "grid"))
        svg.text(plot_l - 8, sy(v) + 4, y_fmt(v), "tk", "end")
    for t, label in time_ticks(x0, x1, plot_r - plot_l):
        svg.add('<path d="M%.1f %.1fv4" class="base"/>' % (sx(t), bottom))
        svg.text(sx(t), bottom + 18, label, "tk", "middle")
    if ref:
        svg.add('<path d="M%.1f %.1fH%.1f" class="ref"/>' % (plot_l, sy(ref[0]), plot_r))

    ends = []
    for arch, pts in series:
        cls = slots.get(arch, 0)
        if not pts:
            continue
        steps = [b[0] - a[0] for a, b in zip(pts, pts[1:])]
        gap = max(4 * (median(steps) or 3600), 2 * 3600)
        d = []
        prev = None
        for t, v in pts:
            d.append("%s%.1f %.1f" % ("M" if prev is None or t - prev > gap else "L", sx(t), sy(v)))
            prev = t
        svg.add('<path d="%s" class="line %s"><title>%s</title></path>' % ("".join(d), line_class(cls), esc(arch)))
        lt, lv = pts[-1]
        ends.append([sy(lv), arch, lv, sx(lt), sy(lv)])
    # End labels 15 px apart at least, each with a leader line when it moved.
    ends.sort()
    for i in range(1, len(ends)):
        if ends[i][0] < ends[i - 1][0] + 15:
            ends[i][0] = ends[i - 1][0] + 15
    if ends and ends[-1][0] > bottom + 4:
        shift = ends[-1][0] - bottom - 4
        for e in ends:
            e[0] -= shift
    lx = plot_r + 16
    for ly, arch, v, ex, ey in ends:
        if abs(ly - ey) > 2:
            svg.add('<path d="M%.1f %.1fL%.1f %.1f" class="lead"/>' % (ex + 6, ey, lx - 4, ly))
    for ly, arch, v, ex, ey in ends:
        svg.add('<circle cx="%.1f" cy="%.1f" r="4" class="%s ring"><title>%s %s</title></circle>'
                % (ex, ey, slot_class(slots.get(arch, 0)), esc(arch), esc(y_fmt(v, True))))
        svg.add('<text x="%.1f" y="%.1f" class="vl">%s<tspan class="mu" dx="5">%s</tspan></text>'
                % (lx, ly + 4, esc(arch), esc(y_fmt(v, True))))
    if not ends:
        svg.text((plot_l + plot_r) / 2, (top + bottom) / 2, "No history yet", "note", "middle")
    svg.text((plot_l + plot_r) / 2, bottom + 42, "Time, UTC", "ax", "middle")
    svg.add('<text class="ax" text-anchor="middle" transform="translate(%.1f %.1f) rotate(-90)">%s</text>'
            % (PAD + 6, (top + bottom) / 2, esc(y_label)))
    return bottom + 42 + 22


def bucket(points, step, how):
    """One point per STEP seconds: the last value, or the largest. A point
    with no value is left out."""
    if step <= 0:
        return [(t, v) for t, v in points if v is not None]
    keep = {}
    for t, v in points:
        if v is None:
            continue
        k = int(t // step)
        if k not in keep:
            keep[k] = (t, v)
        elif how == "max":
            keep[k] = (max(keep[k][0], t), max(keep[k][1], v))
        else:
            keep[k] = max(keep[k], (t, v))
    return [keep[k] for k in sorted(keep)]


#---------------------------------------------------------------------------#
# Charts from status.json
#---------------------------------------------------------------------------#
MIB = 1048576


def chart_freshness(ctx, w):
    ports, interval, tolerance = ctx["ports"], ctx["interval"], ctx["tolerance"]
    svg = Svg("Image age",
              "Time since each image was built, from the created label of the image on GHCR, "
              "against the build interval. A bar past the stale limit is cut at the end of the scale.", w)
    ages = [p["age_seconds"] for p in ports if num(p.get("age_seconds"))]
    cur = len([p for p in ports if freshness(p, interval, tolerance)[0] == "good"])
    cap = ("oldest image. The build runs every %s. %d of %d images are current%s."
           % (fmt_interval(interval), cur, len(ports), scope(len(ages), len(ports))))
    y = header(svg, "Image age", fmt_age(max(ages)) if ages else "unknown", cap)
    y = legend(svg, y, [
        ("glyph", "good", "current, %s or less" % fmt_interval(2 * interval)),
        ("glyph", "warning", "late"),
        ("glyph", "critical", "stale, over %s" % fmt_interval(tolerance)),
        ("glyph", "unknown", "not read"),
    ])
    hours = [a / 3600 for a in ages]
    ih = interval / 3600
    vmax = max([min(max(hours + [0]), tolerance / 3600), 2 * ih * 1.2])
    ticks, top = hour_ticks(vmax, 5 if w >= 600 else 3)
    rows = []
    for p in ports:
        lvl, word = freshness(p, interval, tolerance)
        age = p.get("age_seconds")
        if lvl in ("none", "unknown") or not num(age):
            rows.append(Row("bar", p["arch"], [], word, short=word,
                            tip="%s: %s" % (p["arch"], word), level=lvl))
            continue
        rows.append(Row("bar", p["arch"], [(age / 3600, "st-%s" % lvl)], fmt_age(age), word,
                        short="%s %s" % (fmt_age(age), word), level=lvl,
                        tip="%s: built %s, %s before the measurement, %s"
                            % (p["arch"], (p.get("ghcr") or {}).get("created"), fmt_age(age), word)))
    h = bar_chart(svg, y, rows, top, ticks, fmt_hours, "Time since the image was built",
                  ref=(ih, "built every %s" % fmt_interval(interval)))
    return svg.render(h), h


def chart_size(ctx, w):
    ports, slots = ctx["ports"], ctx["slots"]
    svg = Svg("Image size",
              "Compressed size of each image on GHCR, the sum of its layers, and the installed "
              "size of its packages from the evidence of the build.", w)
    comp = [p["ghcr"]["size"] for p in ports if num((p.get("ghcr") or {}).get("size"))]
    head = fmt_size(sum(comp)) if comp else "unknown"
    cap = ("compressed, all images together%s. The grey part of a bar runs to the installed "
           "size of the packages." % scope(len(comp), len(ports)))
    y = header(svg, "Image size", head, cap)
    y = legend(svg, y, [("box", slot_class(slots[p["arch"]]), p["arch"]) for p in ports]
               + [("box", "track", "installed")])
    tops = []
    for p in ports:
        c = (p.get("ghcr") or {}).get("size")
        i = (p.get("evidence") or {}).get("installed_bytes")
        tops.append(max([x for x in (c, i) if num(x)] + [0]) / MIB)
    ticks, top = nice_ticks(max(tops + [1]), 5 if w >= 600 else 3)
    rows = []
    for p in ports:
        c = (p.get("ghcr") or {}).get("size")
        i = (p.get("evidence") or {}).get("installed_bytes")
        cls = slot_class(slots[p["arch"]])
        if num(c):
            segs = [(c / MIB, cls)]
            if num(i) and i > c:
                segs.append(((i - c) / MIB, "track"))
            more = "%s installed" % fmt_size(i) if num(i) else "installed unknown"
            rows.append(Row("bar", p["arch"], segs, fmt_size(c), more, short=fmt_size(c),
                            tip="%s: %s compressed, %s installed" % (p["arch"], fmt_size(c), fmt_size(i))))
        elif num(i):
            rows.append(Row("bar", p["arch"], [(i / MIB, "track")], "unknown", "%s installed" % fmt_size(i),
                            short="unknown", tip="%s: compressed size unknown, %s installed" % (p["arch"], fmt_size(i))))
        else:
            rows.append(Row("bar", p["arch"], [], "unknown", short="unknown",
                            tip="%s: size unknown" % p["arch"]))
    h = bar_chart(svg, y, rows, top, ticks, lambda v: "%g" % v, "MiB; compressed, then installed",
                  at_tip=True)
    return svg.render(h), h


def chart_packages(ctx, w):
    ports, slots = ctx["ports"], ctx["slots"]
    svg = Svg("Packages per image",
              "Packages installed in each image, from the evidence of its build: the package "
              "list the image's own pacman database names.", w)
    counts = [p["evidence"]["packages"] for p in ports if num((p.get("evidence") or {}).get("packages"))]
    med = median(counts)
    if counts:
        cap = ("packages, the median%s. The anchor is the pacman version that names the "
               "pinned tags." % scope(len(counts), len(ports), " over"))
    else:
        cap = "No image has evidence in this run. The package list comes from the evidence of each build."
    y = header(svg, "Packages per image", fmt_int(med) if med is not None else "unknown", cap)
    y = legend(svg, y, [("box", slot_class(slots[p["arch"]]), p["arch"]) for p in ports])
    ticks, top = nice_ticks(max(counts + [1]), 5 if w >= 600 else 3, whole=True)
    rows = []
    for p in ports:
        e = p.get("evidence") or {}
        n = e.get("packages")
        lvl, word = evidence_state(p)
        if not num(n):
            rows.append(Row("bar", p["arch"], [], "unknown", "no evidence", short="unknown",
                            tip="%s: no evidence" % p["arch"]))
            continue
        more = "pacman %s" % e.get("anchor") if e.get("anchor") else "anchor unknown"
        if e.get("matches") is False:
            more += ", of an older image"
        rows.append(Row("bar", p["arch"], [(n, slot_class(slots[p["arch"]]))], fmt_int(n), more,
                        short=fmt_int(n), tip="%s: %s packages, %s download, evidence %s"
                        % (p["arch"], fmt_int(n), fmt_size(e.get("bytes")), word)))
    h = bar_chart(svg, y, rows, top, ticks, lambda v: "%g" % v, "Packages in the image", at_tip=True)
    return svg.render(h), h


def chart_coverage(ctx, w):
    ports, slots, st = ctx["ports"], ctx["slots"], ctx["status"]
    reg = st.get("registries") or {}
    svg = Svg("Tags on both registries",
              "Tags per port on GHCR, and how many of them Docker Hub carries: a rolling tag with "
              "the same digest, a pinned tag at all.", w)
    parity = reg.get("parity")
    roll = reg.get("rolling") or {}
    pin = reg.get("pinned") or {}
    if num(parity):
        cap = ("of GHCR tags are on Docker Hub. %d rolling tag(s) differ, %s pinned tag(s) are missing."
               % (len(roll.get("differs") or []), fmt_int(pin.get("missing"))))
    else:
        cap = "Docker Hub against GHCR is unknown: a tag list or a rolling digest did not read."
    y = header(svg, "Tags on both registries", fmt_pct(parity), cap)
    y = legend(svg, y, [("box", slot_class(slots[p["arch"]]), p["arch"]) for p in ports]
               + [("box", "s0", "index"), ("box", "track", "on GHCR only")])
    rows = []
    vals = []

    def row(label, par, fams, cls):
        # same is null when a rolling digest did not read: unknown, not 0.
        if not isinstance(par, dict) or not num(par.get("tags")) or not num(par.get("same")):
            n = (fams or {}).get("total")
            rows.append(Row("bar", label, [], "unknown", "%s on GHCR" % fmt_int(n) if num(n) else "",
                            short="unknown", tip="%s: unknown" % label))
            return
        t, s = par["tags"], par["same"]
        vals.append(t)
        more = ""
        if isinstance(fams, dict) and num(fams.get("total")):
            more = "%d rolling, %d dated, %d anchor" % (fams.get("rolling") or 0, fams.get("dated") or 0,
                                                         fams.get("anchor") or 0)
        rows.append(Row("bar", label, [(s, cls), (t - s, "track")], "%d of %d" % (s, t), more,
                        short="%d/%d" % (s, t), tip="%s: %d of %d GHCR tags on Docker Hub" % (label, s, t)))

    for p in ports:
        row(p["arch"], p.get("parity"), (p.get("ghcr") or {}).get("tags"), slot_class(slots[p["arch"]]))
    row("index", reg.get("index"), None, "s0")
    ticks, top = nice_ticks(max(vals + [1]), 5 if w >= 600 else 3, whole=True)
    h = bar_chart(svg, y, rows, top, ticks, lambda v: "%g" % v, "Tags on GHCR; the coloured part is on Docker Hub",
                  at_tip=True)
    return svg.render(h), h


def chart_build(ctx, w):
    ports, slots = ctx["ports"], ctx["slots"]
    svg = Svg("Last build",
              "Job time of the newest Build job of each port in build-deploy.yml, with its result.", w)
    known = [p for p in ports if isinstance(p.get("build"), dict) and p["build"].get("result")]
    passed = [p for p in known if p["build"]["result"] == "success"]
    cap = "passed, in the newest run of each port%s." % scope(len(known), len(ports))
    y = header(svg, "Last build", "%d of %d" % (len(passed), len(known)) if known else "unknown", cap)
    y = legend(svg, y, [("box", slot_class(slots[p["arch"]]), p["arch"]) for p in ports] + [
        ("glyph", "good", "passed"), ("glyph", "critical", "failed"), ("glyph", "warning", "cancelled")])
    mins = [p["build"]["duration_seconds"] / 60 for p in known if num(p["build"].get("duration_seconds"))]
    ticks, top = nice_ticks(max(mins + [1]), 5 if w >= 600 else 3)
    rows = []
    for p in ports:
        b = p.get("build")
        lvl, word = build_state(b)
        d = (b or {}).get("duration_seconds")
        if not num(d):
            rows.append(Row("bar", p["arch"], [], word, short=word, level=lvl,
                            tip="%s: %s" % (p["arch"], word)))
            continue
        when = (b or {}).get("started") or "unknown"
        rows.append(Row("bar", p["arch"], [(d / 60, slot_class(slots[p["arch"]]))], fmt_dur(d), word,
                        short="%s %s" % (fmt_dur(d), word), level=lvl,
                        tip="%s: %s, %s, started %s" % (p["arch"], word, fmt_dur(d), when)))
    h = bar_chart(svg, y, rows, top, ticks, lambda v: "%g" % v, "Minutes, the job Build <arch>", at_tip=True)
    return svg.render(h), h


#---------------------------------------------------------------------------#
# History
#---------------------------------------------------------------------------#
def history_series(history, now, days=30):
    """{arch: [(t, age or None, compressed bytes or None)]}, last DAYS."""
    start = now - days * DAY
    out = {}
    for line in history:
        t = parse_time(line.get("t"))
        if t is None or t < start or t > now + 3600:
            continue
        for arch, x in (line.get("x") or {}).items():
            if not isinstance(x, dict):
                continue
            a = x.get("a") if num(x.get("a")) else None
            s = x.get("s") if num(x.get("s")) else None
            out.setdefault(arch, []).append((t, a, s))
    for arch in out:
        out[arch].sort(key=lambda p: p[0])
    return out


def history_window(ctx):
    now = ctx["now"]
    times = [p[0] for pts in ctx["series"].values() for p in pts]
    x1 = now
    x0 = max(min(times), now - 30 * DAY) if times else now - DAY
    if x1 - x0 < DAY:
        x0 = x1 - DAY
    if (x1 - x0) / DAY >= 29.5:
        span = "last 30 days"
    elif times:
        span = "since %s" % utc(min(times)).strftime("%b %d, %H:%M UTC").replace(" 0", " ")
    else:
        span = "no history yet"
    # More than 2 days: one point per 6 hours, so a line reads as a trend.
    step = 6 * 3600 if x1 - x0 > 2 * DAY else 0
    return x0, x1, span, step


AGE_TICKS = [0.25, 0.5, 1, 3, 6, 12, 24, 72, 168, 720, 2160]


def chart_history_age(ctx, w):
    x0, x1, span, step = history_window(ctx)
    ih = ctx["interval"] / 3600
    svg = Svg("Image age, last 30 days",
              "Age of each image over time, on a log scale, against the build interval. With more "
              "than 2 days of history, one point per day: the largest age of that day.", w)
    ages = [p["age_seconds"] for p in ctx["ports"] if num(p.get("age_seconds"))]
    y = header(svg, "Image age, last 30 days", fmt_age(max(ages)) if ages else "unknown",
               "oldest image now. One line per port, %s, log scale." % span)
    series = []
    for a in ctx["hist_order"]:
        pts = [(t, None if g is None else g / 3600) for t, g, _ in ctx["series"][a]]
        # The age climbs between two builds and drops at each build. The
        # largest age of each day shows the trend: flat when the port builds
        # each day, rising when it does not.
        series.append((a, bucket(pts, DAY if step else 0, "max")))
    series = [(a, p) for a, p in series if p]
    vals = [v for _, pts in series for _, v in pts]
    hi_v = max(vals + [2 * ih])
    lo = 0.5 if min(vals + [ih]) >= 0.5 else 0.25
    hi = next((t for t in AGE_TICKS if t >= hi_v), AGE_TICKS[-1])
    ticks = [t for t in AGE_TICKS if lo <= t <= hi]
    if w < 600 and len(ticks) > 4:
        ticks = [t for i, t in enumerate(ticks) if i % 2 == 0 or t == hi]

    def ty(v):
        if hi <= lo:
            return 0.0
        return (math.log(max(v, lo)) - math.log(lo)) / (math.log(hi) - math.log(lo))

    def hours(v, end=False):
        return fmt_age(v * 3600) if end else fmt_hours(v)

    h = line_chart(svg, y, series, ctx["slots"], ticks, ty, hours, "Age, log scale", x0, x1,
                   ref=(ih, "built every %s" % fmt_interval(ctx["interval"])))
    return svg.render(h), h


def chart_history_size(ctx, w):
    x0, x1, span, step = history_window(ctx)
    svg = Svg("Image size, last 30 days",
              "Compressed size of each image over time. A run that could not read the size keeps the "
              "last measured size. With more than 2 days of history, one point per 6 hours.", w)
    comp = [p["ghcr"]["size"] for p in ctx["ports"] if num((p.get("ghcr") or {}).get("size"))]
    y = header(svg, "Image size, last 30 days", fmt_size(max(comp)) if comp else "unknown",
               "largest image now, compressed. One line per port, %s." % span)
    series = []
    for a in ctx["hist_order"]:
        pts = [(t, None if s is None else s / MIB) for t, _, s in ctx["series"][a]]
        series.append((a, bucket(pts, step, "last")))
    series = [(a, p) for a, p in series if p]
    vals = [v for _, pts in series for _, v in pts]
    ticks, top = nice_ticks(max(vals + [1]), 4 if w >= 600 else 3)

    def mib(v, end=False):
        return fmt_size(v * MIB) if end else "%g" % v

    h = line_chart(svg, y, series, ctx["slots"], ticks, lambda v: v / top, mib, "MiB, compressed", x0, x1)
    return svg.render(h), h


def build_days(ctx):
    """{arch: {date: result}}: the last build of each port on each UTC day,
    from status.json and the history lines, each job once."""
    jobs = {}
    for line in ctx["history"]:
        for arch, x in (line.get("x") or {}).items():
            b = x.get("b") if isinstance(x, dict) else None
            if isinstance(b, list) and len(b) >= 3 and num(b[2]) and b[0] is not None:
                jobs[(arch, b[0])] = (b[2], b[1])
    for p in ctx["ports"]:
        for b in p.get("builds") or []:
            t = parse_time(b.get("started"))
            if t is not None and b.get("job_id") is not None:
                jobs[(p["arch"], b["job_id"])] = (t, b.get("result"))
    out = {}
    for (arch, _), (t, r) in sorted(jobs.items(), key=lambda kv: kv[1][0]):
        lvl, _ = build_state({"result": r})
        if lvl == "none":
            continue
        out.setdefault(arch, {})[utc(t).date()] = lvl
    return out


def chart_history_build(ctx, w):
    days = 30 if w >= 600 else 14
    svg = Svg("Builds, last %d days" % days,
              "The result of the last Build job of each port on each UTC day. A day with no mark "
              "had no build of that port.", w)
    end = utc(ctx["now"]).date()
    dates = [end - datetime.timedelta(days=days - 1 - i) for i in range(days)]
    grid = build_days(ctx)
    marks = [grid.get(p["arch"], {}).get(d) for p in ctx["ports"] for d in dates]
    done = [m for m in marks if m]
    good = [m for m in done if m == "good"]
    y = header(svg, "Builds, last %d days" % days,
               "%d of %d" % (len(good), len(done)) if done else "none",
               "build days passed. One mark per port and day: the last build of that day.")
    y = legend(svg, y, [("glyph", "good", "passed"), ("glyph", "critical", "failed"),
                        ("glyph", "warning", "cancelled"), ("glyph", "none", "no build")])
    label_w = max([text_w(p["arch"], 12) for p in ctx["ports"]] + [40]) + 16
    x0 = PAD + label_w
    cw = (svg.w - PAD - x0) / days
    rh = 22
    r = max(min(cw / 2 - 1.5, 5.5), 2.5)
    top = y + 8
    for i, p in enumerate(ctx["ports"]):
        cy = top + i * rh + rh / 2
        svg.text(PAD, cy + 4, p["arch"], "lb")
        row = grid.get(p["arch"], {})
        for j, d in enumerate(dates):
            cx = x0 + j * cw + cw / 2
            lvl = row.get(d)
            svg.add('<rect x="%.1f" y="%.1f" width="%.1f" height="%d" rx="3" class="cell"><title>%s %s: %s</title></rect>'
                    % (cx - cw / 2 + 1, cy - rh / 2 + 2, cw - 2, rh - 4, esc(p["arch"]), d.isoformat(),
                       {"good": "passed", "critical": "failed", "warning": "cancelled"}.get(lvl, "no build")))
            if lvl:
                glyph(svg, lvl, cx, cy, r)
            else:
                svg.add('<circle cx="%.1f" cy="%.1f" r="1.5" class="st-none"/>' % (cx, cy))
    bottom = top + len(ctx["ports"]) * rh + 4
    step = 7 if days > 14 else (3 if svg.w < 600 else 2)
    for j in range(days - 1, -1, -step):
        cx = x0 + j * cw + cw / 2
        svg.add('<path d="M%.1f %.1fv4" class="base"/>' % (cx, bottom))
        svg.text(cx, bottom + 18, dates[j].strftime("%b %d").replace(" 0", " "), "tk", "middle")
    svg.text(x0 + (svg.w - PAD - x0) / 2, bottom + 42, "Day, UTC", "ax", "middle")
    return svg.render(bottom + 64), bottom + 64


#---------------------------------------------------------------------------#
# Badges
#---------------------------------------------------------------------------#
BADGE_LIGHT = {"good": "#1a7f37", "warning": "#9a6700", "critical": "#cf222e",
               "none": "#6e7781", "unknown": "#6e7781", "info": "#0969da"}
BADGE_DARK = {"good": "#238636", "warning": "#9e6a03", "critical": "#da3633",
              "none": "#6e7681", "unknown": "#6e7681", "info": "#1f6feb"}


def badge(label, message, level):
    lw = round(badge_w(label) + 12)
    mw = round(badge_w(message) + 12)
    w = lw + mw
    title = "%s: %s" % (label, message)
    style = (".lab{fill:#555}.msg{fill:%s}text{font-family:%s;font-size:11px;fill:#fff}"
             "@media (prefers-color-scheme:dark){.lab{fill:#3d444d}.msg{fill:%s}}"
             % (BADGE_LIGHT[level], FONT, BADGE_DARK[level]))
    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="20" viewBox="0 0 %d 20" '
        'role="img" aria-label="%s">\n<title>%s</title>\n<style>%s</style>\n'
        '<clipPath id="r"><rect width="%d" height="20" rx="3"/></clipPath>\n'
        '<g clip-path="url(#r)"><rect class="lab" width="%d" height="20"/>'
        '<rect class="msg" x="%d" width="%d" height="20"/></g>\n'
        '<text x="%.1f" y="14" text-anchor="middle">%s</text>\n'
        '<text x="%.1f" y="14" text-anchor="middle">%s</text>\n</svg>\n'
    ) % (w, w, esc(title), esc(title), style, w, lw, lw, mw,
         lw / 2, esc(label), lw + mw / 2, esc(message))


def arch_badge(p, interval, tolerance):
    lvl, word = freshness(p, interval, tolerance)
    if lvl in ("none", "unknown"):
        return badge(p["arch"], word, lvl)
    return badge(p["arch"], "%s · %s" % (fmt_age(p.get("age_seconds")), word), lvl)


def worst(levels):
    return max(levels, key=lambda lv: LEVEL_RANK[lv]) if levels else "unknown"


def all_badge(ports, interval, tolerance):
    states = [freshness(p, interval, tolerance)[0] for p in ports]
    read = [s for s in states if s not in ("unknown",)]
    cur = len([s for s in states if s == "good"])
    if not read:
        return badge("images", "unknown", "unknown")
    msg = "%d of %d current" % (cur, len(ports))
    if len(read) < len(ports):
        msg += " · %d of %d measured" % (len(read), len(ports))
    lvl = worst(states)
    if lvl in ("none", "unknown"):
        lvl = "warning"
    return badge("images", msg, lvl)


def latest_badge(st, ports):
    lt = st.get("latest") or {}
    if lt.get("state") == "absent":
        return badge("latest", "not published", "none")
    if lt.get("state") != "published":
        return badge("latest", "unknown", "unknown")
    have = len([p for p in ports if p.get("in_latest") is True])
    msg = "%d of %d platforms" % (have, len(ports))
    return badge("latest", msg, "good" if have == len(ports) else "warning")


def registries_badge(st):
    reg = st.get("registries") or {}
    par = reg.get("parity")
    if not num(par):
        return badge("Docker Hub", "unknown", "unknown")
    gaps = len((reg.get("rolling") or {}).get("differs") or []) + ((reg.get("pinned") or {}).get("missing") or 0)
    if par >= 1:
        return badge("Docker Hub", "100% of GHCR tags", "good")
    lvl = "critical" if (reg.get("drift_runs") or 0) >= 2 else "warning"
    return badge("Docker Hub", "%s of GHCR tags · %d missing or differ" % (fmt_pct(par), gaps), lvl)


def build_badge(ports):
    known = [p for p in ports if isinstance(p.get("build"), dict) and p["build"].get("result")]
    if not known:
        return badge("build", "unknown", "unknown")
    lv = [build_state(p["build"])[0] for p in known]
    passed = len([x for x in lv if x == "good"])
    msg = "%d of %d passed" % (passed, len(ports)) if len(known) == len(ports) else \
        "%d of %d passed · %d of %d measured" % (passed, len(known), len(known), len(ports))
    if "critical" in lv:
        lvl = "critical"
    elif passed == len(ports):
        lvl = "good"
    else:
        lvl = "warning"
    return badge("build", msg, lvl)


def size_badge(p):
    c = (p.get("ghcr") or {}).get("size")
    if (p.get("ghcr") or {}).get("state") == "absent":
        return badge("%s size" % p["arch"], "not published", "none")
    if not num(c):
        return badge("%s size" % p["arch"], "unknown", "unknown")
    return badge("%s size" % p["arch"], fmt_size(c), "info")


def packages_badge(p):
    e = p.get("evidence") or {}
    if not num(e.get("packages")):
        return badge("%s packages" % p["arch"], "unknown", "unknown")
    if e.get("matches") is False:
        return badge("%s packages" % p["arch"], "%s · older image" % fmt_int(e["packages"]), "warning")
    return badge("%s packages" % p["arch"], fmt_int(e["packages"]), "info")


