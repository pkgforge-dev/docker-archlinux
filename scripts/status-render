# The one script of the page. It runs after load and changes no text: it
# gives each <time> a title with the local time, its time zone and its age.
# With no script, the page reads the same, in UTC.
PAGE_SCRIPT = """addEventListener("load", function () {
  var f = {year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", timeZoneName: "short"};
  document.querySelectorAll("time[datetime]").forEach(function (e) {
    var t = new Date(e.getAttribute("datetime")), s = (Date.now() - t) / 1000;
    if (isNaN(s)) return;
    e.title = t.toLocaleString(undefined, f) + ", " + (s < 60 ? "now" : s < 3600 ? Math.floor(s / 60) + " min ago"
      : s < 86400 ? Math.floor(s / 3600) + " h ago" : Math.floor(s / 86400) + " d ago");
  });
});"""


def state_cell(level, word):
    return '<span class="st"><span class="dot %s" aria-hidden="true"></span>%s</span>' % (
        esc(level), esc(word))


def table(head, rows, nums=()):
    h = "".join('<th class="n">%s</th>' % esc(x) if i in nums else "<th>%s</th>" % esc(x)
                for i, x in enumerate(head))
    body = "".join("<tr>%s</tr>" % "".join('<td class="n">%s</td>' % c if i in nums else "<td>%s</td>" % c
                                           for i, c in enumerate(r)) for r in rows)
    return "<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (h, body)


def link(url, text):
    if isinstance(url, str) and url.startswith("https://"):
        return '<a href="%s">%s</a>' % (esc(url), esc(text))
    return esc(text)


def page(ctx, charts, badges):
    st, ports = ctx["status"], ctx["ports"]
    interval, tolerance = ctx["interval"], ctx["tolerance"]
    reg = st.get("registries") or {}
    lt = st.get("latest") or {}
    images = st.get("images") or {}
    site = st.get("site_url") or ""
    source = st.get("source") or ""
    n = len(ports)

    def tile(k, v, sub="", raw=False):
        return ('<div class="tile"><div class="k">%s</div><div class="v">%s</div>'
                '<div class="s">%s</div></div>' % (esc(k), v if raw else esc(v), esc(sub)))

    states = [freshness(p, interval, tolerance) for p in ports]
    cur = len([s for s, _ in states if s == "good"])
    read = len([s for s, _ in states if s != "unknown"])
    if read == 0:
        hero_big, hero_cap = "unknown", "The image age is not known: GHCR did not answer in this run."
    else:
        hero_big = "%d of %d" % (cur, n)
        hero_cap = ("images are current: built in the last %s. The build runs every %s."
                    % (fmt_interval(2 * interval), fmt_interval(interval)))
        if read < n:
            hero_cap += " %d of %d measured: the age of %d did not read." % (read, n, n - read)
    known = [p for p in ports if isinstance(p.get("build"), dict) and p["build"].get("result")]
    passed = len([p for p in known if p["build"]["result"] == "success"])
    ages = [p["age_seconds"] for p in ports if num(p.get("age_seconds"))]
    published = len([p for p in ports if (p.get("ghcr") or {}).get("state") == "published"])
    unread = len([p for p in ports if (p.get("ghcr") or {}).get("state") == "error"])
    absent = len([p for p in ports if (p.get("ghcr") or {}).get("state") == "absent"])
    if published == n:
        pub_s = "every port has an image"
    else:
        pub_s = ", ".join(x for x in ("%d not published" % absent if absent else "",
                                      "%d not read" % unread if unread else "") if x)
    mirror_cur = len([p for p in ports if (p.get("mirror") or {}).get("current") is True])
    mirror_known = len([p for p in ports if (p.get("mirror") or {}).get("current") is not None])
    if lt.get("state") == "published":
        lt_v = "%d of %d" % (len([p for p in ports if p.get("in_latest") is True]), n)
        lt_s = "platforms; missing: %s" % ", ".join(lt.get("missing")) if lt.get("missing") else "platforms"
    else:
        lt_v, lt_s = ("not published", "") if lt.get("state") == "absent" else ("unknown", "GHCR did not answer")
    tiles = "".join([
        tile("Published on GHCR", "%d of %d" % (published, n), pub_s),
        tile("Last build", "%d of %d passed" % (passed, len(known)) if known else "unknown",
             "newest Build job per port%s" % scope(len(known), n)),
        tile("Oldest image", fmt_age(max(ages)) if ages else "unknown", "built every %s" % fmt_interval(interval)),
        tile("latest", lt_v, lt_s),
        tile("Docker Hub", fmt_pct(reg.get("parity")),
             "of GHCR tags; %d run(s) in a row below 100%%" % (reg.get("drift_runs") or 0)
             if num(reg.get("parity")) else "a tag list or a digest did not read"),
        tile("Mirror", "%d of %d current" % (mirror_cur, mirror_known) if mirror_known else "unknown",
             "mirror-archlinux, every repo of the port"),
    ])

    def fig(name, alt, tbl):
        _, hw = charts[name]["wide"]
        _, hn = charts[name]["narrow"]
        return ('<figure><a href="charts/%(n)s.svg"><picture>'
                '<source media="(max-width: 600px)" srcset="charts/narrow/%(n)s.svg" width="%(nw)d" height="%(nh)d">'
                '<img src="charts/%(n)s.svg" width="%(ww)d" height="%(wh)d" alt="%(alt)s" loading="lazy">'
                '</picture></a><details><summary>Table</summary><div class="scroll">%(t)s</div></details></figure>'
                % {"n": name, "nw": NARROW, "nh": hn, "ww": WIDE, "wh": hw, "alt": esc(alt), "t": tbl})

    age_rows, size_rows, pkg_rows, tag_rows, build_rows = [], [], [], [], []
    for p, (lvl, word) in zip(ports, states):
        g = p.get("ghcr") or {}
        e = p.get("evidence") or {}
        b = p.get("build") or {}
        age_rows.append([esc(p["arch"]), state_cell(lvl, word), time_iso(g.get("created")),
                         esc(fmt_age(p.get("age_seconds")))])
        size_rows.append([esc(p["arch"]), esc(fmt_size(g.get("size"))), esc(fmt_int(g.get("layers"))),
                          esc(fmt_size(e.get("installed_bytes")))])
        ev_link = ('<a href="evidence/%s.json">%s</a>' % (esc(p["arch"]), state_cell(*evidence_state(p)))
                   if num(e.get("packages")) else state_cell(*evidence_state(p)))
        pkg_rows.append([esc(p["arch"]), esc(fmt_int(e.get("packages"))), esc(e.get("anchor") or "unknown"),
                         esc(fmt_size(e.get("bytes"))), ev_link])
        par = p.get("parity") or {}
        fam = g.get("tags") or {}
        tag_rows.append([esc(p["arch"]), esc(fmt_int(fam.get("rolling"))), esc(fmt_int(fam.get("dated"))),
                         esc(fmt_int(fam.get("anchor"))), esc(fmt_int(par.get("same"))), esc(fmt_int(par.get("tags")))])
        bl, bw = build_state(p.get("build"))
        build_rows.append([esc(p["arch"]), state_cell(bl, bw), esc(fmt_dur(b.get("duration_seconds"))),
                           time_iso(b.get("started")), link(b.get("job_url"), "job") if b else "unknown"])
    hist_rows = []
    for a in ctx["hist_order"]:
        pts = ctx["series"][a]
        hist_rows.append([esc(a), time_html(pts[0][0]), esc(fmt_age(max([x[1] for x in pts if x[1] is not None] or [None]))),
                          esc(fmt_size(next((x[2] for x in reversed(pts) if x[2] is not None), None))),
                          esc(fmt_int(len(pts)))])
    hist_table = table(["port", "first point", "largest age", "size now", "points"], hist_rows, (2, 3, 4))
    # The table counts the 30 days of the wide chart. The history holds more.
    grid = build_days(ctx)
    until = utc(ctx["now"]).date()
    since = until - datetime.timedelta(days=29)
    grid_rows = []
    for p in ports:
        days = grid.get(p["arch"], {})
        last30 = [v for d, v in days.items() if since <= d <= until]
        grid_rows.append([esc(p["arch"]), esc(fmt_int(len([v for v in last30 if v == "good"]))),
                          esc(fmt_int(len([v for v in last30 if v == "critical"]))),
                          esc(fmt_int(len([v for v in last30 if v == "warning"]))),
                          esc(max(days).isoformat() if days else "none")])

    comp = [p["ghcr"]["size"] for p in ports if num((p.get("ghcr") or {}).get("size"))]
    figs = "".join([
        fig("freshness", "Image age per port: %d of %d images are current." % (cur, n),
            table(["port", "state", "built", "age"], age_rows, (3,))),
        fig("build", "Last build per port: %d of %d passed." % (passed, len(known)) if known
            else "Last build per port: unknown.",
            table(["port", "result", "job time", "started", "link"], build_rows, (2,))),
        fig("size", "Image size per port: %s compressed, all images together." % fmt_size(sum(comp)) if comp
            else "Image size per port: unknown.",
            table(["port", "compressed", "layers", "installed"], size_rows, (1, 2, 3))),
        fig("packages", "Packages per image, from the evidence of each build.",
            table(["port", "packages", "anchor", "download", "evidence"], pkg_rows, (1, 3))),
        fig("coverage", "Tags per port on GHCR and on Docker Hub: %s of GHCR tags are on Docker Hub."
            % fmt_pct(reg.get("parity")),
            table(["port", "rolling", "dated", "anchor", "on Docker Hub", "on GHCR"], tag_rows, (1, 2, 3, 4, 5))),
        fig("history-build", "Build result per port and day: the last 30 days, the last 14 days on a narrow "
            "screen. The table counts the last 30 days.",
            table(["port", "days passed", "days failed", "days cancelled", "last build day"], grid_rows, (1, 2, 3))),
        fig("history-age", "Image age per port over the last 30 days.", hist_table),
        fig("history-size", "Compressed image size per port over the last 30 days.", hist_table),
    ])

    port_rows = []
    for p, (lvl, word) in zip(ports, states):
        g = p.get("ghcr") or {}
        e = p.get("evidence") or {}
        b = p.get("build") or {}
        bl, bw = build_state(p.get("build"))
        if num(b.get("duration_seconds")):
            bw = "%s, %s" % (bw, fmt_dur(b["duration_seconds"]))
        nd = g.get("newest_dated")
        first = (p.get("aliases") or [p["arch"]])[0]
        ml, mw = mirror_state(p)
        in_latest = {True: ("good", "yes"), False: ("critical", "no")}.get(p.get("in_latest"), ("unknown", "unknown"))
        port_rows.append([
            "<code>%s</code>" % esc(p["arch"]), esc(p.get("platform")),
            link(p.get("homepage"), p.get("distribution") or "unknown"),
            esc(", ".join(p.get("aliases") or [])),
            "<code>%s-v%s</code>" % (esc(first), esc(nd)) if nd else "unknown",
            state_cell(lvl, "%s, %s" % (fmt_age(p.get("age_seconds")), word) if num(p.get("age_seconds")) else word),
            esc(fmt_size(g.get("size"))), esc(fmt_int(e.get("packages"))), esc(e.get("anchor") or "unknown"),
            state_cell(bl, bw), state_cell(*match_state((p.get("hub") or {}).get("match"))),
            state_cell(*in_latest), state_cell(ml, mw),
            '<img src="badges/%s.svg" alt="%s badge" height="20">' % (esc(p["arch"]), esc(p["arch"])),
        ])
    ports_html = table(["port", "platform", "distribution", "aliases", "newest dated tag", "age", "size",
                        "packages", "anchor", "last build", "GHCR and Docker Hub", "in latest", "mirror", "badge"],
                       port_rows, (6, 7))

    roll = reg.get("rolling") or {}
    pin = reg.get("pinned") or {}
    differs = roll.get("differs") or []
    missing = pin.get("missing_names") or []
    reg_rows = [
        ["rolling tags, same digest", esc(fmt_int(roll.get("same"))), esc(fmt_int(roll.get("total"))),
         '<div class="list">%s</div>' % (", ".join("<code>%s</code>" % esc(t) for t in differs) or "none differ")],
        ["pinned tags, present", esc(fmt_int(pin.get("present"))), esc(fmt_int(pin.get("total"))),
         '<div class="list">%s%s</div>' % (", ".join("<code>%s</code>" % esc(t) for t in missing) or "none missing",
                                           esc(", and %s more" % fmt_int(pin["missing"] - len(missing)))
                                           if num(pin.get("missing")) and pin["missing"] > len(missing) else "")],
    ]
    reg_html = table(["tags", "on Docker Hub", "on GHCR", "not in step"], reg_rows, (1, 2))
    if lt.get("state") == "published":
        lt_html = "<p>The index tag <code>latest</code> carries %s. %s %s</p>" % (
            ", ".join("<code>%s</code>" % esc(x) for x in lt.get("platforms") or []) or "no platform",
            ("It lacks %s." % ", ".join("<code>%s</code>" % esc(x) for x in lt.get("missing"))) if lt.get("missing")
            else "It carries every port.",
            "Docker Hub <code>latest</code> has the same digest." if lt.get("hub_match") is True
            else ("Docker Hub <code>latest</code> has another digest." if lt.get("hub_match") is False
                  else "The Docker Hub digest of <code>latest</code> is unknown."))
    else:
        lt_html = "<p>The index tag <code>latest</code> is %s.</p>" % (
            "not published" if lt.get("state") == "absent" else "unknown: GHCR did not answer")

    mirror_rows = []
    for p in ports:
        for t in (p.get("mirror") or {}).get("targets") or []:
            if not t.get("found"):
                tl, tw = "unknown", "not in the record"
            elif t.get("current") is True:
                tl, tw = "good", "current"
            elif t.get("current") is False:
                tl, tw = "warning", "behind" if num(t.get("lag_seconds")) and t["lag_seconds"] > 0 else "not current"
            else:
                tl, tw = "unknown", "unknown"
            mirror_rows.append([esc(p["arch"]), "<code>%s</code>" % esc(t.get("target")), state_cell(tl, tw),
                                esc(fmt_age(t.get("lag_seconds"))), esc(fmt_age(t.get("age_seconds"))),
                                esc(fmt_pct(t.get("ratio_files")))])
    mi = st.get("mirror") or {}
    if mirror_rows:
        mirror_html = ('<p>Each port reads its packages through mirror-archlinux first. The record of %s, measured %s.</p>'
                       '<div class="scroll">%s</div>' % (
                           link(mi.get("url"), "mirror-archlinux"), time_iso(mi.get("generated")),
                           table(["port", "target", "state", "lag", "age", "coverage"], mirror_rows, (3, 4, 5))))
    else:
        mirror_html = "<p>The record of mirror-archlinux did not read in this run, so the mirror state is unknown.</p>"

    badge_rows = []
    for name in badges:
        badge_rows.append(['<img src="badges/%s.svg" alt="%s badge" height="20">' % (esc(name), esc(name)),
                           "<code>%sbadges/%s.svg</code>" % (esc(site), esc(name))])

    ghcr = images.get("ghcr") or "unknown"
    hub = images.get("hub") or "unknown"
    hub_short = hub[len("docker.io/"):] if hub.startswith("docker.io/") else hub
    use = ('<h2>Use the images</h2><div class="use">'
           '<div><h3>From GHCR</h3><pre><code>docker pull %(g)s:latest</code></pre></div>'
           '<div><h3>From Docker Hub</h3><pre><code>docker pull %(h)s:latest</code></pre></div>'
           '</div><p>A port has a rolling tag for each alias, a tag <code>&lt;alias&gt;-v&lt;date&gt;</code> for each '
           'build day, and a tag <code>&lt;alias&gt;-&lt;anchor&gt;</code> for each pacman version. A pinned tag never moves.</p>'
           % {"g": esc(ghcr), "h": esc(hub_short)})

    budget = st.get("budget") or {}
    budget_note = ""
    if budget.get("exhausted") is True:
        budget_note = ("<p>The measurement ran out of time (%s s). A value that did not fit is unknown.</p>"
                       % esc(budget.get("seconds")))
    head_badges = "".join('<img src="badges/%s.svg" alt="%s badge" height="20">' % (b, b)
                          for b in ("all", "build", "latest", "registries"))

    return """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>docker-archlinux status</title>
<meta name="description" content="Age, size, packages, builds and registry parity of the Arch Linux images of docker-archlinux.">
<style>%(css)s</style>
</head>
<body>
<div class="wrap">
<header class="top">
<div>
<h1>docker-archlinux status</h1>
<p class="lede">Arch Linux images for %(n)d architectures, on GHCR and Docker Hub.</p>
<p class="meta">Measured %(gen)s. Source: %(source)s.</p>
</div>
<div class="badges">%(head_badges)s</div>
</header>
<section class="hero" aria-label="Summary">
<div>
<p class="big">%(big)s</p>
<p class="big-cap">%(cap)s</p>
</div>
<div class="tiles">%(tiles)s</div>
</section>
%(budget)s
%(use)s
<h2>Charts</h2>
<div class="charts">%(figs)s</div>
<h2>Images</h2>
<p>One row per port. The age counts from the created label of the image on GHCR. GHCR and Docker Hub compares the digest of each alias on both registries. The mirror column is the largest lag of the repos of the port in mirror-archlinux.</p>
<div class="scroll">%(ports)s</div>
<h2>Registries</h2>
<p>Docker Hub carries %(parity)s of the GHCR tags: a rolling tag counts when it has the same digest, a pinned tag when it exists. The issue <code>registry-drift</code> opens when this is below 100%% in 2 runs in a row.</p>
<div class="scroll">%(reg)s</div>
%(latest)s
<h2>Mirror</h2>
%(mirror)s
<h2>Badges</h2>
<p>The status workflow writes each badge each hour, and after each build. An age in a badge counts to that measurement. A badge is an image and runs no script, so it shows its age as written.</p>
<div class="scroll">%(badges)s</div>
<footer>
<p>An image is current when it was built %(cur_limit)s ago or less, late up to %(tol)s, and stale after. Unknown means the value did not read in this run. It is never shown as 0.</p>
<p>Each time on this page is in UTC. With JavaScript on, hold the pointer on a time to see it in your time zone, with its age.</p>
<p>Data: <a href="status.json">status.json</a>, <a href="history.json">history.json</a>, and <code>evidence/&lt;port&gt;.json</code>, the package list of each image. Written by <code>scripts/status-collect</code> and <code>scripts/status-render</code>.</p>
</footer>
</div>
<script>
%(script)s
</script>
</body>
</html>
""" % {
        "css": PAGE_CSS, "script": PAGE_SCRIPT, "n": n,
        "gen": time_html(ctx["now"]), "source": link(source, source.replace("https://", "")),
        "head_badges": head_badges, "big": esc(hero_big), "cap": esc(hero_cap), "tiles": tiles,
        "budget": budget_note, "use": use, "figs": figs, "ports": ports_html,
        "parity": esc(fmt_pct(reg.get("parity"))), "reg": reg_html, "latest": lt_html, "mirror": mirror_html,
        "badges": table(["badge", "URL"], badge_rows),
        "cur_limit": esc(fmt_interval(2 * interval)), "tol": esc(fmt_interval(tolerance)),
    }


#---------------------------------------------------------------------------#
# Input and output
#---------------------------------------------------------------------------#
def read_json(path, what):
    if not os.path.exists(path):
        die("%s: no such file" % path, "it is %s" % what, "reproduce: ls -l %s" % path)
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        die("%s does not read as JSON: %s" % (path, e), "reproduce: python3 -I -m json.tool %s" % path)


def read_history(path):
    out = []
    if not os.path.exists(path):
        return out
    with open(path, encoding="utf-8") as f:
        for i, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError as e:
                warn("%s line %d is not JSON, so it is left out: %s" % (path, i, e))
                continue
            if not isinstance(obj, dict) or parse_time(obj.get("t")) is None:
                warn("%s line %d has no time t, so it is left out" % (path, i))
                continue
            out.append(obj)
    return out


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    os.replace(tmp, path)


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: python3 -I scripts/status-render IN OUT_SITE\n")
        return 2
    src, site = argv[1], argv[2]
    if not site:
        die("the site directory is empty", "reproduce: python3 -I scripts/status-render IN SITE")
    st = read_json(os.path.join(src, "status.json"), "the output of scripts/status-collect")
    if not isinstance(st, dict) or st.get("schema") != 1:
        die("%s/status.json is not schema 1" % src, "reproduce: python3 -I -m json.tool %s/status.json" % src)
    ports = st.get("ports")
    if not isinstance(ports, list) or not ports:
        die("%s/status.json names no port" % src)
    for p in ports:
        if not isinstance(p, dict) or not isinstance(p.get("arch"), str) or not p["arch"]:
            die("%s/status.json has a port entry with no arch: %r" % (src, p))
        if p["arch"] in RESERVED:
            die("the port name %s is also the name of a summary badge" % p["arch"],
                "the reserved names: %s" % " ".join(sorted(RESERVED)))
    history = read_history(os.path.join(src, "history.jsonl"))
    iv = st.get("interval") or {}
    gap = iv.get("gap_days") if num(iv.get("gap_days")) and iv.get("gap_days") > 0 else 1
    tol = iv.get("tolerance_days") if num(iv.get("tolerance_days")) and iv.get("tolerance_days") > 0 else 2 * gap + 1
    now = st.get("generated_epoch") if num(st.get("generated_epoch")) else parse_time(st.get("generated"))
    if not num(now):
        die("%s/status.json names no time it was measured" % src)
    order = [p["arch"] for p in ports]
    series = history_series(history, now)
    ctx = {
        "status": st, "ports": ports, "order": order, "slots": arch_slots(order), "now": now,
        "interval": gap * DAY, "tolerance": tol * DAY, "series": series, "history": history,
        "hist_order": [a for a in order if a in series] + sorted(a for a in series if a not in order),
    }

    builders = [("freshness", chart_freshness), ("size", chart_size), ("packages", chart_packages),
                ("coverage", chart_coverage), ("build", chart_build), ("history-age", chart_history_age),
                ("history-size", chart_history_size), ("history-build", chart_history_build)]
    charts = {}
    for name, build in builders:
        charts[name] = {"wide": build(ctx, WIDE), "narrow": build(ctx, NARROW)}
        write(os.path.join(site, "charts", name + ".svg"), charts[name]["wide"][0])
        write(os.path.join(site, "charts", "narrow", name + ".svg"), charts[name]["narrow"][0])

    interval, tolerance = ctx["interval"], ctx["tolerance"]
    badges = []

    def put(name, svg):
        write(os.path.join(site, "badges", name + ".svg"), svg)
        badges.append(name)

    for p in ports:
        put(p["arch"], arch_badge(p, interval, tolerance))
    put("all", all_badge(ports, interval, tolerance))
    put("latest", latest_badge(st, ports))
    put("registries", registries_badge(st))
    put("build", build_badge(ports))
    for p in ports:
        put("size-" + p["arch"], size_badge(p))
    for p in ports:
        put("packages-" + p["arch"], packages_badge(p))

    # The evidence the collect chose, as the status branch keeps it
    ev_in = os.path.join(src, "evidence")
    ev_n = 0
    if os.path.isdir(ev_in):
        names = set(order)
        for f in sorted(os.listdir(ev_in)):
            stem, ext = os.path.splitext(f)
            if stem in names and ext in (".json", ".digest"):
                os.makedirs(os.path.join(site, "evidence"), exist_ok=True)
                shutil.copyfile(os.path.join(ev_in, f), os.path.join(site, "evidence", f))
                ev_n += 1
    if os.path.exists(os.path.join(src, "history.jsonl")):
        shutil.copyfile(os.path.join(src, "history.jsonl"), os.path.join(site, "history.jsonl"))

    write(os.path.join(site, "index.html"), page(ctx, charts, badges))
    write(os.path.join(site, "status.json"), json.dumps(st, indent=1) + "\n")
    write(os.path.join(site, "history.json"), json.dumps(history, separators=(",", ":")) + "\n")
    sys.stderr.write("%s: %d chart(s) in 2 widths, %d badge(s), %d history line(s), %d evidence file(s), in %s\n"
                     % (PROG, len(charts), len(badges), len(history), ev_n, site))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
