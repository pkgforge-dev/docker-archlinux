#!/usr/bin/env bash
#
# Keep one GitHub issue for each lasting problem. Open it when the problem
# starts, keep its body current while the problem lasts, and close it when the
# problem clears.
#
#   scripts/track-issue raise <key> <title> <body-file>
#   scripts/track-issue clear <key> <note>
#
# ⭐ raise opens the issue one time and then only writes its title and body.
# A problem that lasts a month gives one notification, not thirty. clear adds
# the note as a comment and closes the issue. With no open issue, clear does
# nothing.
#
# ⭐ The body starts with the marker <!-- track: <key> -->. The marker finds the
# issue again. The search reads every open issue, all pages, so an issue whose
# label a person removed is still found. When more than one open issue has
# the marker, the one with the label wins, then the lowest number. raise puts
# the label back on an issue that lost it.
#
# ⛔ Only an issue that TRACK_ISSUE_AUTHOR opened, with the marker as the start
# of its body, is the issue of a key. Any user can open an issue with a
# marker in it. Without this rule, raise writes into that issue, and its
# author can close it or change it.
#
# ⛔ The issues are listed, never searched. The search index lags, and a
# lagging search opens a second issue for one problem.
#
# Environment: GH_TOKEN with issues: write, GITHUB_REPOSITORY (owner/name),
# TRACK_ISSUE_LABEL (default automation), TRACK_ISSUE_AUTHOR (default
# github-actions[bot], the login of the GITHUB_TOKEN of a workflow).
#
# Exit status: 0 done, 1 could not.
set -euo pipefail

LABEL="${TRACK_ISSUE_LABEL:-automation}"
AUTHOR="${TRACK_ISSUE_AUTHOR:-github-actions[bot]}"

die() {
  echo "track-issue: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

need() {
  command -v "$1" > /dev/null || die "$1 is required"
}
need gh
need jq

slug="${GITHUB_REPOSITORY:-}"
case "$slug" in
  */*) ;;
  *) die "GITHUB_REPOSITORY is not owner/name: ${slug:-<unset>}" ;;
esac

usage="usage: track-issue raise <key> <title> <body-file> | clear <key> <note>"
mode="${1:-}"
key="${2:-}"
case "$key" in
  '' | *[!a-z0-9._-]*)
    die "the key must be lowercase letters, digits, dot, dash or underscore: ${key:-<empty>}" "$usage"
    ;;
esac
marker="<!-- track: $key -->"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# find_open: sets n to the number of the open issue of AUTHOR whose body
# starts with the marker, or to nothing. Sets labelled to 1 when that issue has
# the label. It reads every page of open issues, with no label filter.
#
# ⛔ Called directly, never inside $( ). A command substitution turns off
# set -e, and a failed read must stop the script. Read as "no issue", it
# opens a second issue for one problem.
find_open() {
  gh api --paginate "repos/$slug/issues?state=open&per_page=100" > "$work/open.json"
  jq -r --arg m "$marker" --arg l "$LABEL" --arg a "$AUTHOR" '
    .[] | select(.pull_request == null) | select((.user.login // "") == $a)
    | select((.body // "") | startswith($m))
    | "\(if ([(.labels // [])[] | (.name // .)] | index($l)) then 0 else 1 end) \(.number)"
  ' "$work/open.json" | LC_ALL=C sort -k1,1n -k2,2n > "$work/hits.txt"
  n="$(awk 'NR == 1 { print $2 }' "$work/hits.txt")"
  labelled="$(awk 'NR == 1 { print ($1 == 0 ? 1 : 0) }' "$work/hits.txt")"
}

ensure_label() {
  local rc=0
  gh api "repos/$slug/labels/$LABEL" > "$work/label.json" 2> "$work/label.err" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  gh api -X POST "repos/$slug/labels" -f name="$LABEL" -f color=ededed \
    -f description="Opened and closed by the workflows of this repository" > /dev/null
}

case "$mode" in
  raise)
    title="${3:-}"
    body_file="${4:-}"
    [ -n "$title" ] || die "raise needs a title" "$usage"
    [ -f "$body_file" ] || die "raise needs a body file, and ${body_file:-<none>} is not one" "$usage"
    body="$marker
$(cat "$body_file")"
    find_open
    if [ -n "$n" ]; then
      gh api -X PATCH "repos/$slug/issues/$n" -f title="$title" -f body="$body" > /dev/null
      if [ "$labelled" != 1 ]; then
        ensure_label
        gh api -X POST "repos/$slug/issues/$n/labels" -f "labels[]=$LABEL" > /dev/null
        echo "track-issue: $key is open as #$n; the label $LABEL is back on it"
      fi
      echo "track-issue: $key is still open as #$n; its body is current"
    else
      ensure_label
      n="$(gh api -X POST "repos/$slug/issues" -f title="$title" -f body="$body" \
        -f "labels[]=$LABEL" --jq '.number')"
      echo "track-issue: $key opened as #$n"
    fi
    ;;
  clear)
    note="${3:-}"
    [ -n "$note" ] || die "clear needs a note: what cleared the problem" "$usage"
    find_open
    if [ -z "$n" ]; then
      echo "track-issue: $key has no open issue; nothing to close"
      exit 0
    fi
    gh api -X POST "repos/$slug/issues/$n/comments" -f body="$note" > /dev/null
    gh api -X PATCH "repos/$slug/issues/$n" -f state=closed -f state_reason=completed > /dev/null
    echo "track-issue: $key closed #$n"
    ;;
  *)
    die "$usage"
    ;;
esac
