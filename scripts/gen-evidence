#!/usr/bin/env bash
#
# Write the evidence file of one built image.
#
#   scripts/gen-evidence ARCH IMAGE PLATFORM OUTPUT
#
# The evidence names each package in the image: version, download size,
# installed size, sha256 and the build date of the package. A reader can then
# tell what is in an image without the image.
#
# The package set comes from the pacman database inside the image, so it is
# what was installed. The sizes, the sha256 and the dates come from the
# repository databases, because the local database has no sha256 and no
# download size.
#
# Environment:
#   DB_SNAPSHOT        a directory with the repository databases that the
#                      build used (the dbsnapshot target of the Dockerfile).
#                      Set: they are read from there and nothing is fetched.
#                      Unset: they are fetched from the mirror list.
#                      ⚠ A fetch can see newer databases than the build did.
#   EXPECT_ANCHOR      the anchor version that the build resolved. When set,
#                      the anchor package in the image must have it.
#   ANCHOR_PACKAGE     the anchor package (default pacman)
#   SOURCE_COMMIT, BUILD_DATE   the commit and the time of the build, recorded
#                      as they are. Unset or empty: read from the image labels
#                      org.opencontainers.image.revision and
#                      org.opencontainers.image.created. A label that is
#                      absent or empty gives "unknown".
#   CONTAINER_RUNTIME  docker or podman (default: the first one found)
#
# tests/image/40-evidence.sh checks the file.
#
# Exit status:
#   0  written
#   1  an error: a bad argument, an image or a database that cannot be read
#   3  DB_SNAPSHOT cannot be used: not a directory, or a database is missing
#   4  the database entry of an installed package is damaged upstream
#   5  installed packages are in no database: the snapshot is not the one the
#      image was installed from, or the databases moved after the build
#   6  the anchor in the image is not EXPECT_ANCHOR
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ANCHOR_PACKAGE="${ANCHOR_PACKAGE:-pacman}"
UA="${MIRROR_PROBE_UA:-docker-archlinux (+https://github.com/${GITHUB_REPOSITORY:-pkgforge-dev/docker-archlinux})}"
RUNTIME="${CONTAINER_RUNTIME:-}"

# die_rc CODE MESSAGE [DETAIL ...]
die_rc() {
  local code="$1"
  shift
  echo "gen-evidence: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit "$code"
}

# die MESSAGE [DETAIL ...]
die() {
  die_rc 1 "$@"
}

need() {
  command -v "$1" > /dev/null || die "$1 is required"
}
need curl
need awk
need jq
need tar

[ "$#" -eq 4 ] || die "usage: gen-evidence ARCH IMAGE PLATFORM OUTPUT"
dir="$1"
image="$2"
platform="$3"
output="$4"
[[ "$dir" =~ ^[a-z0-9]+$ ]] || die "the architecture '$dir' is not [a-z0-9]+"

if [ -z "$RUNTIME" ]; then
  if command -v podman > /dev/null; then
    RUNTIME=podman
  elif command -v docker > /dev/null; then
    RUNTIME=docker
  else
    die "no container runtime found, set CONTAINER_RUNTIME"
  fi
fi
# podman and docker on Windows are native programs and do not read MSYS
# paths. Only this wrapper turns path conversion off: curl and tar here need
# it on.
runtime() {
  MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' "$RUNTIME" "$@"
}

conf="$REPO_ROOT/rootfs/$dir/etc/pacman.conf"
list="$REPO_ROOT/rootfs/$dir/etc/pacman.d/mirrorlist"
[ -f "$conf" ] || die "no pacman.conf for $dir"
[ -f "$list" ] || die "no mirrorlist for $dir"

arch="$(awk -F= '/^[[:space:]]*Architecture[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$conf")"
[ -n "$arch" ] || die "$conf has no Architecture line"

# The repositories that this port enables. Evidence read from another set
# would miss packages.
repos="$(awk '/^[[:space:]]*\[/ { name = $0
                                  gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", name)
                                  if (name != "options") print name }' "$conf")"
[ -n "$repos" ] || die "$conf enables no repository"

#---------------------------------------------------------------------------#
# The snapshot of the databases that the build used.
#
# ⛔ It is checked here, before the image runs, so a wrong path fails in
# under a second.
#---------------------------------------------------------------------------#
snapshot="${DB_SNAPSHOT:-}"
if [ -n "$snapshot" ]; then
  [ -d "$snapshot" ] || die_rc 3 "DB_SNAPSHOT names $snapshot, which is not a directory" \
    "it must name the directory that the dbsnapshot target was exported to" \
    "export it: docker buildx build --platform $platform --target dbsnapshot --output type=local,dest=$snapshot ." \
    "or unset DB_SNAPSHOT to fetch the databases"
  for repo in $repos; do
    [ -f "$snapshot/$repo.db" ] || die_rc 3 "DB_SNAPSHOT $snapshot has no $repo.db" \
      "$conf enables $repo, so the snapshot must have its database" \
      "it has: $(find "$snapshot" -mindepth 1 -maxdepth 1 -printf '%f ')" \
      "export it again: docker buildx build --platform $platform --target dbsnapshot --output type=local,dest=$snapshot ."
  done
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

#---------------------------------------------------------------------------#
# 1. What is installed: the pacman database inside the image.
#
# The image runs. Evidence is made for an image that passed the shell test,
# so a root that cannot run a shell is a fault of the build.
#---------------------------------------------------------------------------#
echo "==> reading the installed set from $image" >&2
# shellcheck disable=SC2016
# The single quotes keep the glob and the variable for the shell in the
# container, which reads the filesystem of the image.
if ! runtime run --rm --platform "$platform" "$image" \
  sh -c 'for d in /var/lib/pacman/local/*/desc; do [ -e "$d" ] && cat "$d" && echo "%%END%%"; done' \
  > "$work/local.txt" 2> "$work/local.err"; then
  echo "gen-evidence: cannot read the package database inside $image" >&2
  sed 's/^/  /' < "$work/local.err" >&2
  die "the image must have a readable /var/lib/pacman/local" \
    "the runtime error is above" \
    "an image whose bootstrap installed nothing has the directory and no entry in it" \
    "list it: $RUNTIME run --rm --platform $platform $image sh -c 'ls /var/lib/pacman/local'"
fi

awk '
  /^%NAME%$/     { getline; name = $0; next }
  /^%VERSION%$/  { getline; version = $0; next }
  /^%%END%%$/    { if (name != "" && version != "") print name "\t" version
                   name = ""; version = ""; next }
' "$work/local.txt" | sort > "$work/installed.tsv"

installed_count="$(awk 'NF' "$work/installed.tsv" | wc -l | tr -d '[:space:]')"
[ "$installed_count" -gt 0 ] || die "no installed package found in $image"
echo "    $installed_count packages installed" >&2

#---------------------------------------------------------------------------#
# 2. What the repository databases say about those packages.
#
# With DB_SNAPSHOT the databases are read where the build left them.
# Without it each database is tried on each server of the mirror list in
# turn. So one mirror in the middle of a sync does not decide the evidence.
#---------------------------------------------------------------------------#

# db_sources REPO -> one source per line, the best first
#
# A snapshot gives one source, and it must be readable: the build exported
# it. Without a snapshot the sources are the Server lines of the list that
# the section of REPO includes, in file order.
db_sources() {
  if [ -n "$snapshot" ]; then
    printf '%s\n' "$snapshot/$1.db"
    return 0
  fi

  # ⛔ The list that the section includes, not always the default list. The
  # ArchPOWER [base-any] section includes a list of its own.
  local include
  include="$(awk -v want="$1" '
    /^[[:space:]]*\[/ {
      name = $0
      gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", name)
      inrepo = (name == want)
      next
    }
    inrepo && /^[[:space:]]*Include[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }' "$conf")"

  local from="$list"
  if [ -n "$include" ]; then
    # The path is absolute in the image, so it is read in the rootfs tree of
    # the port.
    from="$REPO_ROOT/rootfs/$dir${include}"
    [ -f "$from" ] || die "$conf includes $include for [$1] and rootfs/$dir$include is not there" \
      "make it: scripts/gen-mirrorlist $dir"
  fi
  awk '/^[[:space:]]*Server[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); print }' "$from"
}

# extract_desc FILE COMPRESSION -> the desc stream in $work/desc.txt
#
# COMPRESSION is the tar flag, -z or --zstd. The complaint of tar goes to
# $work/tar.err.
#
# ⛔ Through a pipe, never into a file. A database can store a desc member as
# a sparse file. GNU tar writes a sparse member to standard output with a
# seek. Into a regular file the seek goes back and writes over the records
# before the member, and tar still exits 0. A pipe cannot seek, so tar
# writes the hole as NUL bytes. Arch RISC-V's extra.db has such a member.
#
# The NUL bytes are removed. Each %FILENAME% starts a line of its own, so a
# member with nothing readable in it cannot join the next record.
extract_desc() {
  local file="$1" compression="$2"
  tar "$compression" -xOf "$file" --wildcards '*/desc' 2> "$work/tar.err" \
    | tr -d '\000' \
    | sed 's/%FILENAME%/\n&/g' > "$work/desc.txt"
}

# read_desc FILE LABEL -> the desc stream in $work/desc.txt
#
# LABEL says where the database came from. Returns 1, and leaves nothing,
# when FILE is not a readable archive in either compression, so a caller can
# go to the next server. On success desc_compression is the tar flag.
#
# ⛔ Two compressions: the Arch ports use gzip and ArchPOWER uses Zstandard.
# Both name the file <repo>.db.
desc_compression=""
read_desc() {
  local file="$1" label="$2" gz_said zstd_said
  # A stream, not an extract: extra has about 15000 members, and 15000 small
  # files cost minutes.
  if extract_desc "$file" -z; then
    desc_compression=-z
    return 0
  fi
  gz_said="$(awk 'NF { print; exit }' "$work/tar.err")"

  if ! command -v zstd > /dev/null; then
    zstd_said="zstd is not on PATH, so a Zstandard database cannot be read here"
  elif extract_desc "$file" --zstd; then
    desc_compression=--zstd
    return 0
  else
    zstd_said="$(awk 'NF { print; exit }' "$work/tar.err")"
  fi

  echo "gen-evidence: $label is not a readable archive: gzip said ${gz_said:-nothing}; zstd said ${zstd_said:-nothing}" >&2
  rm -f "$work/desc.txt"
  return 1
}

# unreadable_members FILE PARSED -> each desc member that gave no record
#
# PARSED has one "name<TAB>version" line for each record read from FILE. The
# directory of a member is <name>-<version>, so the two sets compare
# directly. ⚠ A member printed here is a damaged entry in the database: it
# has a name and nothing readable in it.
unreadable_members() {
  local file="$1" parsed="$2"
  tar "$desc_compression" -tf "$file" \
    | awk -F/ '$2 == "desc" && NF == 2 { print $1 }' \
    | LC_ALL=C sort -u > "$work/members.txt"
  awk -F'\t' '{ print $1 "-" $2 }' "$parsed" | LC_ALL=C sort -u > "$work/parsed-members.txt"
  LC_ALL=C comm -23 "$work/members.txt" "$work/parsed-members.txt"
}

: > "$work/repo.tsv"
: > "$work/damaged.txt"
for repo in $repos; do
  got=0
  from=""
  while IFS= read -r source; do
    [ -n "$source" ] || continue

    if [ -n "$snapshot" ]; then
      # Read where it is. The file is the record of the build.
      read_desc "$source" "$source" \
        || die "the $repo database in DB_SNAPSHOT cannot be read" \
          "$source is what the dbsnapshot target exported, so this is a fault of the build" \
          "the reason from tar is above" \
          "reproduce: tar -tzf $source"
      from="$source"
      db="$source"
    else
      url="${source//\$repo/$repo}"
      url="${url//\$arch/$arch}"
      db="$work/$repo.db"
      # ⚠ -f, so a mirror that answers 403 says so. Without it curl exits 0
      # with the error page in the file, which then reads as a damaged
      # archive.
      if ! fetch_error="$(curl -sSfL -A "$UA" --connect-timeout 10 --max-time 300 \
        -o "$db" "$url/$repo.db" 2>&1)"; then
        echo "gen-evidence: cannot fetch $url/$repo.db: ${fetch_error:-no error text}" >&2
        rm -f "$db"
        continue
      fi
      if ! read_desc "$db" "$url/$repo.db"; then
        rm -f "$db"
        continue
      fi
      from="$url/$repo.db"
    fi

    awk '
      function flush() {
        if (name != "" && version != "") {
          printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, version,
                 (csize == "" ? "-" : csize),
                 (isize == "" ? "-" : isize),
                 (sha == "" ? "-" : sha),
                 (built == "" ? "-" : built)
        }
        name = ""; version = ""; csize = ""; isize = ""; sha = ""; built = ""
      }
      /^%FILENAME%$/  { flush(); next }
      /^%NAME%$/      { getline; name = $0; next }
      /^%VERSION%$/   { getline; version = $0; next }
      /^%CSIZE%$/     { getline; csize = $0; next }
      /^%ISIZE%$/     { getline; isize = $0; next }
      /^%SHA256SUM%$/ { getline; sha = $0; next }
      /^%BUILDDATE%$/ { getline; built = $0; next }
      END { flush() }
    ' "$work/desc.txt" > "$work/repo-one.tsv"
    rm -f "$work/desc.txt"

    # ⛔ Each desc member must give one record. A member that gives none is
    # named here. So a damaged entry upstream is a line in the log, not a
    # package that drops out of the join below.
    unreadable_members "$db" "$work/repo-one.tsv" > "$work/damaged-one.txt"
    if [ -s "$work/damaged-one.txt" ]; then
      echo "gen-evidence: ⚠ $from has desc members with nothing readable in them:" >&2
      sed 's/^/  /' "$work/damaged-one.txt" >&2
      cat "$work/damaged-one.txt" >> "$work/damaged.txt"
    fi
    cat "$work/repo-one.tsv" >> "$work/repo.tsv"
    [ -n "$snapshot" ] || rm -f "$db"
    got=1
    break
  done < <(db_sources "$repo")

  [ "$got" -eq 1 ] || die "no server in rootfs/$dir/etc/pacman.d/mirrorlist gave the $repo database of $dir"
  echo "    $repo database read from $from, $(awk 'END { print NR + 0 }' "$work/repo-one.tsv") records" >&2
done

#---------------------------------------------------------------------------#
# 3. Join. Nothing that is missing is made up.
#---------------------------------------------------------------------------#
awk -F'\t' '
  NR == FNR { key = $1 "\t" $2
              csize[key] = $3; isize[key] = $4; sha[key] = $5; built[key] = $6
              next }
  { key = $1 "\t" $2
    if (key in sha) {
      printf "%s\t%s\t%s\t%s\t%s\t%s\n", $1, $2, csize[key], isize[key], sha[key], built[key]
    } else {
      printf "%s\t%s\t-\t-\t-\t-\n", $1, $2
    }
  }
' "$work/repo.tsv" "$work/installed.tsv" > "$work/joined.tsv"

unresolved="$(awk -F'\t' '$5 == "-" { printf "%s %s, ", $1, $2 }' "$work/joined.tsv")"

anchor_version="$(awk -F'\t' -v p="$ANCHOR_PACKAGE" '$1 == p { print $2; exit }' "$work/joined.tsv")"
[ -n "$anchor_version" ] || die "the anchor package $ANCHOR_PACKAGE is not installed in $image"

# ⛔ The pinned tag <alias>-<anchor> names the anchor that the build resolved.
# The image must have that version, or the tag names a version it does not
# have.
if [ -n "${EXPECT_ANCHOR:-}" ] && [ "$anchor_version" != "$EXPECT_ANCHOR" ]; then
  die_rc 6 "$image has $ANCHOR_PACKAGE $anchor_version; the build resolved $EXPECT_ANCHOR" \
    "the tag $ANCHOR_PACKAGE version would name a version that the image does not have" \
    "the database moved between the resolve step and the build, or the build cache is old" \
    "reproduce: $RUNTIME run --rm --platform $platform $image pacman -Q $ANCHOR_PACKAGE"
fi

#---------------------------------------------------------------------------#
# 4. Write.
#
# A build date that upstream does not give is a dash. It is never guessed.
#---------------------------------------------------------------------------#
# The two runtimes keep the digest in different places. podman has .Digest;
# docker has no such field and fails on it. A reference with @sha256: needs
# neither, and CI gives that shape.
resolve_digest() {
  local ref="$1" out
  case "$ref" in
    *@sha256:*)
      printf 'sha256:%s\n' "${ref##*@sha256:}"
      return 0
      ;;
  esac
  if out="$(runtime image inspect "$ref" --format '{{ .Digest }}' 2>&1)"; then
    if [ -n "$out" ] && [ "$out" != "<no value>" ]; then
      printf '%s\n' "$out"
      return 0
    fi
  fi
  if out="$(runtime image inspect "$ref" --format '{{ index .RepoDigests 0 }}' 2>&1)"; then
    case "$out" in
      *@sha256:*)
        printf 'sha256:%s\n' "${out##*@sha256:}"
        return 0
        ;;
    esac
  fi
  return 0
}

# ⛔ Each of three faults gets its own exit code and words, so the reader
# goes to the right place. A damaged database entry is first, because no
# export again can change it.
if [ -n "$unresolved" ]; then
  echo "gen-evidence: these installed packages are in no repository database:" >&2
  echo "  ${unresolved%, }" >&2
  damaged_installed="$(awk -F'\t' 'NR == FNR { bad[$1] = 1; next }
                                    $5 == "-" && (($1 "-" $2) in bad) { printf "%s %s, ", $1, $2 }' \
    "$work/damaged.txt" "$work/joined.tsv")"
  if [ -n "$damaged_installed" ]; then
    die_rc 4 "the repository database entry of an installed package is damaged upstream" \
      "damaged: ${damaged_installed%, }" \
      "the entry has nothing readable, so its size, sha256 and date cannot be recorded" \
      "a later database that writes the entry again clears this with no change here" \
      "reproduce: tar -tvf <the database> | grep <the package>, then extract that desc member"
  fi
  if [ -n "$snapshot" ]; then
    die_rc 5 "$snapshot is not the snapshot that this image was installed from" \
      "the packages above are in the image and not in the exported databases" \
      "a build cache miss makes this: the export resolved against another set" \
      "export it again from the same build: docker buildx build --platform $platform --target dbsnapshot --output type=local,dest=$snapshot ."
  fi
  die_rc 5 "the databases moved between the build and this run, so the evidence has holes" \
    "the packages above are in the image and in no repository database" \
    "set DB_SNAPSHOT to the databases that the build used"
fi

digest="$(resolve_digest "$image")"
# shellcheck disable=SC2016
# Expanded in the container, from the os-release of the image.
version_id="$(runtime run --rm --platform "$platform" "$image" \
  sh -c '. /etc/os-release; printf "%s\n" "${VERSION_ID:-}"')"

# The commit and the time of the build. ⛔ Without SOURCE_COMMIT and
# BUILD_DATE they come from the labels of the image, never from this run: a
# release that makes the evidence again is not the build of the image.
source_commit="${SOURCE_COMMIT:-}"
built="${BUILD_DATE:-}"
if [ -z "$source_commit" ] || [ -z "$built" ]; then
  rc=0
  labels="$(runtime image inspect "$image" --format '{{ json .Config.Labels }}' 2> "$work/inspect.err")" || rc=$?
  if [ "$rc" -ne 0 ] || ! printf '%s' "$labels" | jq -e 'type == "object" or type == "null"' > /dev/null; then
    die "cannot read the labels of $image: $RUNTIME image inspect exited $rc" \
      "it said: $(awk 'NF { print; exit }' "$work/inspect.err")${labels:+; it printed: $labels}" \
      "or set SOURCE_COMMIT and BUILD_DATE" \
      "reproduce: $RUNTIME image inspect $image --format '{{ json .Config.Labels }}'"
  fi
  # label KEY -> the value of the label KEY, or unknown
  label() {
    printf '%s' "$labels" | jq -r --arg k "$1" '(.[$k] // "") | if . == "" then "unknown" else . end'
  }
  [ -n "$source_commit" ] || source_commit="$(label org.opencontainers.image.revision)"
  [ -n "$built" ] || built="$(label org.opencontainers.image.created)"
fi

jq -n \
  --arg image "$image" \
  --arg platform "$platform" \
  --arg digest "${digest:--}" \
  --arg built "$built" \
  --arg source_commit "$source_commit" \
  --arg version "${version_id:--}" \
  --arg arch "$arch" \
  --arg docker_arch "$dir" \
  --arg anchor_name "$ANCHOR_PACKAGE" \
  --arg anchor_version "$anchor_version" \
  --rawfile packages "$work/joined.tsv" \
  '{
     image: $image,
     platform: $platform,
     digest: $digest,
     built: $built,
     source_commit: $source_commit,
     version_id: $version,
     architecture: $arch,
     docker_architecture: $docker_arch,
     anchor: { name: $anchor_name, version: $anchor_version },
     packages: (
       $packages
       | split("\n")
       | map(select(length > 0))
       | map(split("\t"))
       | map({
           name:     .[0],
           version:  .[1],
           size:     (if .[2] == "-" then "-" else (.[2] | tonumber) end),
           installed_size: (if .[3] == "-" then "-" else (.[3] | tonumber) end),
           sha256:   .[4],
           released: (if .[5] == "-" then "-"
                      else (.[5] | tonumber | gmtime | strftime("%Y-%m-%d")) end)
         })
     )
   }
   | .package_count = (.packages | length)' > "$output"

jq -e . "$output" > /dev/null || die "the evidence file is not valid JSON: $output"

echo "==> wrote $output" >&2
echo "    $(jq -r '.package_count' "$output") packages, anchor $ANCHOR_PACKAGE $anchor_version, digest ${digest:--}" >&2
