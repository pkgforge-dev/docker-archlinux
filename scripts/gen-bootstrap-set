#!/usr/bin/env bash
#
# Write the resolved package set of one image as plain text.
#
#   scripts/gen-bootstrap-set EVIDENCE.json OUT
#
# EVIDENCE.json is an evidence file from scripts/gen-evidence. OUT gets one
# line for each package, sorted by name under LC_ALL=C:
#
#   name  version  sha256
#
# A header of # lines names the image, and a trailer of # lines gives the
# counts. awk, sort and a shell read the file with no other tool.
#
# The sha256 is the sha256 of the package file that the repository database
# gives. A rebuild that fetches these names at these versions and checks these
# hashes gets the same packages.
#
# ⚠ A package whose database entry has no sha256 gets a dash. The trailer
# counts these lines. ⛔ A package is never left out.
#
# ⚠ The file is not a dependency graph and not an install order. pacman finds
# both from the databases.
#
# Exit status: 0 written, 1 a failure.
set -euo pipefail

PROG=gen-bootstrap-set
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need jq

ev="${1:-}"
out="${2:-}"
[ -n "$ev" ] && [ -n "$out" ] || die "usage: gen-bootstrap-set EVIDENCE.json OUT"
[ -f "$ev" ] || die "no evidence file at $ev" \
  "scripts/gen-evidence writes one for each image" \
  "reproduce: ls -l $ev"

rc=0
check="$(jq -e . "$ev" 2>&1)" || rc=$?
[ "$rc" -eq 0 ] || die "$ev is not valid JSON" \
  "jq said: $(printf '%s\n' "$check" | awk 'END { print }')" \
  "reproduce: jq . $ev"

for field in architecture docker_architecture anchor package_count packages; do
  [ "$(jq --arg f "$field" 'has($f)' "$ev")" = true ] \
    || die "$ev has no $field field, so it is not an evidence file of scripts/gen-evidence" \
      "reproduce: jq keys $ev"
done

count="$(jq -r '.package_count' "$ev")"
[ "$count" -gt 0 ] || die "$ev records no packages" \
  "a package set of an empty root is not an asset" \
  "reproduce: jq .package_count $ev"

{
  echo "# The resolved package set of one image."
  echo "#"
  echo "# Columns, separated by white space:  name  version  sha256"
  echo "#"
  echo "# ⛔ A sha256 of - means that the repository database gave none for that"
  echo "# package. The trailer counts these lines. A consumer that needs every"
  echo "# package checked refuses a set with a count above zero."
  echo "#"
  printf '# image                %s\n' "$(jq -r '.image' "$ev")"
  printf '# platform             %s\n' "$(jq -r '.platform' "$ev")"
  printf '# architecture         %s\n' "$(jq -r '.architecture' "$ev")"
  printf '# docker architecture  %s\n' "$(jq -r '.docker_architecture' "$ev")"
  printf '# version              %s\n' "$(jq -r '.version_id' "$ev")"
  printf '# built                %s\n' "$(jq -r '.built' "$ev")"
  printf '# source commit        %s\n' "$(jq -r '.source_commit' "$ev")"
  printf '# image digest         %s\n' "$(jq -r '.digest' "$ev")"
  printf '# anchor               %s %s\n' "$(jq -r '.anchor.name' "$ev")" "$(jq -r '.anchor.version' "$ev")"
  echo "#"

  # Sorted under LC_ALL=C: two runs on one evidence file give the same bytes,
  # and a diff of two releases is short.
  jq -r '.packages[] | [.name, .version, (.sha256 // "-")] | @tsv' "$ev" \
    | LC_ALL=C sort \
    | awk -F'\t' '{ printf "%-40s %-28s %s\n", $1, $2, $3 }'

  unhashed="$(jq -r '[.packages[] | select((.sha256 // "-") == "-")] | length' "$ev")"
  echo "#"
  printf '# packages             %s\n' "$count"
  printf '# without a sha256     %s\n' "$unhashed"
} > "$out"

# ⛔ Count the lines in the file, not the lines that should be there.
written="$(awk '!/^#/ && NF { n++ } END { print n + 0 }' "$out")"
[ "$written" = "$count" ] || die "wrote $written package lines, the evidence records $count" \
  "reproduce: awk '!/^#/ && NF' $out | wc -l"

note "wrote $out: $written packages, $(awk '/^# without a sha256/ { print $NF }' "$out") without a sha256"
