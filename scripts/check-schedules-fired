#!/usr/bin/env bash
#
# Check that every schedule of the repository still fires, and find each
# scheduled workflow whose recent scheduled runs all failed.
#
#   scripts/check-schedules-fired [OUT_DIR]
#
# ⭐ The list of workflows comes from .github/workflows/: every file with a cron
# line. A new scheduled workflow comes under this check with no edit here.
#
# Each workflow is measured against its own cron through scripts/cron-tolerance,
# so a weekly workflow does not get the tolerance of a daily one.
#
# ⚠ A workflow with no scheduled run is not a failure on the day it is added.
# It is a failure when it is older than its own tolerance and still has no
# scheduled run: that cron never worked.
#
# ⚠ GitHub keeps no record of a workflow file that never ran and is not on the
# default branch. Its run list answers 404. That workflow is "unknown", not
# stopped.
#
# Failing: when the newest 3 completed scheduled runs all concluded failure,
# timed_out or startup_failure, the workflow is "failing". When the newest
# completed scheduled run concluded success, it is "passing". Any other mix is
# "mixed", and no completed scheduled run is "none". With OUT_DIR, the script
# writes for each scheduled workflow:
#   OUT_DIR/<stem>.result   failing, passing, mixed or none
#   OUT_DIR/<stem>.runs     the newest 3 completed scheduled runs, one per
#                           line: <created_at> <conclusion> <url>
# <stem> is the file name without .yml or .yaml. scripts/watch-schedules reads
# these files and keeps the issue failing-<stem> in step.
#
# Environment:
#   GITHUB_REPOSITORY  owner/name; default: read from the origin remote
#   SCHEDULES_TODAY    YYYY-MM-DD, the day to measure against; default today
#                      (UTC). ⚠ A test seam. No workflow sets it.
#
# Needs a token with actions: read: GH_TOKEN in a workflow, the gh login
# locally.
#
# Exit status:
#   0  every schedule fired within its tolerance
#   3  at least one schedule stopped
#   1  the check could not run
# A failing workflow does not change the exit status. It is in OUT_DIR.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die() {
  echo "check-schedules-fired: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

need() {
  command -v "$1" > /dev/null || die "$1 is required"
}
need gh
need jq
need awk

out_dir="${1:-}"
if [ -n "$out_dir" ]; then
  mkdir -p "$out_dir"
fi

slug="${GITHUB_REPOSITORY:-}"
if [ -z "$slug" ]; then
  # git's own message is kept, because git can fail for more than one reason.
  if ! origin="$(git -C "$REPO_ROOT" remote get-url origin 2>&1)"; then
    die "no GITHUB_REPOSITORY, and the origin remote could not be read" \
      "git said: $origin" \
      "reproduce: git -C $REPO_ROOT remote get-url origin"
  fi
  [ -n "$origin" ] || die "the origin remote has an empty URL" \
    "reproduce: git -C $REPO_ROOT remote get-url origin"
  slug="$(printf '%s' "$origin" | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##')"
fi
case "$slug" in
  */*) ;;
  *) die "the repository slug is not owner/name: $slug" ;;
esac

today="${SCHEDULES_TODAY:-$(date -u +%Y-%m-%d)}"
case "$today" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
  *) die "SCHEDULES_TODAY is not YYYY-MM-DD: $today" ;;
esac

# age_days <ISO timestamp or YYYY-MM-DD> -> whole days from then to $today.
# The calendar arithmetic is in scripts/date-age only.
age_days() {
  "$REPO_ROOT/scripts/date-age" "$1" "$today"
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

#---------------------------------------------------------------------------#
# Find every workflow file with a cron.
#---------------------------------------------------------------------------#
wf_dir="$REPO_ROOT/.github/workflows"
[ -d "$wf_dir" ] || die "no workflow directory at $wf_dir"

scheduled=""
unscheduled=""
for wf in "$wf_dir"/*.yml "$wf_dir"/*.yaml; do
  [ -e "$wf" ] || continue
  if grep -q '^[[:space:]]*-[[:space:]]*cron:' "$wf"; then
    scheduled="$scheduled $(basename "$wf")"
  else
    unscheduled="$unscheduled $(basename "$wf")"
  fi
done

if [ -z "$scheduled" ]; then
  die "no scheduled workflow in $wf_dir" \
    "a schedule stops with no error, so to find none is not a pass" \
    "reproduce: grep -l 'cron:' .github/workflows/*"
fi

echo "check-schedules-fired: $slug, measured on $today" >&2
# The skipped workflows are named, so a reader can see that the list is whole.
echo "check-schedules-fired: no schedule, not checked:${unscheduled:- none}" >&2

# judge RUNS_JSON STEM: writes the failing result of one workflow
judge() {
  local runs="$1" stem="$2" result
  jq -r '[ .workflow_runs[] | select(.event == "schedule" and .status == "completed") ]
    | sort_by(.created_at) | reverse | .[0:3][]
    | "\(.created_at) \(.conclusion // "none") \(.html_url // "-")"' "$runs" | tr -d '\r' > "$work/recent.txt"
  result="$(awk '
    { n++; if ($2 == "failure" || $2 == "timed_out" || $2 == "startup_failure") bad++; if (n == 1) first = $2 }
    END {
      if (n == 0) print "none"
      else if (n >= 3 && bad == n) print "failing"
      else if (first == "success") print "passing"
      else print "mixed"
    }' "$work/recent.txt")"
  if [ "$result" = failing ]; then
    printf 'FAILING   %-34s the newest 3 completed scheduled runs failed\n' "$stem"
  fi
  if [ -n "$out_dir" ]; then
    printf '%s\n' "$result" > "$out_dir/$stem.result"
    cp "$work/recent.txt" "$out_dir/$stem.runs"
  fi
}

#---------------------------------------------------------------------------#
# Measure.
#---------------------------------------------------------------------------#
stopped=0
checked=0

for file in $scheduled; do
  checked=$((checked + 1))
  stem="${file%.*}"

  if ! tol_line="$("$REPO_ROOT/scripts/cron-tolerance" "$wf_dir/$file")"; then
    die "cannot derive a tolerance for $file" \
      "reproduce: scripts/cron-tolerance .github/workflows/$file"
  fi
  read -r _ tolerance <<< "$tol_line"

  # ⚠ Only scheduled runs count. Runs that a person starts by hand can hide a
  # dead cron.
  #
  # ⚠ The plain run list is read and filtered here. The list filtered by the
  # API (event=schedule) can lag by weeks. It is read only when the plain list
  # has no scheduled run.
  rc=0
  gh api "repos/$slug/actions/workflows/$file/runs?per_page=100" > "$work/runs.json" 2> "$work/runs.err" || rc=$?
  if [ "$rc" -ne 0 ]; then
    case "$(cat "$work/runs.json" "$work/runs.err")" in
      *'HTTP 404'*)
        printf 'unknown   %-34s GitHub has no record of it (not on the default branch, or never run)\n' "$file"
        if [ -n "$out_dir" ]; then
          printf 'none\n' > "$out_dir/$stem.result"
          : > "$out_dir/$stem.runs"
        fi
        continue
        ;;
    esac
    die "cannot read the run list for $file" \
      "the token needs actions: read" \
      "gh said: $(awk 'NF { print; exit }' "$work/runs.err")" \
      "reproduce: gh api repos/$slug/actions/workflows/$file/runs?per_page=100"
  fi
  last="$(jq -r '[ .workflow_runs[] | select(.event == "schedule") | .created_at ] | max // empty' "$work/runs.json" | tr -d '\r')"

  if [ -z "$last" ]; then
    rc=0
    gh api "repos/$slug/actions/workflows/$file/runs?event=schedule&per_page=100" > "$work/runs.json" 2> "$work/runs.err" || rc=$?
    [ "$rc" -eq 0 ] || die "cannot read the scheduled run list for $file" \
      "the token needs actions: read" \
      "gh said: $(awk 'NF { print; exit }' "$work/runs.err")" \
      "reproduce: gh api 'repos/$slug/actions/workflows/$file/runs?event=schedule&per_page=100'"
    last="$(jq -r '[ .workflow_runs[] | select(.event == "schedule") | .created_at ] | max // empty' "$work/runs.json" | tr -d '\r')"
  fi

  judge "$work/runs.json" "$stem"

  if [ -n "$last" ]; then
    age="$(age_days "$last")"
    if [ "$age" -le "$tolerance" ]; then
      printf 'ok        %-34s last scheduled run %s, %s day(s) ago, tolerance %s\n' \
        "$file" "${last:0:10}" "$age" "$tolerance"
    else
      stopped=$((stopped + 1))
      printf 'STOPPED   %-34s last scheduled run %s, %s day(s) ago, tolerance %s\n' \
        "$file" "${last:0:10}" "$age" "$tolerance"
    fi
    continue
  fi

  # No scheduled run. A new workflow is fine; an old one has a cron that
  # never worked.
  #
  # ⚠ "New" counts from the newer of two dates: the day GitHub made the
  # workflow record, and the newest commit that changed the file. A cron added
  # to an old workflow is new until its first scheduled run.
  rc=0
  gh api "repos/$slug/actions/workflows/$file" > "$work/meta.json" 2> "$work/meta.err" || rc=$?
  [ "$rc" -eq 0 ] || die "cannot read the workflow record for $file" \
    "gh said: $(awk 'NF { print; exit }' "$work/meta.err")" \
    "reproduce: gh api repos/$slug/actions/workflows/$file"
  created="$(jq -r '.created_at // empty' "$work/meta.json" | tr -d '\r')"
  [ -n "$created" ] || die "the workflow record for $file has no created_at" \
    "reproduce: gh api repos/$slug/actions/workflows/$file --jq .created_at"
  rc=0
  gh api "repos/$slug/commits?path=.github/workflows/$file&per_page=1" > "$work/commits.json" 2> "$work/commits.err" || rc=$?
  [ "$rc" -eq 0 ] || die "cannot read the newest commit of .github/workflows/$file" \
    "gh said: $(awk 'NF { print; exit }' "$work/commits.err")" \
    "reproduce: gh api 'repos/$slug/commits?path=.github/workflows/$file&per_page=1'"
  changed="$(jq -r '.[0].commit.committer.date // empty' "$work/commits.json" | tr -d '\r')"

  since="$(age_days "$created")"
  if [ -n "$changed" ]; then
    edit="$(age_days "$changed")"
    [ "$edit" -ge "$since" ] || since="$edit"
  fi
  if [ "$since" -le "$tolerance" ]; then
    printf 'new       %-34s no scheduled run yet, added or changed %s day(s) ago, tolerance %s\n' \
      "$file" "$since" "$tolerance"
  else
    stopped=$((stopped + 1))
    printf 'NEVER     %-34s no scheduled run in %s day(s) since it was added or changed, tolerance %s\n' \
      "$file" "$since" "$tolerance"
  fi
done

[ "$checked" -gt 0 ] || die "no workflow was checked" \
  "reproduce: grep -l 'cron:' .github/workflows/*"

if [ "$stopped" -eq 0 ]; then
  echo "check-schedules-fired: $checked schedule(s), all firing"
  exit 0
fi

echo "check-schedules-fired: $stopped of $checked schedule(s) stopped" >&2
echo "  A schedule that stops makes no run, so no run fails. This exit status is the signal." >&2
echo "  The workflow state field stays active while a schedule is silent; it is not the signal." >&2
echo "  GitHub disables schedules after 60 days with no activity. Enable them in the Actions tab." >&2
echo "  reproduce: gh api repos/$slug/actions/workflows --jq '.workflows[] | \"\\(.path) \\(.state)\"'" >&2
exit 3
