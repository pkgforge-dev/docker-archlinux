#!/usr/bin/env bash
#
# Check the asset directory of a release, write its SHA256SUMS, and print the
# release body.
#
#   scripts/release-notes ASSET_DIR TAG [META_DIR]
#       Check ASSET_DIR, write ASSET_DIR/SHA256SUMS, print the body on stdout.
#   scripts/release-notes --next-tag
#       Read git tag names on stdin. Print the next patch tag after the newest
#       vX.Y.Z tag, or v0.1.0 when there is none.
#
# META_DIR holds the notes of the rootfs jobs of release.yml:
#   absent-ARCH.json   {"arch", "reason"}: the port has no published image
#   rootfs-ARCH.json   {"arch", "image", "digest", "evidence"}: evidence is
#                      "status-branch" or "regenerated"
#
# Environment:
#   RELEASE_ARCHES     the ports that the release covers, separated by spaces.
#                      Default: scripts/ports list.
#   GITHUB_REPOSITORY  OWNER/REPO for the download URL in the body.
#
# Rules:
#   - Each port has pacman-static-ARCH and its evidence file. The evidence
#     passes scripts/build-pacman-static --check-evidence.
#   - Each port has rootfs-ARCH.tar.gz, rootfs-ARCH.json, bootstrap-set-ARCH.txt
#     and oci-ARCH.tar.gz, or META_DIR/absent-ARCH.json and none of the four.
#   - manifest.json is present and has the schema docker-archlinux/manifest/1.
#   - The directory holds no other file.
#   - All binaries come from one pacman commit.
#
# ⛔ The body is made from the files only. It names no version, date or port
# that the files do not give.
#
# Exit status: 0 done, 1 a rule is broken, 2 usage.

# The body is markdown. Its backticks are text, not command substitutions.
# shellcheck disable=SC2016
set -euo pipefail

PROG=release-notes
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

#---------------------------------------------------------------------------#
# --next-tag
#---------------------------------------------------------------------------#
if [ "${1:-}" = --next-tag ]; then
  [ "$#" -eq 1 ] || usage
  awk '
    { sub(/\r$/, "") }
    /^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/ {
      split(substr($0, 2), v, ".")
      if (!seen || v[1] + 0 > a || (v[1] + 0 == a && (v[2] + 0 > b || (v[2] + 0 == b && v[3] + 0 > c)))) {
        a = v[1] + 0; b = v[2] + 0; c = v[3] + 0; seen = 1
      }
    }
    END {
      if (seen) printf "v%d.%d.%d\n", a, b, c + 1
      else print "v0.1.0"
    }'
  exit 0
fi

dir="${1:-}"
tag="${2:-}"
meta="${3:-}"
[ -n "$dir" ] && [ -n "$tag" ] && [ "$#" -le 3 ] || usage
[ -d "$dir" ] || die "no asset directory at $dir" "reproduce: ls -l $dir"
[ -z "$meta" ] || [ -d "$meta" ] || die "no meta directory at $meta" "reproduce: ls -l $meta"
need jq sha256sum

arches="${RELEASE_ARCHES:-$("$REPO_ROOT/scripts/ports" list | tr '\n' ' ')}"
# shellcheck disable=SC2086 # one port per word
set -- $arches
[ "$#" -gt 0 ] || die "RELEASE_ARCHES names no port" "reproduce: scripts/ports list"
repo="${GITHUB_REPOSITORY:-pkgforge-dev/docker-archlinux}"

human_size() {
  awk -v b="$1" 'BEGIN { printf "%.1f MiB", b / 1048576 }'
}

#---------------------------------------------------------------------------#
# The rules
#---------------------------------------------------------------------------#
faults=""
fault() { faults="$faults|$1"; }
expected="SHA256SUMS manifest.json"
present=""
left_out=""

for a in "$@"; do
  for f in "pacman-static-$a" "pacman-static-$a.json"; do
    expected="$expected $f"
    [ -f "$dir/$f" ] || fault "$f is missing"
  done
  if [ -f "$dir/pacman-static-$a.json" ]; then
    rc=0
    check_out="$("$REPO_ROOT/scripts/build-pacman-static" --check-evidence "$dir/pacman-static-$a.json" 2>&1)" || rc=$?
    [ "$rc" -eq 0 ] || fault "pacman-static-$a.json is not release evidence: $(printf '%s' "$check_out" | awk 'NR > 1 && !/reproduce:/ { sub(/^ +/, ""); printf "%s; ", $0 }')"
  fi

  rootfs_files="rootfs-$a.tar.gz rootfs-$a.json bootstrap-set-$a.txt oci-$a.tar.gz"
  expected="$expected $rootfs_files"
  if [ -n "$meta" ] && [ -f "$meta/absent-$a.json" ]; then
    for f in $rootfs_files; do
      [ ! -e "$dir/$f" ] || fault "$f is present, and $meta/absent-$a.json says the port has no image"
    done
    left_out="$left_out $a"
  else
    for f in $rootfs_files; do
      [ -f "$dir/$f" ] || fault "$f is missing, and no $meta/absent-$a.json says why"
    done
    present="$present $a"
  fi
done

while IFS= read -r f; do
  [ -n "$f" ] || continue
  case " $expected " in
    *" $f "*) ;;
    *) fault "$f is not an asset of a port in RELEASE_ARCHES ($*)" ;;
  esac
done <<< "$(find "$dir" -mindepth 1 -maxdepth 1 -printf '%f\n' | LC_ALL=C sort)"

if [ -f "$dir/manifest.json" ]; then
  schema="$(jq -r '.schema // "-"' "$dir/manifest.json")"
  [ "$schema" = "docker-archlinux/manifest/1" ] \
    || fault "manifest.json has the schema $schema, scripts/gen-manifest writes docker-archlinux/manifest/1"
else
  fault "manifest.json is missing"
fi

if [ -n "$faults" ]; then
  echo "$PROG: the assets in $dir break the release rules:" >&2
  printf '%s\n' "${faults#|}" | tr '|' '\n' | sed 's/^/  /' >&2
  echo "  ports: $*" >&2
  echo "  reproduce: ls -1 $dir${meta:+ $meta}" >&2
  exit 1
fi

commits="$(for a in "$@"; do jq -r .pacman_commit "$dir/pacman-static-$a.json"; done | LC_ALL=C sort -u)"
n_commits="$(awk 'NF { n++ } END { print n + 0 }' <<< "$commits")"
[ "$n_commits" = 1 ] || die "the binaries come from $n_commits pacman commits: $(printf '%s' "$commits" | tr '\n' ' ')" \
  "one release is one source" \
  "reproduce: jq -r .pacman_commit $dir/pacman-static-*.json"

#---------------------------------------------------------------------------#
# SHA256SUMS: every asset, by its plain file name, sorted. ⛔ Not itself: a
# checksum file that names itself cannot pass its own check.
#---------------------------------------------------------------------------#
sums="$(mktemp)"
(cd "$dir" && find . -mindepth 1 -maxdepth 1 -type f ! -name SHA256SUMS -printf '%f\0' \
  | LC_ALL=C sort -z | xargs -0 sha256sum) > "$sums"
chmod 644 "$sums"
mv -f "$sums" "$dir/SHA256SUMS"
summed="$(awk 'NF { n++ } END { print n + 0 }' "$dir/SHA256SUMS")"
[ "$summed" -gt 0 ] || die "SHA256SUMS is empty" "reproduce: ls -1 $dir"

# sum_of NAME -> the first 16 hex digits of the SHA256SUMS line of NAME
sum_of() {
  awk -v n="$1" '{ f = $2; sub(/^[*]/, "", f) } f == n && !done { print substr($1, 1, 16); done = 1 }' "$dir/SHA256SUMS"
}

first="$1"
ev0="$dir/pacman-static-$first.json"
commit="$commits"
describe="$(jq -r '.pacman_describe_pinned // "-"' "$ev0")"
signed_tag="$(jq -r '.pacman_signed_tag // "-"' "$ev0")"
tag_signer="$(jq -r '.pacman_tag_signer // "-"' "$ev0")"
# The describe value is TAG.rN.gHASH: N commits after the tag.
after="$(printf '%s' "$describe" | awk -F. '{ for (i = 1; i <= NF; i++) if ($i ~ /^r[0-9]+$/) n = substr($i, 2) } END { print n + 0 }')"
# Each present port whose anchor is not the describe value: "ARCH (NAME VERSION)".
other_anchor=""

#---------------------------------------------------------------------------#
# The body
#---------------------------------------------------------------------------#
printf '## %s\n\n' "$tag"
printf 'The release assets of `%s` for these ports: %s.\n\n' "$repo" "$*"
printf '⚠ %s is a version of the tooling and the assets. Images have date tags in a separate namespace.\n\n' "$tag"

if [ -n "$present" ]; then
  cat << 'ROOTS'
### Root filesystems

`rootfs-<arch>.tar.gz` is the filesystem of the published image, as one gzip tar archive. Extract it and chroot into it, or import it with `podman import`.

`oci-<arch>.tar.gz` is the same image with its metadata. Load it with `podman load` on a host with no network.

`bootstrap-set-<arch>.txt` is the resolved package set: `name version sha256`, one line for each package.

`rootfs-<arch>.json` is the evidence file of the image.

ROOTS
  printf '| port | packages | anchor | evidence | rootfs | image | sha256 |\n'
  printf '| --- | --- | --- | --- | --- | --- | --- |\n'
  regenerated=""
  for a in $present; do
    ev="$dir/rootfs-$a.json"
    pkgs="$(jq -r '.package_count' "$ev")"
    [ "$pkgs" -gt 0 ] || die "rootfs-$a.json records no packages" "reproduce: jq .package_count $ev"
    anchor="$(jq -r '.anchor.name + " " + .anchor.version' "$ev")"
    # The anchor version is the describe value and a pkgrel: VALUE-N.
    anchor_version="$(jq -r '.anchor.version // "-"' "$ev")"
    [ "${anchor_version%-*}" = "$describe" ] || other_anchor="${other_anchor:+$other_anchor, }$a ($anchor)"
    source="-"
    if [ -n "$meta" ] && [ -f "$meta/rootfs-$a.json" ]; then
      source="$(jq -r '.evidence // "-"' "$meta/rootfs-$a.json")"
    fi
    case "$source" in
      regenerated) regenerated="$regenerated $a" ;;
    esac
    sum="$(sum_of "rootfs-$a.tar.gz")"
    [ -n "$sum" ] || die "SHA256SUMS has no line for rootfs-$a.tar.gz" "reproduce: cat $dir/SHA256SUMS"
    printf '| %s | %s | %s | %s | %s | %s | %s |\n' \
      "$a" "$pkgs" "$anchor" "$source" \
      "$(human_size "$(stat -c %s "$dir/rootfs-$a.tar.gz")")" \
      "$(human_size "$(stat -c %s "$dir/oci-$a.tar.gz")")" "$sum"
  done
  printf '\n'
  printf 'The evidence column: `status-branch` is the evidence file of the build of the published digest. `regenerated` is an evidence file made again for this release.\n\n'
  if [ -n "$regenerated" ]; then
    printf '⚠ No build evidence for the published digest of:%s. The release job made the evidence again from the current repository databases, without the database snapshot of the build. The source commit and the build time in each such file are the labels of its image.\n\n' "$regenerated"
  fi
fi

if [ -n "$left_out" ]; then
  printf '### Ports left out\n\n'
  printf 'These ports have no published image, so the release has no root filesystem for them.\n\n'
  printf '| port | reason |\n| --- | --- |\n'
  for a in $left_out; do
    printf '| %s | %s |\n' "$a" "$(jq -r '.reason // "-"' "$meta/absent-$a.json")"
  done
  printf '\n'
fi

mtags="$(jq -r '.tag_count' "$dir/manifest.json")"
mres="$(jq -r '.resolved_count' "$dir/manifest.json")"
mimg="$(jq -r '.image' "$dir/manifest.json")"
printf '### Every published tag\n\n'
printf '`manifest.json` lists each tag of `%s` with its digest, its platforms and its anchor, as the registry gave them: %s tags, %s with a digest. The newest release always has it at this URL:\n\n' \
  "$mimg" "$mtags" "$mres"
printf '```bash\n'
printf 'curl -sSfL --connect-timeout 15 --max-time 120 \\\n'
printf '  https://github.com/%s/releases/latest/download/manifest.json \\\n' "$repo"
printf '  | jq -r %s\n' "'.tags[] | select(.anchor) | \"\\(.tag) \\(.digest)\"'"
printf '```\n\n'

printf '### Static pacman\n\n'
printf 'One statically linked pacman for each port. The binary names no dynamic loader, so it runs on a system with no libc or a broken libc.\n\n'
printf 'The source is pacman commit `%s`, describe `%s`.' "$commit" "$describe"
# ⛔ The claim only when each image of the release has that pacman. The
# anchors come from the files. The pin can be older than the pacman of a port.
if [ -n "$present" ] && [ -z "$other_anchor" ]; then
  printf ' The anchor tags of the images end in the same describe value.'
fi
printf '\n'
if [ -n "$other_anchor" ]; then
  printf '⚠ These images have another pacman than the static binaries: %s.\n' "$other_anchor"
fi
if [ "$signed_tag" != "-" ] && [ "$tag_signer" != "-" ]; then
  printf 'The build checked the signature of the tag `%s`: %s signed it.' "$signed_tag" "$tag_signer"
  if [ "$after" -gt 0 ]; then
    printf ' ⚠ The signature covers the tagged commit. The pinned commit is %s commits after it, and the commit sha covers those.' "$after"
  fi
  printf '\n'
fi
printf '\n| asset | machine | size | ran as | sha256 |\n| --- | --- | --- | --- | --- |\n'
for a in "$@"; do
  jq -r --arg n "pacman-static-$a" \
    '"| \($n) | \(.elf_machine) | \(.size) | \(.reported_version) | \(.sha256[0:16]) |"' \
    "$dir/pacman-static-$a.json"
done
printf '\n'

printf '### Check the assets\n\n'
printf 'Set ARCH to a port of this release.\n\n'
printf '```bash\n'
printf 'ARCH=%s\n' "$first"
printf 'sha256sum -c SHA256SUMS\n'
printf 'readelf -lW "pacman-static-$ARCH" | awk %s\n' "'/INTERP/ { n++ } END { print n + 0 }'"
printf '```\n\n'
printf 'The INTERP count of a static binary is 0.\n\n'
cat << 'TAIL'
### Build the static pacman

```bash
scripts/build-pacman-static "$ARCH"
```

`bootstrap/pacman-static/sources.pin` pins each input by sha256 or by commit. docs/bootstrap-with-pacman-static.md builds an Arch root with the binary on a host that has no pacman.

### Source

pacman is GPL-2.0-or-later. The release does not carry the source tarballs. `bootstrap/pacman-static/sources.pin` names each input by URL and sha256. `scripts/build-pacman-static --fetch` downloads each one and checks its sha256.

TAIL

printf -- '- Static pacman binaries: %s. Each ran under the emulator of its port before the upload.\n' "$#"
n_present="$(printf '%s\n' "$present" | awk '{ n += NF } END { print n + 0 }')"
printf -- '- Root filesystems: %s. Each image passed the image suite in the job that exported it.\n' "$n_present"
printf -- '- Files in SHA256SUMS: %s.\n\n' "$summed"
printf '⚠ A binary for an architecture other than the runner ran under qemu-user: no target kernel and no target page size.\n'
