#!/usr/bin/env bash
#
# Decide, for each mirror list of one port, whether the build stage reads the
# first server of that list.
#
#   scripts/check-mirror-lag ARCH
#
# stdout, for each list that rootfs/ARCH/etc/pacman.conf includes, in the
# order of pacman.conf: one keep line, or one drop line for each server that
# the list loses.
#   keep LIST           the build reads the list as it is
#   drop LIST SERVER    the build reads the list without SERVER
# LIST is the file name (mirrorlist, mirrorlist-any). SERVER is the first
# server of the list, or a later server that serves the same files.
# stderr: the times of each database, and each reason.
#
# A repository database is a tar archive with one directory per package. Each
# member keeps the time its package went into the repository. A mirror serves
# the database file of upstream byte for byte, so the times compare directly.
#
# A later server serves the same files as the first server in two cases: it
# has the same value, or both are paths to the GHCR mirror (GHCR_MATCH). With
# TRANSPORT=oci, each list has two paths to the GHCR mirror: the oci:// path
# and the Worker path.
#
# For each repository that reads the list, the newest member on the first
# server is compared with a reference:
#   1. The next server in the same list that serves a readable database and
#      does not serve the same files as the first server.
#   2. When no later server answers and the first server is the GHCR mirror:
#      the record of the mirror, MIRROR_STATUS_URL, the target
#      <pacman_arch>-<repo>, the field lag_seconds.
#
# The first server is dropped when, for one repository of the list:
#   - its newest member is older than the reference by more than MIRROR_LAG_MAX,
#   - it serves no readable database, and a later server does, or
#   - the record of the mirror gives lag_seconds above MIRROR_LAG_MAX.
# ⭐ A drop removes the first server and each later server that serves the
# same files, as one decision. Else the build reads the same old files
# through the next path.
# ⚠ With no reference, the first server stays, and a warning names the reason.
# A list stays when a drop leaves it with no server.
#
# Environment:
#   MIRROR_LAG_MAX         seconds, default 43200
#   MIRROR_STATUS_URL      default https://pkgforge-dev.github.io/mirror-archlinux/status.json,
#                          file:// works
#   MIRROR_STATUS_MAX_AGE  seconds, default MIRROR_LAG_MAX: an older record is
#                          not used
#   TRANSPORT              worker or oci, the value the build gets
# and the paths that scripts/lib-mirrors.sh reads.
#
# Exit status: 0 a line for every list is on stdout, 1 an input cannot be read.
set -euo pipefail

PROG=check-mirror-lag
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
# shellcheck source=scripts/lib-mirrors.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib-mirrors.sh"

MAX_LAG="${MIRROR_LAG_MAX:-43200}"
STATUS_URL="${MIRROR_STATUS_URL:-https://pkgforge-dev.github.io/mirror-archlinux/status.json}"
STATUS_MAX_AGE="${MIRROR_STATUS_MAX_AGE:-$MAX_LAG}"

case "$MAX_LAG" in
  '' | *[!0-9]*) die "MIRROR_LAG_MAX is '$MAX_LAG'. Use a whole number of seconds." ;;
esac
case "$STATUS_MAX_AGE" in
  '' | *[!0-9]*) die "MIRROR_STATUS_MAX_AGE is '$STATUS_MAX_AGE'. Use a whole number of seconds." ;;
esac

[ "$#" -eq 1 ] || die "usage: scripts/check-mirror-lag ARCH" "ARCH is one of: $(port_list | tr '\n' ' ')"
arch="$1"
port_check "$arch"
need curl tar awk timeout od date

parch="$(port_get "$arch" pacman_arch)"
lists="$(port_lists "$arch")"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# newest SERVER REPO -> the newest member of the database, "YYYY-MM-DD HH:MM:SS"
newest() {
  local url
  url="$(server_url "$1" "$2" "$parch")/$2.db"
  if ! fetch_db "$url" "$work/db"; then
    note "cannot read $url: $FETCH_WHY"
    return 1
  fi
  if ! db_open "$work/db"; then
    note "$url: $DB_WHY"
    return 1
  fi
  db_newest
}

#---------------------------------------------------------------------------#
# The record of the GHCR mirror, read once
#---------------------------------------------------------------------------#
STATUS_STATE=""
STATUS_WHY=""
status_load() {
  [ -z "$STATUS_STATE" ] || return 0
  STATUS_STATE=bad
  local rc=0 said schema gen age
  if ! command -v jq > /dev/null; then
    STATUS_WHY="jq is not on PATH"
    return 0
  fi
  said="$(timeout -k 5 70 curl -sSfL -A "$HTTP_UA" --connect-timeout 15 --max-time 60 \
    --retry 2 --retry-delay 3 -o "$work/status.json" "$STATUS_URL" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    STATUS_WHY="cannot read $STATUS_URL: $(first_line "$said") (curl exit $rc)"
    return 0
  fi
  schema="$(jq -r '.schema // empty' "$work/status.json" 2> "$work/jq.err")" || {
    STATUS_WHY="$STATUS_URL is not JSON: $(first_line "$(cat "$work/jq.err")")"
    return 0
  }
  if [ "$schema" != 1 ]; then
    STATUS_WHY="$STATUS_URL has schema '${schema:-none}', and this script reads schema 1"
    return 0
  fi
  gen="$(jq -r '.generated_epoch // empty' "$work/status.json")"
  case "$gen" in
    '' | *[!0-9]*)
      STATUS_WHY="$STATUS_URL has no generated_epoch"
      return 0
      ;;
  esac
  age=$(($(date -u +%s) - gen))
  if [ "$age" -gt "$STATUS_MAX_AGE" ]; then
    STATUS_WHY="the record at $STATUS_URL is ${age}s old, and the limit is ${STATUS_MAX_AGE}s (MIRROR_STATUS_MAX_AGE)"
    return 0
  fi
  STATUS_STATE=good
}

# status_lag REPO -> lag_seconds of <pacman_arch>-REPO. On 1, the reason is on stderr.
status_lag() {
  local target="$parch-$1" v
  v="$(jq -r --arg t "$target" '
    [ .targets[]? | select(.target == $t) ]
    | if length == 1 then (.[0].lag_seconds | tostring) else "absent:" + (length | tostring) end' \
    "$work/status.json")"
  case "$v" in
    absent:0)
      warn "$STATUS_URL has no target $target"
      return 1
      ;;
    absent:*)
      warn "$STATUS_URL has the target $target ${v#absent:} times"
      return 1
      ;;
    '' | *[!0-9]*)
      warn "$STATUS_URL gives lag_seconds '$v' for $target, which is not a number"
      return 1
      ;;
  esac
  printf '%s\n' "$v"
}

# same_files FIRST SERVER -> 0 when SERVER serves the same files as FIRST
same_files() {
  [ "$1" = "$2" ] || { is_ghcr "$1" && is_ghcr "$2"; }
}

#---------------------------------------------------------------------------#
# One verdict per list
#---------------------------------------------------------------------------#
while IFS= read -r line; do
  [ -n "$line" ] || continue
  list="${line%% *}"
  repos="${line#* }"
  servers_of "$arch" "$list" judge
  if [ "${#SERVERS[@]}" -eq 0 ]; then
    note "$list: no server, so the list stays"
    echo "keep $list"
    continue
  fi
  first="${SERVERS[0]}"

  # The servers a drop removes, each value once, in list order. drop-server
  # removes every line with that value, and refuses a value it cannot find.
  drops=()
  declare -A named=()
  left=0
  for s in "${SERVERS[@]}"; do
    if ! same_files "$first" "$s"; then
      left=$((left + 1))
    elif [ -z "${named[$s]+set}" ]; then
      named[$s]=1
      drops+=("$s")
    fi
  done
  unset named
  if [ "$left" -eq 0 ]; then
    note "$list: each of its ${#SERVERS[@]} server(s) serves the same files as $first, so the first stays"
    echo "keep $list"
    continue
  fi

  drop=0
  for repo in $repos; do
    first_stamp="$(newest "$first" "$repo")" || first_stamp=""

    ref=""
    ref_stamp=""
    for s in "${SERVERS[@]:1}"; do
      if same_files "$first" "$s"; then
        note "$list [$repo]: $s serves the same files as $first, so it is not a reference"
        continue
      fi
      if ref_stamp="$(newest "$s" "$repo")"; then
        ref="$s"
        break
      fi
    done

    if [ -n "$ref" ]; then
      if [ -z "$first_stamp" ]; then
        note "$list [$repo]: $first serves no readable database, and $ref does"
        drop=1
        continue
      fi
      lag=$(($(date -u -d "$ref_stamp" +%s) - $(date -u -d "$first_stamp" +%s)))
      note "$list [$repo]: newest member $first_stamp on $first, $ref_stamp on $ref: behind by ${lag}s"
      if [ "$lag" -gt "$MAX_LAG" ]; then
        note "$list [$repo]: $first is behind by more than ${MAX_LAG}s"
        drop=1
      fi
      continue
    fi

    # No later server answered.
    if ! is_ghcr "$first"; then
      warn "$list [$repo]: no server after $first serves a readable database. There is no reference, so it stays."
      continue
    fi
    status_load
    if [ "$STATUS_STATE" != good ]; then
      warn "$list [$repo]: no later server answered, and the record of the GHCR mirror is not usable: $STATUS_WHY. $first stays."
      continue
    fi
    lag="$(status_lag "$repo")" || {
      warn "$list [$repo]: no later server answered, and the record of the GHCR mirror has no usable entry. $first stays."
      continue
    }
    note "$list [$repo]: no later server answered. The record of the GHCR mirror gives lag_seconds $lag for $parch-$repo."
    if [ "$lag" -gt "$MAX_LAG" ]; then
      note "$list [$repo]: the GHCR mirror is behind by more than ${MAX_LAG}s"
      drop=1
    fi
  done

  if [ "$drop" -eq 1 ]; then
    for s in "${drops[@]}"; do
      printf 'drop %s %s\n' "$list" "$s"
    done
  else
    printf 'keep %s\n' "$list"
  fi
done <<< "$lists"
