#!/usr/bin/env bash
#
# Check every container image pinned by digest in this repository against the
# tag it was cut from.
#
#   scripts/check-image-pins            report only
#   scripts/check-image-pins --apply    rewrite each stale digest in place
#
# Dependabot watches the docker ecosystem, which means Dockerfiles. It does not
# read a `docker run image@sha256:...` inside a workflow step, so those pins
# have no watcher at all. This is that watcher, and it covers the Dockerfile too
# rather than assuming Dependabot got there first.
#
# The tag each digest belongs to is read from the comment beside it, so the pin
# stays self describing:
#
#   docker.io/library/archlinux@sha256:...   # tag: latest
#
# Exit status is the result:
#   0  every pin matches the digest its tag resolves to
#   3  at least one pin is behind
#   1  the check itself could not run
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# die MESSAGE [ACTION ...]
#
# The first argument says what is wrong. Every argument after it is printed
# indented below it, and is what the reader does next. A message with no
# next step leaves the reader to work it out from the source.
die() {
  echo "check-image-pins: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

need() {
  command -v "$1" >/dev/null || die "$1 is required"
}
need curl
need jq
need awk

apply=0
case "${1:-}" in
  "") ;;
  --apply) apply=1 ;;
  *) die "usage: check-image-pins [--apply]" ;;
esac

ACCEPT='application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json'

# resolve REGISTRY REPO TAG -> the digest that tag points at, or empty
resolve() {
  local registry="$1" repo="$2" tag="$3" auth token realm service
  case "$registry" in
    docker.io | registry-1.docker.io)
      realm="https://auth.docker.io/token"; service="registry.docker.io"
      registry="registry-1.docker.io"
      ;;
    ghcr.io)
      realm="https://ghcr.io/token"; service="ghcr.io"
      ;;
    *)
      echo "check-image-pins: no anonymous token flow known for $registry" >&2
      return 1
      ;;
  esac
  token="$(curl -sS --connect-timeout 15 --max-time 60 \
    "$realm?service=$service&scope=repository:$repo:pull" | jq -r '.token // .access_token // empty')"
  [ -n "$token" ] || { echo "check-image-pins: no pull token for $repo" >&2; return 1; }

  auth="$(curl -sS -o /dev/null -D - --connect-timeout 15 --max-time 60 \
    -H "Authorization: Bearer $token" -H "Accept: $ACCEPT" \
    "https://$registry/v2/$repo/manifests/$tag")" || return 1
  printf '%s\n' "$auth" | tr -d '\r' | awk 'tolower($1) == "docker-content-digest:" { print $2; exit }'
}

# pins_in FILE -> "<lineno>:<text>" per pinned image, empty when there are none
#
# A file with no pin is normal. grep exits 1 for that, and exits 2 when it could
# not read the file at all. Those two must not look the same.
pins_in() {
  local out rc=0
  out="$(grep -nE '@sha256:[0-9a-f]{64}' "$1")" || rc=$?
  case "$rc" in
    0) printf '%s\n' "$out" ;;
    1) ;;
    *) die "grep exited $rc scanning $1" ;;
  esac
}

#---------------------------------------------------------------------------#
# Find every pin. The tag comes from a "# tag: <name>" comment near the line.
#---------------------------------------------------------------------------#
files="$REPO_ROOT/Dockerfile
$(find "$REPO_ROOT/.github/workflows" -type f -name '*.yml' | sort)"

found=0
stale=0
while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ -f "$file" ] || continue
  rel="${file#"$REPO_ROOT/"}"

  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    lineno="${hit%%:*}"
    text="${hit#*:}"
    # awk, not grep -o piped into head. grep -o exits 1 when nothing matches and
    # head closing the pipe makes it take SIGPIPE, and pipefail turns either into
    # a script that stops with no message. A line with no pin is a normal result.
    ref="$(printf '%s\n' "$text" \
      | awk 'match($0, /[a-z0-9][a-z0-9._\/-]*@sha256:[0-9a-f]{64}/) {
               print substr($0, RSTART, RLENGTH) }')"
    [ -n "$ref" ] || continue
    name="${ref%@*}"
    have="${ref#*@}"
    # The marker may sit on the pin's own line, or on one of the three lines
    # above it. A Dockerfile instruction takes no trailing comment, and a pin
    # inside a shell line continuation cannot take one either.
    tag="$(awk -v ln="$lineno" 'NR >= ln - 3 && NR <= ln {
             if (match($0, /# *tag: *[A-Za-z0-9._-]+/)) {
               s = substr($0, RSTART, RLENGTH); sub(/# *tag: */, "", s); t = s
             }
           } END { print t }' "$file")"
    if [ -z "$tag" ]; then
      echo "check-image-pins: $rel:$lineno pins $name with no '# tag:' comment, so it cannot be checked" >&2
      die "every digest pin needs a '# tag: <name>' comment naming what it was cut from"
    fi

    registry="docker.io"
    repo="$name"
    case "$name" in
      */*/*) registry="${name%%/*}"; repo="${name#*/}" ;;
      */*)   case "${name%%/*}" in *.*|localhost) registry="${name%%/*}"; repo="${name#*/}" ;; esac ;;
    esac
    case "$registry" in docker.io) case "$repo" in */*) ;; *) repo="library/$repo" ;; esac ;; esac

    found=$((found + 1))
    want="$(resolve "$registry" "$repo" "$tag")" || die "cannot resolve $name:$tag"
    [ -n "$want" ] || die "$registry returned no digest for $repo:$tag"

    if [ "$want" = "$have" ]; then
      echo "current  $rel:$lineno  $name:$tag"
    else
      stale=$((stale + 1))
      echo "BEHIND   $rel:$lineno  $name:$tag"
      echo "  pinned: $have"
      echo "  tag now: $want"
      if [ "$apply" -eq 1 ]; then
        tmp="$(mktemp)"
        # index() and substr() rather than gsub(), because gsub takes a regex
        # and the replacement text is interpreted for & and backslashes. A
        # digest is a literal and must be treated as one.
        awk -v ln="$lineno" -v old="$have" -v new="$want" '
          NR == ln {
            p = index($0, old)
            if (p > 0) { $0 = substr($0, 1, p - 1) new substr($0, p + length(old)) }
          }
          { print }' "$file" > "$tmp"
        if grep -qF "$want" "$tmp"; then
          # The file is replaced in one step, so an interrupted run cannot
          # leave a half written pin behind.
          mv "$tmp" "$file"
          echo "  applied"
        else
          rm -f "$tmp"
          die "rewriting $rel:$lineno did not take, the digest is unchanged" \
            "nothing was written, so the file is untouched" \
            "edit it by hand: on $rel line $lineno, replace $have with $want"
        fi
      fi
    fi
    # grep exits 1 when a file holds no pin, which is a normal result here, so
    # the pattern is matched through a helper that separates "nothing matched"
    # from "the scan did not run".
  done < <(pins_in "$file")
done <<< "$files"

[ "$found" -gt 0 ] || die "no digest pinned image found, which means this check is not looking where the pins are"

echo "checked $found pinned image(s), $stale behind"

if [ -n "${GITHUB_OUTPUT:-}" ]; then
  printf 'found=%s\nstale=%s\n' "$found" "$stale" >> "$GITHUB_OUTPUT"
fi

[ "$stale" -eq 0 ] || exit 3
