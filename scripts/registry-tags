#!/usr/bin/env bash
#
# Print every tag of a repository on an OCI registry, one per line.
#
#   scripts/registry-tags REGISTRY REPOSITORY
#   scripts/registry-tags ghcr.io pkgforge-dev/archlinux
#   scripts/registry-tags docker.io pkgforge/archlinux
#
# A thin command over reg_tags in scripts/lib.sh. It reads every page through
# the Link header, and it refuses a page that is not a tag list of
# REPOSITORY. The read is anonymous unless REG_USER_<registry> and
# REG_PASS_<registry> are set (scripts/lib.sh).
#
# Exit status: 0 the list is complete (empty for a repository that does not
# exist), 1 the list cannot be read, 2 usage.
set -euo pipefail

PROG="registry-tags"
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

if [ "$#" -ne 2 ] || [ -z "$1" ] || [ -z "$2" ]; then
  echo "usage: registry-tags REGISTRY REPOSITORY" >&2
  exit 2
fi
need curl jq awk

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

reg_tags "$1" "$2" "$work/tags" || die "the tag list of $2 on $1 cannot be read" \
  "the reason is above" \
  "reproduce: scripts/registry-tags $1 $2"

awk 'NF && !seen[$0]++' "$work/tags"
note "$(awk 'NF && !seen[$0]++ { n++ } END { print n + 0 }' "$work/tags") tag(s) from $1/$2"
