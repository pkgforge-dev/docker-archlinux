qemu-sparc64 \x7fELF\x02\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x2b \xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff
qemu-x86_64 \x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00 \xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff
qemu-xtensa \x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x5e\x00 \xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff
qemu-xtensaeb \x7fELF\x01\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x5e \xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff'

usage() {
  sed -n '6,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

# What to edit for an emulator that the table does not have.
FIX_TABLE="add its NAME, magic and mask from qemu's scripts/qemu-binfmt-conf.sh to TABLE in scripts/binfmt-register and to tests/fixtures/64-plan-build/binfmt.tsv"

# line_for NAME -> the registration line for /register, or nothing
line_for() {
  awk -v n="$1" '$1 == n {
      printf ":%s:M::%s:%s:/usr/bin/%s-static:F\n", $1, $2, $3, $1
    }' <<< "$TABLE"
}

# AS_ROOT: the prefix that runs a command as root.
AS_ROOT=()
if [ "$(id -u)" -ne 0 ]; then
  AS_ROOT=(sudo -n)
fi

# registered NAME -> 0 when NAME is enabled and has the F flag
registered() {
  local f="$BINFMT_DIR/$1"
  [ -f "$f" ] || return 1
  awk '$1 == "enabled" { e = 1 } $1 == "flags:" && $2 ~ /F/ { f = 1 } END { exit (e && f) ? 0 : 1 }' "$f"
}

# show NAME -> the registration, on stderr
show() {
  if [ -f "$BINFMT_DIR/$1" ]; then
    sed "s/^/  $1: /" "$BINFMT_DIR/$1" >&2
  else
    echo "  $1: not registered; registered: $(find "$BINFMT_DIR" -mindepth 1 -maxdepth 1 -name 'qemu-*' -printf '%f ')" >&2
  fi
}

# unregister NAME -> remove the registration of NAME when there is one
unregister() {
  [ -f "$BINFMT_DIR/$1" ] || return 0
  # shellcheck disable=SC2016 # $1 is for the inner sh
  "${AS_ROOT[@]}" sh -c 'printf "%s" -1 > "$1"' sh "$BINFMT_DIR/$1"
}

src_tonistiigi() {
  local platform="$1" name
  need docker timeout
  # tonistiigi/binfmt takes the architecture of the platform: linux/arm/v7
  # is arm, linux/loong64 is loong64.
  name="${platform#linux/}"
  name="${name%%/*}"
  timeout -k 5 300 docker run --rm --privileged "$TONISTIIGI_IMAGE" --install "$name"
}

src_multiarch() {
  need docker timeout
  timeout -k 5 300 docker run --rm --privileged "$MULTIARCH_IMAGE" --reset -p yes
}

src_ubuntu() {
  local qemu="$1" line
  line="$(line_for "$qemu")"
  [ -n "$line" ] || {
    warn "the fallback table has no entry for $qemu; $FIX_TABLE"
    return 1
  }
  need timeout
  if [ ! -x "/usr/bin/$qemu-static" ]; then
    need apt-get
    timeout -k 5 300 "${AS_ROOT[@]}" apt-get -o Acquire::Retries=3 update
    timeout -k 5 600 "${AS_ROOT[@]}" env DEBIAN_FRONTEND=noninteractive \
      apt-get -o Acquire::Retries=3 install -y --no-install-recommends qemu-user-static
  fi
  [ -x "/usr/bin/$qemu-static" ] || {
    warn "/usr/bin/$qemu-static is not there after the install"
    return 1
  }
  # The package can register NAME itself, with other flags. Ours replaces it.
  unregister "$qemu"
  # shellcheck disable=SC2016 # $1 and $2 are for the inner sh
  "${AS_ROOT[@]}" sh -c 'printf "%s" "$1" > "$2"' sh "$line" "$BINFMT_DIR/register"
}

case "${1:-}" in
  --table)
    [ "$#" -eq 1 ] || usage
    printf '%s\n' "$TABLE"
    exit 0
    ;;
  --line)
    [ "$#" -eq 2 ] || usage
    qemu="$("$PORTS" get "$2" qemu)"
    line="$(line_for "$qemu")"
    [ -n "$line" ] || die "the fallback table has no entry for $qemu, the emulator of $2" "$FIX_TABLE"
    printf '%s\n' "$line"
    exit 0
    ;;
  "" | -*) usage ;;
esac
[ "$#" -eq 1 ] || usage
arch="$1"

kind="$("$PORTS" get "$arch" binfmt)"
qemu="$("$PORTS" get "$arch" qemu)"
platform="$("$PORTS" get "$arch" platform)"

if [ "$kind" = native ]; then
  note "$arch runs on the runner, no emulator is needed"
  exit 0
fi

case "$kind" in
  tonistiigi) sources="tonistiigi multiarch ubuntu" ;;
  multiarch) sources="multiarch ubuntu" ;;
  ubuntu) sources="ubuntu" ;;
  *) die "ports/$arch.conf has binfmt = $kind, which this script does not know" ;;
esac
sources="${BINFMT_SOURCES-$sources}"

[ -d "$BINFMT_DIR" ] || die "$BINFMT_DIR is not there" \
  "mount it: sudo mount -t binfmt_misc binfmt_misc $BINFMT_DIR"

if registered "$qemu"; then
  note "$qemu is already registered with the F flag"
  show "$qemu"
  exit 0
fi

for s in $sources; do
  rc=0
  case "$s" in
    tonistiigi) src_tonistiigi "$platform" || rc=$? ;;
    multiarch) src_multiarch || rc=$? ;;
    ubuntu) src_ubuntu "$qemu" || rc=$? ;;
    *) die "BINFMT_SOURCES names '$s'; the sources are tonistiigi, multiarch and ubuntu" ;;
  esac
  if [ "$rc" -eq 0 ] && registered "$qemu"; then
    note "$qemu is registered with the F flag, from $s"
    show "$qemu"
    exit 0
  fi
  warn "$s did not register $qemu with the F flag (exit $rc)"
  show "$qemu"
done

fallback=""
[ -n "$(line_for "$qemu")" ] || fallback="the fallback table has no entry for $qemu: $FIX_TABLE"
die "no source registered $qemu for $arch: tried $sources" \
  "the build cannot run a $platform binary without it" \
  ${fallback:+"$fallback"} \
  "reproduce: scripts/binfmt-register $arch; cat $BINFMT_DIR/$qemu"
