#!/usr/bin/env bash
#
# Print how many days of silence the schedule of one workflow allows.
#
#   scripts/cron-tolerance .github/workflows/build-deploy.yml
#   scripts/cron-tolerance --minutes .github/workflows/status.yml
#
# The output is two integers on one line: the largest gap in days that the
# schedule makes, and the tolerance.
#
#   1 3      a daily cron: the gap is one day, and three silent days is a stop
#
# With --minutes the output is one integer: the largest gap in minutes between
# two firings. The status site shows the age of an image against it.
#
#   180      '17 */3 * * *'
#   1440     '41 7 * * *'
#
# ⭐ The number comes from the cron that the workflow carries. When a person
# changes the cron, the tolerance changes with it, with no edit here.
#
# tolerance = gap + min(gap, 7) + 1. The extra day is for a run that GitHub
# starts late.
#   gap up to 7 days  one missed firing is a transient, two missed firings in
#                     a row is a stop: daily 3, weekly 15
#   gap above 7 days  one missed firing and 7 more days is a stop: the 1st of
#                     each month gives 39, not two missed months
#
# ⛔ A tolerance above 60 days is refused (exit 1). GitHub stops the schedules
# of a repository after 60 days with no activity. A check that waits longer
# than that cannot report a stop in time. Give such a workflow a cron
# that fires at least every 52 days.
#
# ⚠ This reads the calendar, not GitHub. A daily cron has a gap of 1 whether
# or not GitHub runs it. The callers measure the runs against this number.
#
# ⛔ The tolerance has day resolution. The hour and minute fields are read and
# not used for it, because a dated tag carries only a date. GitHub delays a
# scheduled run by hours, and hours do not move a date by more than one day.
#
# ⚠ A sub-daily cron gets the tolerance of a daily cron. '0 */6 * * *' gets
# three days. The check still sees a stop, later than it could.
#
# Exit status:
#   0  the tolerance was printed
#   1  the cron could not be read
set -euo pipefail

die() {
  echo "cron-tolerance: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

mode=days
if [ "${1:-}" = --minutes ]; then
  mode=minutes
  shift
fi
wf="${1:-}"
[ -n "$wf" ] || die "usage: cron-tolerance [--minutes] <workflow file>"
[ -f "$wf" ] || die "no such file: $wf" \
  "reproduce: ls .github/workflows/"

#---------------------------------------------------------------------------#
# The cron expressions. A workflow can have more than one, and the firing of
# any one counts, so all of them are read together. Quotes and a trailing
# comment are removed.
#---------------------------------------------------------------------------#
crons="$(awk '
  /^[[:space:]]*-[[:space:]]*cron:/ {
    sub(/^[^:]*:[[:space:]]*/, "")
    # A trailing comment. A cron expression has no # in it.
    sub(/[[:space:]]*#.*$/, "")
    gsub(/^["'"'"']|["'"'"']$/, "")
    sub(/[[:space:]]+$/, "")
    if (length($0) > 0) print
  }' "$wf")"

if [ -z "$crons" ]; then
  die "no cron expression in $wf" \
    "a workflow with no schedule has no tolerance" \
    "reproduce: grep -n 'cron:' $wf"
fi

#---------------------------------------------------------------------------#
# The walk: 1461 days from 2024-01-01 (a Monday), which is 2024 to 2027 and
# one full leap cycle. The answer depends on the schedule only, not on the day
# of the run. A cron that names 29 February is measured, not estimated.
#
# ⚠ The silence after the last firing in the window counts too. Without it, a
# cron that fires once early in the window gives a gap that is too small. The
# check then fails on a schedule that works.
#
# ⛔ No strftime, no mktime and no third argument to match(). They are gawk
# extensions, and mawk does not have them.
#
# With --minutes the walk also makes the list of firing minutes of each day.
# The hour and minute fields do not depend on the day, so each set of crons
# that fire on one day gives one sorted list. The gap from the last firing
# back to the first firing of the window counts too.
#---------------------------------------------------------------------------#
read -r gap tolerance <<< "$(awk -v crons="$crons" -v mode="$mode" '
  function leap(y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }

  function mdays(y, m) {
    if (m == 2) return leap(y) ? 29 : 28
    if (m == 4 || m == 6 || m == 9 || m == 11) return 30
    return 31
  }

  # A cron field name as its number. GitHub documents numbers, and most cron
  # programs also accept the names.
  function tonum(t,   i) {
    t = tolower(t)
    for (i in NAMES) if (i == t) return NAMES[i]
    return t + 0
  }

  # One comma separated field against one value.
  #
  # "*" is every value. "a-b" is a range. "a" is one value. A "/n" suffix
  # steps from the low end. A bare "a/n" means "a-max/n", as in cron programs.
  function field(spec, val, lo_lim, hi_lim,   n, parts, i, p, step, lo, hi, sl) {
    n = split(spec, parts, ",")
    for (i = 1; i <= n; i++) {
      p = parts[i]
      step = 1
      sl = index(p, "/")
      if (sl > 0) {
        step = substr(p, sl + 1) + 0
        p = substr(p, 1, sl - 1)
        if (step < 1) return -1
      }
      if (p == "*") {
        lo = lo_lim; hi = hi_lim
      } else if (index(p, "-") > 0) {
        lo = tonum(substr(p, 1, index(p, "-") - 1))
        hi = tonum(substr(p, index(p, "-") + 1))
      } else {
        lo = tonum(p)
        hi = (sl > 0) ? hi_lim : lo
      }
      if (lo < lo_lim || hi > hi_lim || lo > hi) return -1
      if (val >= lo && val <= hi && (val - lo) % step == 0) return 1
    }
    return 0
  }

  # ⛔ When both day of month and day of week are restricted, either one
  # matching is a firing. When one of them is "*", both must match. That is the
  # POSIX rule.
  #
  # ⚠ Sunday is 0, and many cron programs also accept 7 for Sunday. The field
  # takes 0 to 7, and Sunday is tested as both.
  function fires(expr, mon, dom, dow,   f, nf, a, b) {
    nf = split(expr, f, /[[:space:]]+/)
    if (nf != 5) return -1
    if (field(f[4], mon, 1, 12) != 1) return 0
    a = field(f[3], dom, 1, 31)
    b = field(f[5], dow, 0, 7)
    if (b == 0 && dow == 0) b = field(f[5], 7, 0, 7)
    if (a < 0 || b < 0) return -1
    if (f[3] == "*" && f[5] == "*") return 1
    if (f[3] == "*") return b
    if (f[5] == "*") return a
    return (a || b) ? 1 : 0
  }

  BEGIN {
    NAMES["jan"] = 1;  NAMES["feb"] = 2;  NAMES["mar"] = 3;  NAMES["apr"] = 4
    NAMES["may"] = 5;  NAMES["jun"] = 6;  NAMES["jul"] = 7;  NAMES["aug"] = 8
    NAMES["sep"] = 9;  NAMES["oct"] = 10; NAMES["nov"] = 11; NAMES["dec"] = 12
    NAMES["sun"] = 0;  NAMES["mon"] = 1;  NAMES["tue"] = 2;  NAMES["wed"] = 3
    NAMES["thu"] = 4;  NAMES["fri"] = 5;  NAMES["sat"] = 6

    nc = split(crons, list, "\n")

    # The minutes of the day each cron fires at, ascending.
    for (i = 1; i <= nc; i++) {
      if (split(list[i], f, /[[:space:]]+/) != 5) {
        printf "cron-tolerance: cannot parse cron expression: %s\n", list[i] > "/dev/stderr"
        exit 2
      }
      cnt[i] = 0
      for (h = 0; h < 24; h++) {
        a = field(f[2], h, 0, 23)
        for (mm = 0; mm < 60; mm++) {
          b = field(f[1], mm, 0, 59)
          if (a < 0 || b < 0) {
            printf "cron-tolerance: cannot parse cron expression: %s\n", list[i] > "/dev/stderr"
            exit 2
          }
          if (a == 1 && b == 1) mins[i, ++cnt[i]] = h * 60 + mm
        }
      }
      if (cnt[i] == 0) {
        printf "cron-tolerance: the cron expression fires at no minute of the day: %s\n", list[i] > "/dev/stderr"
        exit 2
      }
    }

    y = 2024; m = 1; d = 1; dow = 1        # 2024-01-01 is a Monday
    run = 0; gap = 0; fired = 0
    mgap = 0; mlast = -1; mfirst = -1

    for (day = 0; day < 1461; day++) {
      hit = 0
      key = ""
      for (i = 1; i <= nc; i++) {
        r = fires(list[i], m, d, dow)
        if (r < 0) {
          printf "cron-tolerance: cannot parse cron expression: %s\n", list[i] > "/dev/stderr"
          exit 2
        }
        if (r == 1) { hit = 1; key = key " " i }
      }
      if (hit) {
        fired++
        if (run > gap) gap = run
        run = 0
      } else {
        run++
      }

      if (hit && mode == "minutes") {
        if (!(key in daylist)) {
          split("", mark)
          nk = split(key, ks, " ")
          for (j = 1; j <= nk; j++)
            for (k = 1; k <= cnt[ks[j]]; k++) mark[mins[ks[j], k]] = 1
          s = ""
          for (t = 0; t < 1440; t++) if (t in mark) s = s " " t
          daylist[key] = s
        }
        nt = split(daylist[key], ts, " ")
        for (j = 1; j <= nt; j++) {
          abs = day * 1440 + ts[j]
          if (mlast >= 0 && abs - mlast > mgap) mgap = abs - mlast
          if (mfirst < 0) mfirst = abs
          mlast = abs
        }
      }

      d++
      if (d > mdays(y, m)) { d = 1; m++ }
      if (m > 12) { m = 1; y++ }
      dow = (dow + 1) % 7
    }

    if (fired == 0) {
      print "cron-tolerance: the schedule fires on no day in four years" > "/dev/stderr"
      exit 2
    }
    if (run > gap) gap = run

    if (mode == "minutes") {
      # From the last firing of the window back to the first one.
      if (1461 * 1440 - mlast + mfirst > mgap) mgap = 1461 * 1440 - mlast + mfirst
      printf "%d %d\n", mgap, 0
      exit 0
    }

    # gap counts the silent days between two firings. A daily cron has none,
    # and its largest gap is one day.
    gap = gap + 1
    printf "%d %d\n", gap, gap + (gap < 7 ? gap : 7) + 1
  }' </dev/null)" || die "the cron walk failed for $wf" \
  "reproduce: grep -n 'cron:' $wf"

[ -n "${gap:-}" ] && [ -n "${tolerance:-}" ] || die "the cron walk printed nothing for $wf" \
  "reproduce: scripts/cron-tolerance $wf"

if [ "$mode" = days ] && [ "$tolerance" -gt 60 ]; then
  die "the schedule of $wf has a gap of $gap days, so its tolerance is $tolerance days, more than 60" \
    "GitHub stops the schedules of a repository after 60 days with no activity" \
    "give the workflow a cron that fires at least every 52 days" \
    "reproduce: grep -n 'cron:' $wf"
fi

if [ "$mode" = minutes ]; then
  printf '%s\n' "$gap"
else
  printf '%s %s\n' "$gap" "$tolerance"
fi
