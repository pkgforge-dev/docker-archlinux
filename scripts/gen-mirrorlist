#!/usr/bin/env bash
#
# Write the mirror lists of one port, or of every port.
#
#   scripts/gen-mirrorlist ARCH
#   scripts/gen-mirrorlist all
#
# ARCH is a name that `scripts/ports list` prints. For each list that
# rootfs/ARCH/etc/pacman.conf includes, it writes rootfs/ARCH/etc/pacman.d/LIST:
#   mirrorlist    the servers of mirrors/ARCH.anchors, in file order, then the
#                 candidates of mirrors/ARCH.pool that answer, fastest
#                 connection first
#   mirrorlist-X  the servers of mirrors/ARCH.X-anchors, in file order
#
# ⭐ The anchors file is the only reviewed input. Its servers are always first,
# in file order, and are never ranked or dropped. At least one anchor of each
# list must answer. A candidate is written only when it answers 200 for the
# database of the first repository that reads the list.
#
# ⛔ The lists of a port change together. Each list goes to a temporary file,
# and the files move into place only when every list of the port passes. A
# refusal leaves every list of the port unchanged.
#
# mirrors/ARCH.pool is optional. Each line that is not a comment is one of:
#   Server = SERVER                           a candidate
#   source = status-json URL                  the mirror status of archlinux.org
#   source = mirrorlist URL                   a mirrorlist file
#   source = mirrorlist-package DB PKG PATH   the file PATH in the package PKG
#                                             of the repository database DB
# The sources are read in file order, and the first that gives candidates is
# used. A commented Server line in a mirrorlist is a candidate too.
#
# Environment:
#   MIRRORLIST_BUDGET  seconds for one port, default 180. A probe that cannot
#                      start in this time counts as no answer.
#   MIN_SERVERS        the smallest list that is written, default 2
#   MAX_SERVERS        ranked candidates written, default 12
#   POOL_LIMIT         candidates probed, default 40
#   CONCURRENCY        probes at the same time, default 8
#   PROBE_TIMEOUT      seconds for one probe, default 25
#   MAX_SYNC_DELAY     status-json: the largest sync delay in seconds, default 86400
#   MIN_COMPLETION     status-json: the smallest completion_pct, default 1
# and the paths that scripts/lib-mirrors.sh reads.
#
# A list keeps at least half of the ranked servers it had, and at most half
# of MAX_SERVERS. So a bad network does not shrink a list that ships.
#
# Exit status:
#   0  every list was written
#   3  a list was left as it is, because the servers did not answer from here:
#      the committed list stays. With all, other ports can be written.
#   1  an input is wrong or a tool is missing. Nothing of that port changed.
set -euo pipefail

PROG=gen-mirrorlist
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
# shellcheck source=scripts/lib-mirrors.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib-mirrors.sh"

BUDGET="${MIRRORLIST_BUDGET:-180}"
MIN_SERVERS="${MIN_SERVERS:-2}"
MAX_SERVERS="${MAX_SERVERS:-12}"
POOL_LIMIT="${POOL_LIMIT:-40}"
CONCURRENCY="${CONCURRENCY:-8}"
PROBE_TIMEOUT="${PROBE_TIMEOUT:-25}"
MAX_SYNC_DELAY="${MAX_SYNC_DELAY:-86400}"
MIN_COMPLETION="${MIN_COMPLETION:-1}"

for v in BUDGET MIN_SERVERS MAX_SERVERS POOL_LIMIT CONCURRENCY PROBE_TIMEOUT MAX_SYNC_DELAY MIN_COMPLETION; do
  case "${!v}" in
    '' | *[!0-9]*) die "$v is '${!v}'. Use a whole number." ;;
  esac
done
[ "$CONCURRENCY" -ge 1 ] || die "CONCURRENCY is 0. Use 1 or more."

need curl awk tar timeout od

usage() {
  die "usage: scripts/gen-mirrorlist ARCH|all" "ARCH is one of: $(port_list | tr '\n' ' ')"
}

# refuse MESSAGE [DETAIL ...]: exit 3, the lists of the port stay as they are
refuse() {
  echo "$PROG: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  echo "  the lists of this port stay as they are" >&2
  exit 3
}

#---------------------------------------------------------------------------#
# The time budget
#---------------------------------------------------------------------------#
DEADLINE=$(($(date +%s) + BUDGET))

# remaining -> seconds left in the budget, 0 or more
remaining() {
  local r
  r=$((DEADLINE - $(date +%s)))
  [ "$r" -gt 0 ] || r=0
  printf '%s\n' "$r"
}

# limit SECONDS -> the smaller of SECONDS and the time left
limit() {
  local r
  r="$(remaining)"
  if [ "$1" -lt "$r" ]; then
    printf '%s\n' "$1"
  else
    printf '%s\n' "$r"
  fi
}

# connect_limit -> the connect timeout of one transfer, 1 to 10 seconds
connect_limit() {
  local c
  c="$(limit 10)"
  [ "$c" -ge 1 ] || c=1
  printf '%s\n' "$c"
}

#---------------------------------------------------------------------------#
# Probes
#---------------------------------------------------------------------------#

# probe_once URL -> "CODE CONNECT_SECONDS". A file:// URL gives 200 when it
# can be read, because curl reports no HTTP code for it.
probe_once() {
  local url="$1" t res="" rc=0
  t="$(limit "$PROBE_TIMEOUT")"
  if [ "$t" -lt 2 ]; then
    printf '000 99\n'
    return 0
  fi
  res="$(timeout -k 5 "$((t + 5))" curl -s -L -o /dev/null -w '%{http_code} %{time_connect}' \
    -A "$HTTP_UA" --connect-timeout "$(connect_limit)" --max-time "$t" "$url")" || rc=$?
  case "$url" in
    file://*)
      if [ "$rc" -eq 0 ]; then
        res="200 0"
      else
        res="404 0"
      fi
      ;;
  esac
  case "$res" in
    [0-9][0-9][0-9]\ *) ;;
    *) res="000 99" ;;
  esac
  printf '%s\n' "$res"
}

# probe SERVER REPO PACMAN_ARCH OUT UPGRADE: writes "CODE MS SERVER" to OUT.
# With UPGRADE 1, an http:// server is tried over https first, and the https
# form is written when it answers.
probe() {
  local server="$1" repo="$2" parch="$3" out="$4" upgrade="$5" cand res="000 99" code="000" ms
  local -a forms=()
  if [ "$upgrade" = 1 ]; then
    case "$server" in
      http://*) forms+=("https://${server#http://}") ;;
    esac
  fi
  forms+=("$server")
  for cand in "${forms[@]}"; do
    res="$(probe_once "$(server_url "$cand" "$repo" "$parch")/$repo.db")"
    code="${res%% *}"
    if [ "$code" = 200 ]; then
      break
    fi
  done
  ms="$(awk -v t="${res##* }" 'BEGIN { printf "%06d", t * 1000 }')"
  if [ "$code" = 200 ]; then
    printf '%s %s %s\n' "$code" "$ms" "$cand" > "$out"
  else
    printf '%s %s %s\n' "$code" "$ms" "$server" > "$out"
  fi
}

# probe_all REPO PACMAN_ARCH UPGRADE, servers on stdin -> "CODE MS SERVER" per
# server, in input order. At most CONCURRENCY probes run at the same time.
probe_all() {
  local repo="$1" parch="$2" upgrade="$3" dir s i=0 n
  local -a list=()
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    list+=("$s")
  done
  n="${#list[@]}"
  [ "$n" -gt 0 ] || return 0
  dir="$(mktemp -d)"
  for s in "${list[@]}"; do
    probe "$s" "$repo" "$parch" "$dir/$i" "$upgrade" &
    i=$((i + 1))
    if [ $((i % CONCURRENCY)) -eq 0 ]; then
      wait
    fi
  done
  wait
  i=0
  while [ "$i" -lt "$n" ]; do
    if [ -s "$dir/$i" ]; then
      cat "$dir/$i"
    else
      printf '000 999999 %s\n' "${list[$i]}"
    fi
    i=$((i + 1))
  done
  rm -rf "$dir"
}

#---------------------------------------------------------------------------#
# Candidate sources
#---------------------------------------------------------------------------#

# fetch_text URL OUT -> 0 when the body of URL is in OUT
fetch_text() {
  local url="$1" out="$2" t rc=0 said
  t="$(limit 60)"
  if [ "$t" -lt 2 ]; then
    warn "no time left in the budget for $url"
    return 1
  fi
  said="$(timeout -k 5 "$((t + 5))" curl -sSfL -A "$HTTP_UA" --connect-timeout "$(connect_limit)" \
    --max-time "$t" -o "$out" "$url" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    warn "cannot read $url: $(first_line "$said") (curl exit $rc)"
    return 1
  fi
}

# mirrorlist_servers FILE -> every Server value of FILE, commented or not:
# https first, then the rest, each in file order
mirrorlist_servers() {
  awk '
    /^[[:space:]]*#?[[:space:]]*Server[[:space:]]*=/ {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v)
      sub(/[[:space:]]+$/, "", v)
      if (v ~ /^https:\/\//) a[na++] = v; else b[nb++] = v
    }
    END {
      for (i = 0; i < na; i++) print a[i]
      for (i = 0; i < nb; i++) print b[i]
    }' "$1"
}

# source_status_json URL -> candidates from the mirror status JSON of
# archlinux.org: https, active, complete, and synced within MAX_SYNC_DELAY,
# lowest score first
source_status_json() {
  local url="$1" f
  f="$(mktemp)"
  if ! fetch_text "$url" "$f"; then
    rm -f "$f"
    return 1
  fi
  if ! jq -e '.urls | length > 0' "$f" > /dev/null; then
    warn "$url gave no mirror" "check it with: curl -sSL $url | jq '.urls | length'"
    rm -f "$f"
    return 1
  fi
  # shellcheck disable=SC2016 # $repo and $arch are for pacman, not the shell
  jq -r --argjson c "$MIN_COMPLETION" --argjson d "$MAX_SYNC_DELAY" '
    [ .urls[]
      | select(.protocol == "https" and .active == true
               and .completion_pct != null and .completion_pct >= $c
               and .delay != null and .delay <= $d
               and .score != null) ]
    | sort_by(.score) | .[] | .url' "$f" |
    sed -e 's|/*$|/|' -e 's|$|$repo/os/$arch|'
  rm -f "$f"
}

# source_mirrorlist URL -> candidates from a mirrorlist file
source_mirrorlist() {
  local f
  f="$(mktemp)"
  if ! fetch_text "$1" "$f"; then
    rm -f "$f"
    return 1
  fi
  mirrorlist_servers "$f"
  rm -f "$f"
}

# source_mirrorlist_package DB PKG PATH -> candidates from the file PATH in
# the package PKG, which the repository database DB names
source_mirrorlist_package() {
  local db_url="$1" pkg="$2" path="$3" work dir file desc said rc
  work="$(mktemp -d)"
  if ! fetch_text "$db_url" "$work/db"; then
    rm -rf "$work"
    return 1
  fi
  if ! db_open "$work/db"; then
    warn "$db_url: $DB_WHY"
    rm -rf "$work"
    return 1
  fi
  dir="$(awk -v p="$pkg-" 'NF >= 6 && index($6, p) == 1 {
      d = $6; sub(/\/.*$/, "", d)
      if (substr(d, length(p) + 1) ~ /^[0-9]/) { print d; exit }
    }' <<< "$DB_LISTING")"
  if [ -z "$dir" ]; then
    warn "$db_url names no package $pkg"
    rm -rf "$work"
    return 1
  fi
  desc="$(tar "$DB_FLAG" -xOf "$work/db" "$dir/desc")"
  file="$(awk 'f { print; exit } /^%FILENAME%$/ { f = 1 }' <<< "$desc")"
  case "$file" in
    '' | */* | .*)
      warn "$db_url gives no usable file name for $dir: '$file'"
      rm -rf "$work"
      return 1
      ;;
  esac
  if ! fetch_text "${db_url%/*}/$file" "$work/pkg"; then
    rm -rf "$work"
    return 1
  fi
  # tar finds the compression of the package from its first bytes.
  rc=0
  said="$(tar -xOf "$work/pkg" "$path" 2>&1 > "$work/list")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    warn "cannot read $path from $file: $(first_line "$said") (tar exit $rc)"
    rm -rf "$work"
    return 1
  fi
  mirrorlist_servers "$work/list"
  rm -rf "$work"
}

# pool_candidates ARCH -> candidates, one per line, at most POOL_LIMIT.
# Exit 0 with no output when the port has no pool file. Exit 3 when the pool
# names sources and none gave a candidate. Exit 1 on a line it cannot read.
pool_candidates() {
  local arch="$1" pool="$MIRRORS_DIR/$1.pool" bad kind a1 a2 a3 extra out nsrc=0
  [ -f "$pool" ] || return 0
  bad="$(awk '
    /^[[:space:]]*(#|$)/ { next }
    /^[[:space:]]*Server[[:space:]]*=/ { next }
    /^[[:space:]]*source[[:space:]]*=/ { next }
    { print FNR ": " $0 }' "$pool")"
  [ -z "$bad" ] || die "mirrors/$arch.pool has lines that are not Server or source" "$bad"
  # A missing tool is an error, not a source that gave nothing.
  if [ -n "$(awk '/^[[:space:]]*source[[:space:]]*=[[:space:]]*status-json[[:space:]]/' "$pool")" ]; then
    need jq
  fi
  {
    list_servers "$pool"
    while read -r kind a1 a2 a3 extra; do
      [ -n "$kind" ] || continue
      nsrc=$((nsrc + 1))
      out=""
      case "$kind:${extra:-}" in
        status-json:) out="$(source_status_json "$a1")" || out="" ;;
        mirrorlist:) out="$(source_mirrorlist "$a1")" || out="" ;;
        mirrorlist-package:) out="$(source_mirrorlist_package "$a1" "$a2" "$a3")" || out="" ;;
        *)
          die "mirrors/$arch.pool: 'source = $kind ${a1:-} ${a2:-} ${a3:-} ${extra:-}' is not a source this script knows" \
            "the sources are status-json URL, mirrorlist URL and mirrorlist-package DB PKG PATH"
          ;;
      esac
      if [ -n "$out" ]; then
        note "$arch: candidates from $kind $a1"
        printf '%s\n' "$out"
        nsrc=0
        break
      fi
      warn "$arch: the source $kind $a1 gave no candidate, the next source is tried"
    done < <(awk '/^[[:space:]]*source[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); print }' "$pool")
    if [ "$nsrc" -gt 0 ]; then
      exit 3
    fi
  } | awk -v n="$POOL_LIMIT" 'NF && !seen[$0]++ && ++k <= n'
}

#---------------------------------------------------------------------------#
# One port
#---------------------------------------------------------------------------#
TMPS=()
cleanup() {
  local t
  for t in "${TMPS[@]}"; do
    rm -f "$t"
  done
}
trap cleanup EXIT

generate() {
  local arch="$1" parch lists line list repos repo anchors_path dest tmp
  local anchors probe_out live total dead ranked nranked old_ranked keep_min pool rc
  local today
  today="$(date -u +%Y-%m-%d)"
  parch="$(port_get "$arch" pacman_arch)"
  lists="$(port_lists "$arch")"
  local -a dests=() tmps=()

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    list="${line%% *}"
    repos="${line#* }"
    repo="${repos%% *}"
    dest="$(list_file "$arch" "$list")"
    anchors_path="$(anchors_file "$arch" "$list")"
    [ -f "$anchors_path" ] || die "$list of $arch has no anchors file" "expected: ${anchors_path#"$MIRRORS_DIR/"} in mirrors/" \
      "reproduce: ls $MIRRORS_DIR"
    anchors="$(list_servers "$anchors_path")"
    [ -n "$anchors" ] || die "${anchors_path##*/} has no Server line" "reproduce: grep -n Server $anchors_path"
    # ⛔ A shipped list has no oci:// server. Only use-transport adds one, in
    # the build stage.
    if [ -n "$(awk '/^oci/' <<< "$anchors")" ]; then
      die "${anchors_path##*/} has an oci:// server, and a shipped list never has one" \
        "reproduce: grep -n oci: $anchors_path"
    fi
    echo "==> $arch $list: Architecture = $parch, probed with $repo.db"

    # The anchors: every one is written, and at least one must answer.
    probe_out="$(printf '%s\n' "$anchors" | probe_all "$repo" "$parch" 0)"
    live="$(awk '$1 == "200" { n++ } END { print n + 0 }' <<< "$probe_out")"
    dead="$(awk '$1 != "200" { print "  " $3 " (HTTP " $1 ")" }' <<< "$probe_out")"
    echo "    anchors: $(awk 'NF { n++ } END { print n + 0 }' <<< "$anchors") written, $live answered"
    if [ -n "$dead" ]; then
      printf '    no answer from here:\n%s\n' "$dead"
    fi
    if [ "$live" -lt 1 ]; then
      [ "$(remaining)" -gt 0 ] || warn "the time budget of ${BUDGET} s (MIRRORLIST_BUDGET) ran out"
      refuse "no anchor of $list answered for $arch" "the servers are in ${anchors_path##*/}, and each code is above" \
        "reproduce: curl -sS -o /dev/null -w '%{http_code}' -L <server>/$repo.db"
    fi

    # The ranked part: only the main list has a pool.
    ranked=""
    if [ "$list" = mirrorlist ]; then
      rc=0
      pool="$(pool_candidates "$arch")" || rc=$?
      case "$rc" in
        0) ;;
        3) refuse "no candidate source in mirrors/$arch.pool answered" "each failure is above" ;;
        *) exit "$rc" ;;
      esac
      # An anchor is not also a candidate, and no candidate is oci://.
      pool="$(awk 'NR == FNR { a[$0]; next } NF && !($0 in a) && !/^oci/' <(printf '%s\n' "$anchors") <(printf '%s\n' "$pool"))"
      echo "    pool: $(awk 'NF { n++ } END { print n + 0 }' <<< "$pool") candidates"
      if [ -n "$pool" ]; then
        ranked="$(printf '%s\n' "$pool" | probe_all "$repo" "$parch" 1 |
          awk '$1 == "200" { print $2 " " $3 }' | LC_ALL=C sort -n | awk '{ print $2 }')"
        ranked="$(awk 'NR == FNR { a[$0]; next } NF && !($0 in a) && ++k <= m' m="$MAX_SERVERS" \
          <(printf '%s\n' "$anchors") <(printf '%s\n' "$ranked"))"
      fi
    fi
    nranked="$(awk 'NF { n++ } END { print n + 0 }' <<< "$ranked")"
    total=$(($(awk 'NF { n++ } END { print n + 0 }' <<< "$anchors") + nranked))
    echo "    ranked: $nranked written"

    if [ "$total" -lt "$MIN_SERVERS" ]; then
      refuse "the new $list of $arch has $total server(s), and the least is $MIN_SERVERS" \
        "add anchors to ${anchors_path##*/}, or try again when the candidates answer"
    fi

    # The ranked servers of the list in the tree: the servers that are not anchors.
    old_ranked=0
    if [ -f "$dest" ]; then
      old_ranked="$(awk 'NR == FNR { a[$0]; next } NF && !($0 in a) { n++ } END { print n + 0 }' \
        <(printf '%s\n' "$anchors") <(list_servers "$dest"))"
    fi
    keep_min=$((old_ranked / 2))
    [ "$keep_min" -le $((MAX_SERVERS / 2)) ] || keep_min=$((MAX_SERVERS / 2))
    if [ "$nranked" -lt "$keep_min" ]; then
      [ "$(remaining)" -gt 0 ] || warn "the time budget of ${BUDGET} s (MIRRORLIST_BUDGET) ran out"
      refuse "the new $list of $arch has $nranked ranked server(s), and the list in the tree has $old_ranked" \
        "a list keeps at least half of its ranked servers, so it needs $keep_min" \
        "the probe results are above"
    fi

    tmp="$(mktemp "${dest%/*}/.$list.XXXXXX")"
    TMPS+=("$tmp")
    {
      printf '##\n'
      if [ "$list" = mirrorlist ]; then
        printf '## Mirror list for %s, Architecture = %s.\n' "$arch" "$parch"
      else
        printf '## Mirror list for [%s] of %s, Architecture = %s.\n' "${repos// /], [}" "$arch" "$parch"
      fi
      printf '## Generated on %s by scripts/gen-mirrorlist.\n' "$today"
      if [ "$nranked" -gt 0 ]; then
        printf '## The first %s servers are the anchors of mirrors/%s, in that order.\n' \
          "$(awk 'NF { n++ } END { print n + 0 }' <<< "$anchors")" "${anchors_path##*/}"
        printf '## The other servers answered for %s.db, the fastest connection first.\n' "$repo"
      else
        printf '## The servers are the anchors of mirrors/%s, in that order.\n' "${anchors_path##*/}"
      fi
      printf '##\n\n'
      awk 'NF { print "Server = " $0 }' <<< "$anchors"
      if [ "$nranked" -gt 0 ]; then
        printf '\n'
        awk 'NF { print "Server = " $0 }' <<< "$ranked"
      fi
    } > "$tmp"
    chmod 0644 "$tmp"
    dests+=("$dest")
    tmps+=("$tmp")
  done <<< "$lists"

  # Every list of the port passed. Move them all into place.
  local i=0
  while [ "$i" -lt "${#dests[@]}" ]; do
    mv -f "${tmps[$i]}" "${dests[$i]}"
    echo "    wrote ${dests[$i]#"$ROOTFS_DIR/"}: $(list_servers "${dests[$i]}" | awk 'NF { n++ } END { print n + 0 }') servers"
    i=$((i + 1))
  done
}

#---------------------------------------------------------------------------#
# Every port
#
# Each port runs in a process of its own, all at the same time. So one port
# that cannot be reached does not stop the others, and the run takes about
# one budget. The output of each port is printed after it, in port order.
#---------------------------------------------------------------------------#
generate_all() {
  local work a rc worst=0 unchanged="" failed=""
  local -a arches=() pids=()
  mapfile -t arches < <(port_list)
  [ "${#arches[@]}" -gt 0 ] || die "scripts/ports list printed no port"
  work="$(mktemp -d)"
  for a in "${arches[@]}"; do
    bash "${BASH_SOURCE[0]}" "$a" > "$work/$a.log" 2>&1 &
    pids+=("$!")
  done
  local i=0
  for a in "${arches[@]}"; do
    rc=0
    wait "${pids[$i]}" || rc=$?
    i=$((i + 1))
    printf '\n# ===== %s (exit %s) =====\n' "$a" "$rc"
    cat "$work/$a.log"
    case "$rc" in
      0) ;;
      3)
        unchanged="$unchanged $a"
        [ "$worst" -eq 1 ] || worst=3
        ;;
      *)
        failed="$failed $a"
        worst=1
        ;;
    esac
  done
  rm -rf "$work"
  if [ -n "$unchanged" ]; then
    echo "$PROG: left as they are, because the servers did not answer:$unchanged" >&2
  fi
  if [ -n "$failed" ]; then
    echo "$PROG: stopped on an input error:$failed" >&2
  fi
  exit "$worst"
}

[ "$#" -eq 1 ] || usage
case "$1" in
  all) generate_all ;;
  -h | --help) usage ;;
  *)
    port_check "$1"
    generate "$1"
    ;;
esac
