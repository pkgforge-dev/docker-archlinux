#!/usr/bin/env bash
#
# Check that every port still publishes, on GHCR and on Docker Hub.
#
#   scripts/check-publish-recency [OUT_DIR]
#
# For each port (scripts/ports list) the script finds the newest tag
# <first alias>-v<YYYY.MM.DD> on each registry. For the index it finds the
# newest v<YYYY.MM.DD>. It measures the age of each tag against the tolerance
# of the build schedule (scripts/cron-tolerance on PUBLISH_WORKFLOW).
#
# ⭐ The outcome is measured, not the runs. A run that publishes nothing and a
# run that never starts both leave the newest tag to age.
#
# ⭐ Each port is measured on its own. One port can stop while the others
# publish and the index moves.
#
# ⛔ No threshold, year or port list is written here. The tolerance comes from
# the cron, the ports come from scripts/ports, and the date is found by its
# shape (YYYY.MM.DD), never by a year prefix. The tag families
# <alias>-v<date> and v<date> are fixed names that consumers use.
#
# The state of each key (each arch, and "index"):
#   current  every registry has a dated tag within the tolerance
#   stale    a registry that was read has no dated tag, or one that is too old
#   unknown  not stale, and a registry could not be read, or a tag date is
#            later than today
#
# With OUT_DIR the script writes OUT_DIR/<key>.state (the state) and
# OUT_DIR/<key>.md (an issue body) for each key. The watchdog workflow raises
# or clears the issue stale-<key> from them.
#
# Environment:
#   PUBLISH_WORKFLOW   the workflow whose cron gives the tolerance; default
#                      .github/workflows/build-deploy.yml
#   PUBLISH_IMAGE      the GHCR image; default GHCR_IMAGE of the top level env
#                      of PUBLISH_WORKFLOW. ${{ github.repository_owner }} in it
#                      is the owner of GITHUB_REPOSITORY (pkgforge-dev when it
#                      is not set)
#   HUB_IMAGE          the Docker Hub image; default HUB_IMAGE of the top level
#                      env of PUBLISH_WORKFLOW
# ⭐ The image names have one place: the env of the publish workflow.
#   PORTS_DIR          goes to scripts/ports
#   RECENCY_TODAY      YYYY-MM-DD, the day to measure against; default today
#   RECENCY_GHCR_TAGS  a file of GHCR tag names, one per line, read in place
#                      of the registry
#   RECENCY_HUB_TAGS   the same for Docker Hub
# ⚠ The three RECENCY_ variables are test seams. No workflow sets them.
#
# Exit status:
#   0  every key is current
#   3  at least one key is stale
#   1  no key is stale and at least one is unknown, or the check could not run
set -euo pipefail

PROG=check-publish-recency
# shellcheck source=scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

need awk jq curl

owner="${GITHUB_REPOSITORY:-pkgforge-dev/docker-archlinux}"
owner="${owner%%/*}"
PUBLISH_WORKFLOW="${PUBLISH_WORKFLOW:-$REPO_ROOT/.github/workflows/build-deploy.yml}"
[ -f "$PUBLISH_WORKFLOW" ] || die "no publish workflow at $PUBLISH_WORKFLOW" \
  "reproduce: ls .github/workflows/"

# wf_env KEY -> the value of KEY in the top level env of PUBLISH_WORKFLOW, with
# ${{ github.repository_owner }} read as the owner. Nothing when absent.
wf_env() {
  awk -v k="$1" '
    /^[^[:space:]#]/ { top = ($0 ~ /^env:[[:space:]]*$/); next }
    top && $0 ~ "^  " k ":" {
      v = substr($0, index($0, ":") + 1)
      sub(/[[:space:]]+#.*$/, "", v)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      gsub(/^["\047]|["\047]$/, "", v)
      last = v
    }
    END { print last }' "$PUBLISH_WORKFLOW" | sed "s|\${{ *github.repository_owner *}}|$owner|g"
}
PUBLISH_IMAGE="${PUBLISH_IMAGE:-$(wf_env GHCR_IMAGE)}"
HUB_IMAGE="${HUB_IMAGE:-$(wf_env HUB_IMAGE)}"
[ -n "$PUBLISH_IMAGE" ] || die "PUBLISH_IMAGE is not set, and $PUBLISH_WORKFLOW sets no GHCR_IMAGE in its top level env" \
  "reproduce: yq .env $PUBLISH_WORKFLOW"
[ -n "$HUB_IMAGE" ] || die "HUB_IMAGE is not set, and $PUBLISH_WORKFLOW sets no HUB_IMAGE in its top level env" \
  "reproduce: yq .env $PUBLISH_WORKFLOW"

out_dir="${1:-}"
[ "$#" -le 1 ] || die "usage: scripts/check-publish-recency [OUT_DIR]"
if [ -n "$out_dir" ]; then
  mkdir -p "$out_dir"
fi

today="${RECENCY_TODAY:-$(date -u +%Y-%m-%d)}"
case "$today" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
  *) die "RECENCY_TODAY is not YYYY-MM-DD: $today" ;;
esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

#---------------------------------------------------------------------------#
# The tolerance, from the schedule of the publish workflow.
#---------------------------------------------------------------------------#
if ! tol_line="$("$REPO_ROOT/scripts/cron-tolerance" "$PUBLISH_WORKFLOW")"; then
  die "cannot derive a tolerance from $PUBLISH_WORKFLOW" \
    "reproduce: scripts/cron-tolerance $PUBLISH_WORKFLOW"
fi
read -r gap tolerance <<< "$tol_line"
[ -n "${tolerance:-}" ] || die "the tolerance is empty" \
  "reproduce: scripts/cron-tolerance $PUBLISH_WORKFLOW"
note "the largest gap of $(basename "$PUBLISH_WORKFLOW") is $gap day(s), so the tolerance is $tolerance day(s); measured on $today"

#---------------------------------------------------------------------------#
# The ports and their first aliases.
#---------------------------------------------------------------------------#
"$REPO_ROOT/scripts/ports" list > "$work/arches.txt"
[ -s "$work/arches.txt" ] || die "scripts/ports lists no port" "reproduce: scripts/ports list"
: > "$work/keys.txt"
while read -r a; do
  [ -n "$a" ] || continue
  "$REPO_ROOT/scripts/ports" aliases "$a" < /dev/null > "$work/aliases.txt"
  first="$(awk 'NF { print; exit }' "$work/aliases.txt")"
  [ -n "$first" ] || die "the port $a has no alias" "reproduce: scripts/ports aliases $a"
  printf '%s %s-v\n' "$a" "$first" >> "$work/keys.txt"
done < "$work/arches.txt"
printf 'index v\n' >> "$work/keys.txt"

#---------------------------------------------------------------------------#
# The tag lists. A list that cannot be read makes its keys unknown, not stale.
#---------------------------------------------------------------------------#
# read_tags NAME IMAGE SEAM_FILE -> writes $work/NAME.tags, or $work/NAME.unread
read_tags() {
  local name="$1" image="$2" seam="$3" registry repo rc=0
  registry="${image%%/*}"
  repo="${image#*/}"
  if [ -n "$seam" ]; then
    [ -f "$seam" ] || die "no such tag file: $seam"
    tr -d '\r' < "$seam" | awk 'NF' > "$work/$name.tags"
    note "$name: the tags come from $seam, not from a registry"
  else
    reg_tags "$registry" "$repo" "$work/$name.tags" 2> "$work/$name.err" || rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "$name: the tag list of $image could not be read; reproduce: scripts/registry-tags $registry $repo"
      sed 's/^/  /' "$work/$name.err" >&2
      printf 'the tag list could not be read\n' > "$work/$name.unread"
      return 0
    fi
  fi
  if [ ! -s "$work/$name.tags" ]; then
    warn "$name: the tag list of $image is empty; the repository is absent or not public"
    printf 'the tag list is empty\n' > "$work/$name.unread"
  fi
}

read_tags ghcr "$PUBLISH_IMAGE" "${RECENCY_GHCR_TAGS:-}"
read_tags hub "$HUB_IMAGE" "${RECENCY_HUB_TAGS:-}"

# newest PREFIX FILE -> "<tag> <YYYY.MM.DD>" of the newest dated tag, or nothing.
# ⭐ The dates are zero padded, so text order is date order.
newest() {
  awk -v p="$1" '
    {
      if (substr($0, 1, length(p)) != p) next
      core = substr($0, length(p) + 1)
      if (core !~ /^[0-9][0-9][0-9][0-9][.][0-9][0-9][.][0-9][0-9]$/) next
      split(core, d, ".")
      if (d[2] + 0 < 1 || d[2] + 0 > 12 || d[3] + 0 < 1 || d[3] + 0 > 31) next
      if (core > best) { best = core; tag = $0 }
    }
    END { if (best != "") print tag, best }' "$2"
}

#---------------------------------------------------------------------------#
# Measure each key on each registry.
#---------------------------------------------------------------------------#
n_stale=0
n_unknown=0
while read -r key prefix; do
  [ -n "$key" ] || continue
  state=current
  : > "$work/rows.txt"
  for reg in ghcr hub; do
    if [ "$reg" = ghcr ]; then image="$PUBLISH_IMAGE"; else image="$HUB_IMAGE"; fi
    if [ -f "$work/$reg.unread" ]; then
      printf '%s %s - - %s\n' "$reg" "$image" "$(tr ' ' '_' < "$work/$reg.unread")" >> "$work/rows.txt"
      [ "$state" = stale ] || state=unknown
      continue
    fi
    hit="$(newest "$prefix" "$work/$reg.tags")"
    if [ -z "$hit" ]; then
      printf '%s %s none - no_dated_tag\n' "$reg" "$image" >> "$work/rows.txt"
      state=stale
      continue
    fi
    read -r tag date <<< "$hit"
    age="$("$REPO_ROOT/scripts/date-age" "$(printf '%s' "$date" | tr . -)" "$today")"
    if [ "$age" -lt 0 ]; then
      printf '%s %s %s %s dated_later_than_today\n' "$reg" "$image" "$tag" "$age" >> "$work/rows.txt"
      [ "$state" = stale ] || state=unknown
    elif [ "$age" -gt "$tolerance" ]; then
      printf '%s %s %s %s too_old\n' "$reg" "$image" "$tag" "$age" >> "$work/rows.txt"
      state=stale
    else
      printf '%s %s %s %s ok\n' "$reg" "$image" "$tag" "$age" >> "$work/rows.txt"
    fi
  done

  case "$state" in
    stale) n_stale=$((n_stale + 1)) ;;
    unknown) n_unknown=$((n_unknown + 1)) ;;
  esac
  awk -v k="$key" -v s="$state" '
    { line = line sprintf("  %s %s %s", $1, $3, ($4 == "-" ? "-" : $4 "d")) }
    END { printf "%-8s  %-8s%s\n", s, k, line }' "$work/rows.txt"

  if [ -n "$out_dir" ]; then
    printf '%s\n' "$state" > "$out_dir/$key.state"
    # shellcheck disable=SC2016 # Markdown backticks, not command substitution
    {
      if [ "$key" = index ]; then
        printf 'The newest dated index tag `v<date>` is older than the build schedule allows, or absent.\n\n'
      else
        printf 'The newest dated tag of the port `%s` (`%s<date>`) is older than the build schedule allows, or absent.\n\n' "$key" "$prefix"
      fi
      printf '| registry | image | newest dated tag | age (days) | result |\n| --- | --- | --- | --- | --- |\n'
      awk '{ r = $5; gsub(/_/, " ", r); printf "| %s | `%s` | `%s` | %s | %s |\n", $1, $2, $3, $4, r }' "$work/rows.txt"
      printf '\nThe tolerance is %s day(s): the largest gap of the cron in `%s` is %s day(s), and the tolerance is 2 x gap + 1.\n\n' \
        "$tolerance" "$(basename "$PUBLISH_WORKFLOW")" "$gap"
      printf 'Read the newest runs of the build: `gh run list --workflow %s --limit 5`.\n\n' "$(basename "$PUBLISH_WORKFLOW")"
      printf 'reproduce: `scripts/check-publish-recency`\n'
    } > "$out_dir/$key.md"
  fi
done < "$work/keys.txt"

if [ "$n_stale" -gt 0 ]; then
  note "$n_stale key(s) stale, $n_unknown unknown; reproduce: scripts/check-publish-recency"
  exit 3
fi
if [ "$n_unknown" -gt 0 ]; then
  note "$n_unknown key(s) unknown: a registry could not be read; reproduce: scripts/check-publish-recency"
  exit 1
fi
note "every port and the index are within $tolerance day(s)"
