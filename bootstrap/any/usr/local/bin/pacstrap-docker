#!/usr/bin/env bash
#
# Install packages into a new root, in a container build.
#
#   pacstrap-docker ROOT PACKAGE...
#
# Upstream pacstrap mounts the API file systems and runs arch-chroot. A
# container build has not the privileges for that, and cannot run binaries of
# the target architecture. This does the parts that apply: it makes the
# directories pacman expects, makes /dev/null, and runs pacman -r ROOT -Sy.
#
# pacman -r reads /etc/pacman.conf of the build stage, not ROOT/etc/pacman.conf.
# That config sets Architecture, the lists and SigLevel. It has no NoExtract
# rule, so every file of a package goes to disk.
#
# The packages come from bootstrap/<arch>/etc/bootstrap-packages.txt, never
# from the network. With no PACKAGE, it installs base.
#
# Environment:
#   PACSTRAP_TRIES  the number of attempts when a download fails, default 3
#
# Exit status: 0 installed, 1 a step failed.
set -euo pipefail

info() {
  echo "==> $*"
}

error() {
  echo "==> ERROR: $*" >&2
}

die() {
  error "$@"
  exit 1
}

[ "$#" -ge 1 ] || die "no root directory given. Usage: pacstrap-docker ROOT PACKAGE..."
newroot="$1"
shift
pacman_args=("${@:-base}")

tries="${PACSTRAP_TRIES:-3}"
case "$tries" in
  '' | *[!0-9]* | 0*) die "PACSTRAP_TRIES is '$tries'. Use a whole number from 1." ;;
esac

if [ "$(id -u)" -ne 0 ]; then
  die "run this as root"
fi

info "Making the target directories..."
mkdir -p "$newroot"
mkdir -p "$newroot"/{var/{cache/pacman/pkg,lib/pacman,log},dev,run,etc,tmp,sys,proc}
chmod 0755 "$newroot"/{var,var/cache,var/cache/pacman,var/cache/pacman/pkg,var/lib,var/lib/pacman,var/log,dev,run,etc}
chmod 1777 "$newroot"/tmp
chmod 0555 "$newroot"/{sys,proc}

info "Making /dev/null in the new root..."
# ⚠ mknod needs CAP_MKNOD. A docker build step has it, and a rootless podman
# build step does not. Without the node the install goes on, and the trap
# removes what a scriptlet writes at that path.
if ! mknod "$newroot/dev/null" c 1 3; then
  error "cannot make $newroot/dev/null, so the install goes on without it"
fi
log=""
trap 'rm -f "$newroot/dev/null" ${log:+"$log"}' EXIT

# ⭐ A download that fails on every server gets PACSTRAP_TRIES attempts in
# all. pacman keeps each file it got in its cache, so the next attempt reads
# only the files that failed. Any other failure stops at once, for example a
# bad signature or a package that no repository has.
#
# pacman 7 gives one of these lines when no server gave a file:
#   warning: failed to retrieve some files                (a package)
#   error: failed to synchronize all databases (REASON)   (a database)
#   error: failed to commit transaction (REASON)          (a package)
# REASON is "download library error" through curl, and "error invoking
# external downloader" through the XferCommand (TRANSPORT=oci).
# ⚠ "failed retrieving file" names one server only. pacman then tries the
# next server, so that line alone is not a failed download.
RETRY_RE='failed to retrieve some files|failed to (synchronize all databases|commit transaction) \((download library error|error invoking external downloader)\)'
log="$(mktemp)"
attempt=0
while :; do
  attempt=$((attempt + 1))
  info "Installing packages into $newroot, attempt $attempt of $tries..."
  rc=0
  pacman -r "$newroot" -Sy --noconfirm "${pacman_args[@]}" 2>&1 | tee "$log" || rc=$?
  [ "$rc" -eq 0 ] && break
  retry=0
  if grep -Eq -e "$RETRY_RE" "$log"; then
    retry=1
  fi
  if [ "$retry" -eq 1 ] && [ "$attempt" -lt "$tries" ]; then
    error "a download failed on every server, so the install starts again in $((attempt * 20)) s"
    sleep "$((attempt * 20))"
    continue
  fi
  error 'pacman gives the reason above. It read these inputs from the build stage,'
  error 'not from the target root:'
  error '  packages  /etc/bootstrap-packages.txt'
  error '  mirrors   the lists that /etc/pacman.conf includes, in /etc/pacman.d'
  error '  config    /etc/pacman.conf: Architecture, SigLevel, XferCommand'
  die "the packages did not install into $newroot (pacman exit $rc, attempt $attempt of $tries)"
done
