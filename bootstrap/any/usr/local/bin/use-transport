#!/usr/bin/env bash
#
# Set the path the build stage uses to read the GHCR mirror.
#
#   use-transport TRANSPORT [ROOT]
#
# The lists that ship end with the GHCR mirror, so a consumer reads the
# servers of the distribution first. The build stage reads the GHCR mirror
# first: in each list that pacman.conf includes, this moves each Server line
# of the Worker (GHCR_WORKER_RE) above the other servers, in its own order.
#
# TRANSPORT is the word scripts/pick-transport prints:
#   worker  the Worker lines go first. Nothing else changes.
#   oci     the same, and ROOT/etc/pacman.conf gets
#           "XferCommand = /usr/local/bin/pacman-oci %o %u" in [options], and
#           each list gets
#           "Server = oci://ghcr.io/pkgforge-dev/mirror-archlinux/$arch/$repo"
#           as its first server, above the Worker. pacman-oci gives every other
#           URL to curl, so the other servers stay the fallback.
# ROOT is the root of the build stage, default /.
#
# ⛔ Only the build stage. The config that ships (/rootfs) never gets an
# XferCommand or an oci:// server, so this refuses a ROOT named rootfs.
#
# A second run changes nothing.
#
# Exit status: 0 done, 1 an input is wrong.
set -euo pipefail

# shellcheck disable=SC2016 # $arch and $repo are for pacman, not the shell
OCI_SERVER='oci://ghcr.io/pkgforge-dev/mirror-archlinux/$arch/$repo'
XFER_BIN=/usr/local/bin/pacman-oci
XFER="XferCommand = $XFER_BIN %o %u"
# A Server value that matches it is the Cloudflare Worker of the GHCR mirror.
GHCR_WORKER_RE='^https://ghcr\.mirror\.archlinux\.pkgforge\.dev/'

die() {
  echo "use-transport: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  die "usage: use-transport worker|oci [ROOT]"
fi
transport="$1"
root="${2:-/}"

case "$transport" in
  worker | oci) ;;
  *) die "TRANSPORT is '$transport'. Use worker or oci." ;;
esac

root="${root%/}"
case "$root" in
  rootfs | */rootfs | */rootfs/*) die "ROOT is $root, a tree named rootfs: the tree that ships" "the config that ships never gets an XferCommand or an oci:// server" ;;
esac

conf="$root/etc/pacman.conf"
[ -f "$conf" ] || die "no pacman.conf at $conf" "reproduce: ls -l $conf"

# 1. oci: XferCommand, in [options]
if [ "$transport" = oci ]; then
  [ -f "$root$XFER_BIN" ] || die "the client is missing at $root$XFER_BIN" \
    "the Dockerfile copies it from bootstrap/any" "reproduce: ls -l $root$XFER_BIN"
  other="$(awk -v x="$XFER" '
    /^[[:space:]]*\[/ { s = $0; next }
    s ~ /^[[:space:]]*\[options\]/ && /^[[:space:]]*XferCommand[[:space:]]*=/ {
      v = $0; sub(/[[:space:]]+$/, "", v); if (v != x) print FNR ": " v
    }' "$conf")"
  [ -z "$other" ] || die "$conf sets another XferCommand" "$other"
  if [ -n "$(awk -v x="$XFER" '{ v = $0; sub(/[[:space:]]+$/, "", v) } v == x' "$conf")" ]; then
    echo "use-transport: $conf has the XferCommand already" >&2
  else
    tmp="$(mktemp)"
    awk -v x="$XFER" '
      { print }
      !done && /^[[:space:]]*\[options\][[:space:]]*$/ { print x; done = 1 }
      END { if (!done) exit 3 }' "$conf" > "$tmp" || {
      rm -f "$tmp"
      die "$conf has no [options] section" "reproduce: grep -n options $conf"
    }
    cat "$tmp" > "$conf"
    rm -f "$tmp"
    echo "use-transport: $conf: $XFER" >&2
  fi
fi

# 2. The GHCR mirror first, in every list that a section includes: with oci
# the oci:// server, then the Worker, then every other server. Each Server line
# keeps its place in the file; only the values change places.
lists="$(awk '
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*\[/ { s = $0; next }
  s !~ /^[[:space:]]*\[options\]/ && /^[[:space:]]*Include[[:space:]]*=/ {
    v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
    if (!seen[v]++) print v
  }' "$conf")"
[ -n "$lists" ] || die "$conf includes no list" "reproduce: grep -n Include $conf"

oci=""
[ "$transport" != oci ] || oci="$OCI_SERVER"
while IFS= read -r inc; do
  [ -n "$inc" ] || continue
  list="$root$inc"
  [ -f "$list" ] || die "$conf includes $inc, and $list is missing"
  tmp="$(mktemp)"
  # ENVIRON, not -v: awk -v reads backslash escapes in the value.
  OCI="$oci" RE="$GHCR_WORKER_RE" awk -v out="$tmp" '
    function value(l) { sub(/^[^=]*=[[:space:]]*/, "", l); sub(/[[:space:]]+$/, "", l); return l }
    { line[NR] = $0 }
    /^[[:space:]]*Server[[:space:]]*=/ {
      v = value($0)
      slot[++ns] = NR
      if (ENVIRON["OCI"] != "" && v == ENVIRON["OCI"]) next
      if (v ~ ENVIRON["RE"]) w[++nw] = v; else o[++no] = v
    }
    END {
      if (ns == 0) exit 3
      n = 0
      if (ENVIRON["OCI"] != "") order[++n] = ENVIRON["OCI"]
      for (i = 1; i <= nw; i++) order[++n] = w[i]
      for (i = 1; i <= no; i++) order[++n] = o[i]
      k = 0
      for (r = 1; r <= NR; r++) {
        if (k < ns && r == slot[k + 1]) {
          k++
          # The oci:// server adds one line, above the first slot.
          if (k == 1 && n > ns) print "Server = " order[1] > out
          print "Server = " order[k + n - ns] > out
        } else {
          print line[r] > out
        }
      }
    }' "$list" || {
    rm -f "$tmp"
    die "$list has no Server line"
  }
  if cmp -s "$tmp" "$list"; then
    echo "use-transport: $list starts with the GHCR mirror already" >&2
  else
    cat "$tmp" > "$list"
    echo "use-transport: $list: the first server is $(awk '/^[[:space:]]*Server[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); print; exit }' "$tmp")" >&2
  fi
  rm -f "$tmp"
done <<< "$lists"
