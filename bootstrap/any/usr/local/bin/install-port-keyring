#!/usr/bin/env bash
#
# Install the signing keyring of a port into the pacman keyring of the build
# stage, as a pin in bootstrap/keyrings/ sets it.
#
#   install-port-keyring
#
# Arch Linux ARM, the loong64 port and ArchPOWER sign with keys that
# archlinux-keyring does not have. Each of these ports has a pin: the keyring
# package, its sha256 and its trusted keys. The package is in the tree next to
# the pin. So SigLevel = Required stays on.
#
# ⛔ To add a port, add a .pin file and its package. Do not change this script.
#
# The Architecture line of /etc/pacman.conf selects the pin. When no pin has
# that architecture, the script exits 0 and does not change the keyring.
#
# ⛔ The script checks the whole trusted set, and the validity of each key. A
# trusted key added, removed or with a changed expiry stops the build. A key
# that the pin dates in the future must be fully valid after populate: a key
# at marginal validity signs nothing that pacman accepts.
#
# ⭐ Then it follows the newest keyring of the port. pacman downloads it and
# checks its signature against the pinned keys (step 7). So a port that adds a
# key does not stop the build before the pin moves.
#
# Environment: PORT_KEYRING_DIR, PORT_KEYRING_PACMAN_CONF,
# PORT_KEYRING_GPG_HOMEDIR override the three paths below.
#
# Exit status: 0 the keyring is installed, or no pin has the architecture.
# 1 a check failed.
set -euo pipefail

KEYRING_DIR="${PORT_KEYRING_DIR:-/usr/local/share/docker-archlinux/keyrings}"
PACMAN_CONF="${PORT_KEYRING_PACMAN_CONF:-/etc/pacman.conf}"
GPG_HOMEDIR="${PORT_KEYRING_GPG_HOMEDIR:-/etc/pacman.d/gnupg}"

# die MESSAGE [DETAIL ...]: MESSAGE says what is wrong. Each DETAIL goes on a
# line of its own, below it.
die() {
  echo "install-port-keyring: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

need() {
  command -v "$1" >/dev/null || die "$1 is required"
}
need curl
need awk
need gpg
need sha256sum
need bsdtar
need pacman
need vercmp

# field FILE KEY -> the value of the first KEY = line, comments ignored
field() {
  awk -F= -v k="$2" '
    $0 ~ /^[[:space:]]*#/ { next }
    $1 ~ "^[[:space:]]*" k "[[:space:]]*$" {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }' "$1"
}

# field_all FILE KEY -> every KEY = value, in the order the file lists them
field_all() {
  awk -F= -v k="$2" '
    $0 ~ /^[[:space:]]*#/ { next }
    $1 ~ "^[[:space:]]*" k "[[:space:]]*$" {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      print
    }' "$1"
}

# trusted_lines FILE -> "<fingerprint> <expiry>" per trusted entry
trusted_lines() {
  awk -F= '
    $0 ~ /^[[:space:]]*#/ { next }
    $1 ~ /^[[:space:]]*trusted[[:space:]]*$/ {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      print
    }' "$1"
}

#---------------------------------------------------------------------------#
# 1. Which architecture, and which pin serves it
#---------------------------------------------------------------------------#
[ -f "$PACMAN_CONF" ] || die "no pacman.conf at $PACMAN_CONF" \
  "the Dockerfile copies the config of the port to /etc of this stage" \
  "reproduce: ls -l $PACMAN_CONF"

arch="$(awk -F= '/^[[:space:]]*Architecture[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$PACMAN_CONF")"
[ -n "$arch" ] || die "no Architecture in $PACMAN_CONF" \
  "pacman -r reads this line to select the packages" \
  "reproduce: grep -n Architecture $PACMAN_CONF"

[ -d "$KEYRING_DIR" ] || die "no keyring directory at $KEYRING_DIR" \
  "the Dockerfile copies bootstrap/keyrings there" \
  "reproduce: ls -l $KEYRING_DIR"

pin=""
served=()
for candidate in "$KEYRING_DIR"/*.pin; do
  [ -e "$candidate" ] || continue
  for a in $(field "$candidate" arch); do
    [ "$a" = "$arch" ] || continue
    pin="$candidate"
    served+=("$candidate")
  done
done

if [ "${#served[@]}" -gt 1 ]; then
  die "${#served[@]} pins have Architecture = $arch: ${served[*]}" \
    "one architecture has one trust root, so correct the arch lines in $KEYRING_DIR" \
    "reproduce: grep -n '^arch' $KEYRING_DIR/*.pin"
fi

if [ -z "$pin" ]; then
  echo "==> no pin in $KEYRING_DIR has $arch, so the keyring stays as it is"
  exit 0
fi
echo "==> ${pin##*/} has $arch"

#---------------------------------------------------------------------------#
# 2. Read the pin
#---------------------------------------------------------------------------#
keyring="$(field "$pin" keyring)"
mirror="$(field "$pin" mirror)"
pkg="$(field "$pin" package)"
want_sha="$(field "$pin" sha256)"

for v in keyring mirror pkg want_sha; do
  if [ -z "${!v}" ]; then
    die "$pin has no value for ${v#want_}" \
      "bootstrap/keyrings/archlinuxarm.pin gives the fields" \
      "reproduce: cat $pin"
  fi
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

trusted_lines "$pin" | LC_ALL=C sort > "$work/pin-trusted.txt"
pinned_count="$(awk 'NF { n++ } END { print n + 0 }' "$work/pin-trusted.txt")"
[ "$pinned_count" -gt 0 ] || die "$pin has no trusted fingerprint" \
  "a pin with no trusted key checks nothing" \
  "reproduce: grep -n '^trusted' $pin"
echo "    the pin has $pinned_count trusted fingerprint(s)"

#---------------------------------------------------------------------------#
# 3. The pinned package: from the tree, else from the mirror lines of the pin.
#    The sha256 is checked before anything is read from it.
#
# ⛔ The package is in the tree next to the pin, because a port deletes an old
# keyring package from its mirrors. tests/static/88-keyring-pins-vendored.sh
# checks that each pin has its package and that the sha256 agrees.
#
# The mirror lines are the second source, tried in file order. The sha256 makes
# each source safe: a mirror is a transfer path, not a second trust root.
#---------------------------------------------------------------------------#
if [ -f "$KEYRING_DIR/$pkg" ]; then
  cp "$KEYRING_DIR/$pkg" "$work/keyring.pkg"
  echo "==> $pkg is in the tree, no download"
else
  echo "==> $pkg is not in the tree, downloading it"
  got_pkg=0
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    if curl -sSfL --connect-timeout 15 --max-time 180 --retry 3 --retry-delay 3 \
         -o "$work/keyring.pkg" "$m/$pkg"; then
      echo "    fetched from $m"
      got_pkg=1
      break
    fi
    echo "install-port-keyring: cannot download $m/$pkg, the next mirror is tried" >&2
  done < <(field_all "$pin" mirror)

  if [ "$got_pkg" -ne 1 ]; then
    die "no mirror line of $pin gave the pinned keyring package, and the tree has no copy" \
      "wanted: $pkg, at $KEYRING_DIR/$pkg or from a mirror" \
      "each mirror line was tried, and each failure is above" \
      "put the package back in the tree with: scripts/check-keyring-pin --apply $pin"
  fi
fi

got_sha="$(sha256sum "$work/keyring.pkg" | cut -d' ' -f1)"
if [ "$got_sha" != "$want_sha" ]; then
  die "the sha256 of $pkg is not the pinned sha256" \
    "pinned: $want_sha" \
    "got   : $got_sha" \
    "reproduce: curl -sSfL --connect-timeout 15 --max-time 180 -o k $mirror/$pkg && sha256sum k"
fi
echo "==> the sha256 agrees with the pin"

mkdir -p "$work/x"
bsdtar -xf "$work/keyring.pkg" -C "$work/x"

src="$work/x/usr/share/pacman/keyrings"
for f in "$keyring.gpg" "$keyring-trusted" "$keyring-revoked"; do
  [ -f "$src/$f" ] || die "$pkg has no $f" \
    "the keyring name in $pin is not the name in the package" \
    "reproduce: bsdtar -tf $pkg | grep usr/share/pacman/keyrings"
done

#---------------------------------------------------------------------------#
# 4. The whole trusted set, and the expiry of each key
#
# ⛔ The pin has both: the fingerprints give who can sign, the expiry gives
# until when. Both come from the key material in the package.
#---------------------------------------------------------------------------#
gpg --batch --with-colons --fixed-list-mode --show-keys "$src/$keyring.gpg" \
  > "$work/keys.colons"

awk -F: -v today="$(date -u +%s)" '
  $1 == "pub" { expires = $7; seen = 1; next }
  $1 == "fpr" && seen {
    if (expires == "") {
      printf "%s never\n", $10
    } else {
      printf "%s %s\n", $10, strftime("%Y-%m-%d", expires + 0, 1)
    }
    seen = 0
  }' "$work/keys.colons" | LC_ALL=C sort > "$work/key-expiry.txt"

cut -d: -f1 < "$src/$keyring-trusted" | awk 'NF' | LC_ALL=C sort > "$work/pkg-trusted-fprs.txt"
awk '{ print $1 }' "$work/pin-trusted.txt" | LC_ALL=C sort > "$work/pin-fprs.txt"

only_pin="$(comm -23 "$work/pin-fprs.txt" "$work/pkg-trusted-fprs.txt" | tr '\n' ' ')"
only_pkg="$(comm -13 "$work/pin-fprs.txt" "$work/pkg-trusted-fprs.txt" | tr '\n' ' ')"
if [ -n "$(printf '%s' "$only_pin$only_pkg" | tr -d '[:space:]')" ]; then
  die "the trusted set in $pkg is not the set in $pin" \
    "in the pin, not in the package: ${only_pin:-none}" \
    "in the package, not in the pin: ${only_pkg:-none}" \
    "the trust root changed. A person reads the new set before the pin moves" \
    "reproduce: bsdtar -xOf $pkg usr/share/pacman/keyrings/$keyring-trusted"
fi

# Each pinned fingerprint keeps the expiry that the pin gives.
drift=""
while IFS= read -r line; do
  [ -n "$line" ] || continue
  fpr="${line%% *}"
  want="${line#* }"
  got="$(awk -v f="$fpr" '$1 == f { print $2; exit }' "$work/key-expiry.txt")"
  if [ -z "$got" ]; then
    drift="$drift $fpr(pinned $want, not a primary key in the keyring)"
  elif [ "$got" != "$want" ]; then
    drift="$drift $fpr(pinned $want, keyring says $got)"
  fi
done < "$work/pin-trusted.txt"

if [ -n "$drift" ]; then
  die "the expiry of a pinned key is not the expiry in $pin" \
    "different:$drift" \
    "the expiry is key material, so it changes only with the package" \
    "reproduce: bsdtar -xOf $pkg usr/share/pacman/keyrings/$keyring.gpg | gpg --with-colons --show-keys"
fi
echo "==> the trusted set and each expiry agree with the pin"

#---------------------------------------------------------------------------#
# 5. Install and populate
#---------------------------------------------------------------------------#
for f in "$keyring.gpg" "$keyring-trusted" "$keyring-revoked"; do
  install -Dm644 "$src/$f" "/usr/share/pacman/keyrings/$f"
done

# The base image has an empty private-keys-v1.d, so there is no local signing
# key until --init makes one. --populate needs it.
pacman-key --init
pacman-key --populate archlinux "$keyring"

#---------------------------------------------------------------------------#
# 6. Validity
#
# ⛔ A key in the keyring is not enough: a signer below full validity signs
# nothing that pacman accepts. Each key that the pin dates in the future must
# be fully valid after populate. A key past its pinned expiry is named and
# skipped, because it signs nothing that pacman accepts.
#---------------------------------------------------------------------------#
gpg --homedir "$GPG_HOMEDIR" --no-permission-warning --batch \
  --with-colons --fixed-list-mode --list-keys > "$work/installed.colons"

awk -F: '
  $1 == "pub" { validity = $2; seen = 1; next }
  $1 == "fpr" && seen { printf "%s %s\n", $10, validity; seen = 0 }
' "$work/installed.colons" | LC_ALL=C sort > "$work/installed-validity.txt"

today="$(date -u +%Y-%m-%d)"
usable=0
lapsed=""
bad=""
while IFS= read -r line; do
  [ -n "$line" ] || continue
  fpr="${line%% *}"
  want="${line#* }"
  if [ "$want" != "never" ] && [ "$want" '<' "$today" ]; then
    lapsed="$lapsed $fpr(expired $want)"
    continue
  fi
  got="$(awk -v f="$fpr" '$1 == f { print $2; exit }' "$work/installed-validity.txt")"
  case "$got" in
    f | u) usable=$((usable + 1)) ;;
    "") bad="$bad $fpr(not in the keyring after populate)" ;;
    *) bad="$bad $fpr(validity $got)" ;;
  esac
done < "$work/pin-trusted.txt"

if [ -n "$bad" ]; then
  die "a key that $pin dates in the future is not fully valid after populate" \
    "not usable:$bad" \
    "gpg gives validity as one letter: f full, u ultimate, m marginal, e expired, r revoked, - unknown" \
    "a trusted key below full validity signs nothing that pacman accepts" \
    "reproduce: gpg --homedir $GPG_HOMEDIR --with-colons --list-keys"
fi

if [ "$usable" -eq 0 ]; then
  die "$pin has no usable key" \
    "each pinned fingerprint is past its expiry on $today" \
    "pacman cannot check a package of this port" \
    "reproduce: cat $pin"
fi

if [ -n "$lapsed" ]; then
  echo "==> warning: pinned keys past their expiry, skipped:$lapsed"
fi
echo "==> $usable of $pinned_count pinned keys are fully valid, SigLevel stays Required"

#---------------------------------------------------------------------------#
# 7. Follow the newest keyring of the port, through the pinned trust root
#
# ⭐ The pin is the trust root. The port signs its packages against its newest
# keyring, which can be newer than the pin. pacman downloads the newer package
# and checks its signature against the keyring populated above. pacman deletes
# a package with a signer that is not fully trusted. So only a keyring that a
# pinned key signed gets through, as on a running system.
#
# ⚠ A failure here is not fatal. The pinned keyring stays. When the port
# cannot be read here, pacstrap stops next and pacman gives the reason.
#---------------------------------------------------------------------------#
follow_forward() {
  local fdb="$work/forward-db" fcache="$work/forward-cache" newest newer_rc
  local -a pac
  mkdir -p "$fdb/local" "$fcache"
  pac=(pacman --config "$PACMAN_CONF" --dbpath "$fdb" --cachedir "$fcache"
       --gpgdir "$GPG_HOMEDIR" --logfile "$work/forward.log" --noconfirm)

  if ! "${pac[@]}" -Sy > "$work/forward.out" 2>&1; then
    echo "==> warning: the databases of the port cannot be read from here, so the pinned keyring stays"
    sed 's/^/    /' "$work/forward.out"
    return 0
  fi
  if ! "${pac[@]}" -Sp -dd --print-format '%f' "$keyring-keyring" > "$work/forward.out" 2>&1; then
    echo "==> warning: the databases of the port have no $keyring-keyring, so the pinned keyring stays"
    sed 's/^/    /' "$work/forward.out"
    return 0
  fi
  newest="$(awk -v k="$keyring-keyring-" 'index($0, k) == 1 { print; exit }' "$work/forward.out")"
  if [ -z "$newest" ]; then
    echo "==> warning: pacman gave no $keyring-keyring package, so the pinned keyring stays"
    sed 's/^/    /' "$work/forward.out"
    return 0
  fi
  if [ "$newest" = "$pkg" ]; then
    echo "==> the newest keyring of the port is the pinned one, $pkg"
    return 0
  fi
  # vercmp compares pkgver-pkgrel: the name, the architecture and the
  # extension come off.
  local v_new v_pin
  v_new="${newest#"$keyring-keyring-"}"
  v_new="${v_new%-*.pkg.tar.*}"
  v_pin="${pkg#"$keyring-keyring-"}"
  v_pin="${v_pin%-*.pkg.tar.*}"
  newer_rc="$(vercmp "$v_new" "$v_pin")"
  if [ "$newer_rc" -le 0 ]; then
    echo "==> warning: the port serves $newest, which is not newer than the pin $pkg, so the pin stays"
    return 0
  fi

  echo "==> the port serves $newest, newer than the pin $pkg"
  if ! "${pac[@]}" -Sw -dd "$keyring-keyring" > "$work/forward.out" 2>&1; then
    echo "==> warning: pacman refused $newest, so the pinned keyring stays"
    sed 's/^/    /' "$work/forward.out"
    return 0
  fi
  [ -f "$fcache/$newest" ] || die "pacman downloaded $newest, and it is not in $fcache" \
    "reproduce: ls $fcache"

  mkdir -p "$work/forward-x"
  bsdtar -xf "$fcache/$newest" -C "$work/forward-x"
  local fsrc="$work/forward-x/usr/share/pacman/keyrings" f
  for f in "$keyring.gpg" "$keyring-trusted" "$keyring-revoked"; do
    if [ ! -f "$fsrc/$f" ]; then
      echo "==> warning: $newest has no $f, so the pinned keyring stays"
      return 0
    fi
  done

  cut -d: -f1 < "$fsrc/$keyring-trusted" | awk 'NF' | LC_ALL=C sort > "$work/forward-fprs.txt"
  echo "    a key of the pin signed it, and pacman checked the signature"
  echo "    trusted keys added  : $(LC_ALL=C comm -13 "$work/pin-fprs.txt" "$work/forward-fprs.txt" | tr '\n' ' ')"
  echo "    trusted keys removed: $(LC_ALL=C comm -23 "$work/pin-fprs.txt" "$work/forward-fprs.txt" | tr '\n' ' ')"

  for f in "$keyring.gpg" "$keyring-trusted" "$keyring-revoked"; do
    install -Dm644 "$fsrc/$f" "/usr/share/pacman/keyrings/$f"
  done
  pacman-key --populate "$keyring"

  gpg --homedir "$GPG_HOMEDIR" --no-permission-warning --batch \
    --with-colons --fixed-list-mode --list-keys > "$work/forward.colons"
  local fresh
  fresh="$(awk -F: 'NR == FNR { want[$1] = 1; next }
                    $1 == "pub" { validity = $2; seen = 1; next }
                    $1 == "fpr" && seen { if (($10 in want) && (validity == "f" || validity == "u")) n++; seen = 0 }
                    END { print n + 0 }' "$work/forward-fprs.txt" "$work/forward.colons")"
  [ "$fresh" -gt 0 ] || die "after populate, the keyring $newest has no fully valid trusted key" \
    "its signature agreed with the pin, and then it trusts no key that pacman can use" \
    "reproduce: gpg --homedir $GPG_HOMEDIR --with-colons --list-keys"
  echo "==> now $newest, $fresh of its trusted keys fully valid"
}
follow_forward
