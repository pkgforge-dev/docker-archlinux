#!/usr/bin/env bash
#
# Write /etc/os-release into a new root.
#
#   write-os-release ROOT VERSION
#
# No package owns /etc/os-release. The filesystem package ships
# /usr/lib/os-release, and the release tools of Arch Linux write
# /etc/os-release with a release id. A pacstrap root does not get one, and no
# port ships a VERSION_ID, so the build gives the value.
#
# It copies ROOT/usr/lib/os-release to ROOT/etc/os-release and adds VERSION_ID,
# IMAGE_ID and IMAGE_VERSION.
#
# Exit status: 0 written, 1 the source is missing or has a VERSION_ID.
set -euo pipefail

root="${1:?usage: write-os-release ROOT VERSION}"
version="${2:?usage: write-os-release ROOT VERSION}"

src="$root/usr/lib/os-release"
dst="$root/etc/os-release"

if [ ! -f "$src" ]; then
  echo "write-os-release: $src is missing, so the filesystem package did not install" >&2
  exit 1
fi

if grep -qE '^VERSION_ID=' "$src"; then
  echo "write-os-release: $src has a VERSION_ID, and two values would conflict" >&2
  exit 1
fi

install -Dm644 "$src" "$dst"
{
  printf 'VERSION_ID=%s\n' "$version"
  printf 'IMAGE_ID=archlinux\n'
  printf 'IMAGE_VERSION=%s\n' "$version"
} >> "$dst"

id="$(awk -F= '$1 == "ID" { print $2; exit }' "$dst")"
echo "==> wrote $dst with ID=$id VERSION_ID=$version"
