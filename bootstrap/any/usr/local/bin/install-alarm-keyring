#!/bin/bash
#
# Install the Arch Linux ARM signing key into the build host's pacman keyring,
# against the pin in bootstrap/keyrings/archlinuxarm.pin.
#
# Only the ARM ports need this. For every other architecture this exits 0
# without touching the keyring.
#
# The build host is told which architecture it is installing for by the
# Architecture line of the pacman.conf it was given.
set -euo pipefail

PIN="${ALARM_KEYRING_PIN:-/usr/local/share/docker-archlinux/archlinuxarm.pin}"
MIRROR="${ALARM_KEYRING_MIRROR:-http://mirror.archlinuxarm.org/aarch64/core}"

arch="$(awk -F= '/^[[:space:]]*Architecture[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /etc/pacman.conf)"
case "$arch" in
  aarch64 | armv7h) ;;
  "")
    echo "install-alarm-keyring: no Architecture in /etc/pacman.conf" >&2
    exit 1
    ;;
  *)
    echo "==> $arch does not use the Arch Linux ARM keyring, nothing to do"
    exit 0
    ;;
esac

if [ ! -f "$PIN" ]; then
  echo "install-alarm-keyring: pin file not found: $PIN" >&2
  exit 1
fi

field() {
  awk -F= -v k="$1" '$0 !~ /^[[:space:]]*#/ && $1 ~ k { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$PIN"
}
pkg="$(field '^[[:space:]]*package')"
want_sha="$(field '^[[:space:]]*sha256')"
want_fpr="$(field '^[[:space:]]*master')"

for v in pkg want_sha want_fpr; do
  if [ -z "${!v}" ]; then
    echo "install-alarm-keyring: $PIN is missing a value for ${v#want_}" >&2
    exit 1
  fi
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

echo "==> fetching $pkg"
if ! curl -sSfL --connect-timeout 15 --max-time 180 --retry 3 --retry-delay 3 \
     -o "$work/keyring.pkg" "$MIRROR/$pkg"; then
  cat >&2 <<MSG
install-alarm-keyring: cannot fetch the pinned keyring package.

  wanted: $MIRROR/$pkg

Arch Linux ARM removes superseded keyring packages from the mirror, so this
usually means the pin is behind. Re-derive the values and update
bootstrap/keyrings/archlinuxarm.pin. The steps are in that file.
MSG
  exit 1
fi

got_sha="$(sha256sum "$work/keyring.pkg" | cut -d' ' -f1)"
if [ "$got_sha" != "$want_sha" ]; then
  echo "install-alarm-keyring: checksum mismatch for $pkg" >&2
  echo "  pinned: $want_sha" >&2
  echo "  fetched: $got_sha" >&2
  exit 1
fi
echo "==> sha256 matches the pin"

mkdir -p "$work/x"
bsdtar -xf "$work/keyring.pkg" -C "$work/x"

got_fpr="$(cut -d: -f1 < "$work/x/usr/share/pacman/keyrings/archlinuxarm-trusted")"
if [ "$got_fpr" != "$want_fpr" ]; then
  echo "install-alarm-keyring: master key fingerprint mismatch" >&2
  echo "  pinned: $want_fpr" >&2
  echo "  package carries: $got_fpr" >&2
  exit 1
fi
echo "==> master key fingerprint matches the pin"

for f in archlinuxarm.gpg archlinuxarm-trusted archlinuxarm-revoked; do
  install -Dm644 "$work/x/usr/share/pacman/keyrings/$f" "/usr/share/pacman/keyrings/$f"
done

# The official image ships an empty private-keys-v1.d, so there is no local
# signing key and --populate cannot sign anything until --init regenerates one.
pacman-key --init
pacman-key --populate archlinux archlinuxarm

if ! pacman-key --list-keys "$want_fpr" >/dev/null; then
  echo "install-alarm-keyring: $want_fpr is not in the keyring after populate" >&2
  exit 1
fi
echo "==> Arch Linux ARM signing key is trusted, SigLevel stays Required"
