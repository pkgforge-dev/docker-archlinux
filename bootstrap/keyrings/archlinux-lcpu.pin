# The package signing trust root of the loong64 port (LCPU).
#
# The Linux Club of Peking University publishes the port and signs with keys
# that archlinux-keyring does not have. This pin gives the keyring package, its
# sha256 and its trusted keys, so SigLevel = Required stays on. The fields are
# in archlinuxarm.pin.
#
# ⛔ The key that signs the keyring package is in the keyring. So the pin holds
# the sha256, and the fingerprints were compared with keys.openpgp.org and
# keyserver.ubuntu.com, which serve no packages.
#
# ⚠ Some trusted keys are past their expiry, and one more expires on the date
# its line gives. install-port-keyring skips an expired key, and stops when a
# key that the pin dates in the future is not fully valid.
#
# ⚠ The expiry dates come from the key material in the package, so they change
# only with the package.
#
# ⚠ mirrors.pku.edu.cn cannot be a mirror line here: it answers a directory with
# a JavaScript page, and scripts/check-keyring-pin finds no package in it.
#
# To read the values again, on a host with bsdtar and gpg:
#   curl -sSfL --connect-timeout 15 --max-time 120 -o k.pkg.tar.zst <mirror>/<package>
#   sha256sum k.pkg.tar.zst
#   bsdtar -xOf k.pkg.tar.zst usr/share/pacman/keyrings/archlinux-lcpu-trusted
#   bsdtar -xOf k.pkg.tar.zst usr/share/pacman/keyrings/archlinux-lcpu.gpg | \
#     gpg --with-colons --show-keys
#
# Adopted 2026-10-13. Verified on that date against a mirror line below.

keyring = archlinux-lcpu
arch    = loong64
mirror  = https://ghcr.mirror.archlinux.pkgforge.dev/loong64/core
mirror  = https://loongarchlinux.lcpu.dev/loongarch/archlinux/core/os/loong64
package = archlinux-lcpu-keyring-20260906-1-any.pkg.tar.zst
sha256  = 09ab1bfa4e4e5c06863f3ce21e5bc8a734c05f88eacbb58ee7de13603cddf42f
trusted = 49E74F2DF61CFF4217AB8EB737EFC8DBFB4CC627 2029-02-24
trusted = 5CDE9ADCBD04454BAF547A1C40D0304E1192746B 2026-04-24
trusted = 60922C5D40F6297BC1616C270A8F993ECADF8CE7 2026-07-14
trusted = 65D4986C7904C6DBF2C4DD9A4E4E02B70BA5C468 2031-04-01
trusted = 7A9B819083ED51654DED13C9717A69D3E5AF9CBB never
trusted = 8C7F6B7B9B90AE02C2ACB633F0647F18A79089C9 never
trusted = 99B2D2B96495AEC3447EF1899C36B961066CC8EF never
trusted = A6C02FBE730CD45859B946E15C74AE170BDA1433 never
