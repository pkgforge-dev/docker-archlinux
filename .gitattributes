# The repository keeps LF line ends, on every platform. The rule is part of
# the repository, so a machine with other git settings still makes correct
# commits.
#
# Linux reads many files of the tree as they are. A CRLF in
# bootstrap/any/usr/local/bin/pacstrap-docker makes its #! line
# "/bin/bash\r", and the image says "bad interpreter". pacman reads the .hook
# files, pacman.conf and the mirror lists as they are too.
#
# Check with `git ls-files --eol`. The index column decides what a commit
# holds, and each text file must read i/lf there.

* text=auto eol=lf

# Each name below keeps its rule if the line above changes.
Dockerfile      text eol=lf
pacstrap-docker text eol=lf
pacman-oci      text eol=lf
mirrorlist      text eol=lf
mirrorlist-*    text eol=lf
*.anchors       text eol=lf
*.pool          text eol=lf
*.pin           text eol=lf
*.hook          text eol=lf
*.conf          text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.jsonl         text eol=lf
*.tsv           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.asc           text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# The bytes are the content: no translation. The keyring packages in
# bootstrap/keyrings/ follow these rules. A signature or an archive with
# changed line ends is corrupt, and git still shows it as committed.
*.sig           binary
*.gpg           binary
*.tar           binary
*.gz            binary
*.xz            binary
*.zst           binary
*.db            binary
