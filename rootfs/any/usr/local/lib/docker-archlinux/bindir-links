#!/bin/sh
#
# Make an executable that a package installs outside PATH callable by name.
#
#   /usr/local/lib/docker-archlinux/bindir-links
#
# Arch installs perl scripts in /usr/bin/vendor_perl, /usr/bin/site_perl and
# /usr/bin/core_perl. These are not on PATH. The perl package adds them in
# /etc/profile.d/perlbin.sh, which only a login shell reads:
#
#   podman run <image> exiftool            command not found
#   podman run <image> bash -lc exiftool   /usr/bin/vendor_perl/exiftool
#
# The official image has the same behaviour (upstream issue 80).
#
# ⛔ PATH stays the PATH of the official image. A symbolic link in
# /usr/local/bin, which is on PATH, makes the name callable. The filesystem
# package owns /usr/local/bin, and no package puts a file in it.
#
# ⛔ No link hides a name. A name that already resolves gets no link.
#
# To remove the behaviour:
#
#   rm /etc/pacman.d/hooks/bindir-links.hook
#   find /usr/local/bin -lname '/usr/bin/*_perl/*' -delete
#
# /etc/pacman.d/hooks/bindir-links.hook runs this after a transaction that
# changes /usr/bin. It makes the links agree with the files, so a second run
# changes nothing.
set -eu

LINKDIR=/usr/local/bin

# The directories under /usr/bin with executables that are not on PATH.
# ⚠ Separated by spaces, so a path here has no space in it.
BINDIRS="/usr/bin/core_perl /usr/bin/site_perl /usr/bin/vendor_perl"

# A name in one of these directories gets no link. /usr/sbin, /sbin and /bin
# are symbolic links to /usr/bin, so /usr/bin covers the three.
# tests/image/60-defect-parity.sh checks those links.
SEARCHDIRS="/usr/local/sbin /usr/bin"

[ -d "$LINKDIR" ] || exit 0

linked=0
pruned=0

# in_bindir PATH -> 0 when PATH names something inside one of BINDIRS
in_bindir() {
  for d in $BINDIRS; do
    case "$1" in
      "$d"/*) return 0 ;;
    esac
  done
  return 1
}

# resolves NAME -> 0 when NAME is already reachable without LINKDIR
resolves() {
  for d in $SEARCHDIRS; do
    if [ -e "$d/$1" ]; then
      return 0
    fi
  done
  return 1
}

#---------------------------------------------------------------------------#
# 1. Remove links.
#
# A link of this script goes when its target is gone, and when a package now
# has the name. So a package that later installs /usr/bin/exiftool gets the
# name, not the old link.
#
# ⛔ Only links into BINDIRS change. All else in /usr/local/bin belongs to the
# consumer.
#---------------------------------------------------------------------------#
for link in "$LINKDIR"/*; do
  if [ ! -L "$link" ]; then
    continue
  fi
  if ! in_bindir "$(readlink "$link")"; then
    continue
  fi
  name="${link##*/}"
  # -e follows the link, so false means the target is gone.
  if [ ! -e "$link" ] || resolves "$name"; then
    rm -f "$link"
    pruned=$((pruned + 1))
  fi
done

#---------------------------------------------------------------------------#
# 2. Make a link for each name that does not resolve.
#---------------------------------------------------------------------------#
for dir in $BINDIRS; do
  if [ ! -d "$dir" ]; then
    continue
  fi
  for f in "$dir"/*; do
    if [ ! -f "$f" ] || [ ! -x "$f" ]; then
      continue
    fi
    name="${f##*/}"
    if resolves "$name"; then
      continue
    fi
    if [ -L "$LINKDIR/$name" ]; then
      current="$(readlink "$LINKDIR/$name")"
      # The link is correct. Do not make it again: the count would then
      # show a change when there is none.
      if [ "$current" = "$f" ]; then
        continue
      fi
      # A link to another place belongs to the consumer. It stays.
      if ! in_bindir "$current"; then
        continue
      fi
    elif [ -e "$LINKDIR/$name" ]; then
      # A file here belongs to the consumer.
      continue
    fi
    ln -sfn "$f" "$LINKDIR/$name"
    linked=$((linked + 1))
  done
done

# Print a line only when something changed.
if [ "$linked" -gt 0 ] || [ "$pruned" -gt 0 ]; then
  printf '  %d linked, %d pruned in %s\n' "$linked" "$pruned" "$LINKDIR"
fi
