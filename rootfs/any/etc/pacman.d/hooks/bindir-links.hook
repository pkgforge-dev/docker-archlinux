# Make an executable that a package installs outside PATH callable by name.
#
# /usr/local/lib/docker-archlinux/bindir-links gives what it does and why.
#
# The trigger is each path under /usr/bin, so a package that later installs a
# name removes the link to the same name. A pattern with no slash after the
# star does not match a file one directory deeper, so both patterns are here.
#
# ⭐ Exec names the interpreter, not the script. So the hook works when the
# script has no execute bit.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/bin/*
Target = usr/bin/*/*

[Action]
Description = Linking executables installed outside PATH...
Depends = coreutils
Depends = bash
When = PostTransaction
Exec = /bin/sh /usr/local/lib/docker-archlinux/bindir-links
