# The `any` architecture database, which ArchPOWER keeps separate.
#
# ⛔ This is a second database, not a second mirror of the first. base/any holds
# the packages that carry no architecture, and iana-etc is one of them, so a
# root built from the architecture specific database alone cannot satisfy the
# dependencies of filesystem and unwinds all the way back to base.
#
# ⚠ The path is base/any. It is not $repo/$arch for any value of either, which
# is why it cannot go in the ranked list and gets a file of its own.
#
# The second entry is the read through proxy, for the same reason as in
# mirrors/<arch>.anchors: the origin refuses datacentre address ranges.
Server = https://repo.archlinuxpower.org/base/any
Server = https://api.rv.pkgforge.dev/https://repo.archlinuxpower.org/base/any
