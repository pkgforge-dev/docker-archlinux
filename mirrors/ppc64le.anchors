# Anchors for ppc64le. scripts/gen-mirrorlist writes them first, in this order.
# It never ranks or drops them. At least one must answer.
#
# The first is the GHCR mirror (pkgforge-dev/mirror-archlinux). The second is
# the ArchPOWER origin. The third is a read-through proxy of the origin.
# ArchPOWER has no other mirror, so this port has no pool file.
# ⚠ The origin and the proxy answer HTTP 403 to GitHub runner addresses.
Server = https://ghcr.mirror.archlinux.pkgforge.dev/$arch/$repo
Server = https://repo.archlinuxpower.org/$repo/$arch
Server = https://api.rv.pkgforge.dev/https://repo.archlinuxpower.org/$repo/$arch
