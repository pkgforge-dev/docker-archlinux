# Anchors for amd64. scripts/gen-mirrorlist writes them first, in this order.
# It never ranks or drops them. At least one must answer.
#
# The first is the GHCR mirror (pkgforge-dev/mirror-archlinux). The second is
# the GeoIP endpoint of Arch Linux. SigLevel stays Required, so a mirror cannot
# change a package.
Server = https://ghcr.mirror.archlinux.pkgforge.dev/$arch/$repo
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
