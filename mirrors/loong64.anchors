# Anchors for loong64. scripts/gen-mirrorlist writes them first, in this order.
# It never ranks or drops them. At least one must answer.
#
# The first is the GHCR mirror (pkgforge-dev/mirror-archlinux). The second is
# the server on the domain of the port maintainers (LCPU).
Server = https://ghcr.mirror.archlinux.pkgforge.dev/$arch/$repo
Server = https://loongarchlinux.lcpu.dev/loongarch/archlinux/$repo/os/$arch
