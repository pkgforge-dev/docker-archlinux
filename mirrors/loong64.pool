# Candidate servers for loong64. scripts/gen-mirrorlist probes them and writes
# the fastest after the anchors.
#
# These are the servers of /etc/pacman.d/mirrorlist-loong64 in the package
# pacman-mirrorlist-loong64, less the anchor. A server that does not answer is
# not written, and stays here.
#
# To read them again:
#   B=https://loongarchlinux.lcpu.dev/loongarch/archlinux/core/os/loong64
#   pkg=$(curl -sSfL --connect-timeout 15 --max-time 60 "$B/" | grep -oE 'pacman-mirrorlist-loong64-[0-9][0-9a-zA-Z.-]*\.pkg\.tar\.[a-z]+' | sort -u -V | tail -1)
#   curl -sSfL --connect-timeout 15 --max-time 60 -o m.pkg "$B/$pkg"
#   bsdtar -xOf m.pkg etc/pacman.d/mirrorlist-loong64
Server = https://mirrors.wsyu.edu.cn/loongarch/archlinux/$repo/os/$arch
Server = https://mirrors.pku.edu.cn/loongarch-lcpu/archlinux/$repo/os/$arch
Server = https://mirrors.nju.edu.cn/loongarch/archlinux/$repo/os/$arch
Server = https://mirror.iscas.ac.cn/loongarch/archlinux/$repo/os/$arch
Server = https://mirrors.pku.edu.cn/loongarch/archlinux/$repo/os/$arch
