# Anchors for armv7. scripts/gen-mirrorlist writes them first, in this order.
# It never ranks or drops them. At least one must answer.
#
# The first is the GHCR mirror (pkgforge-dev/mirror-archlinux), over https.
# The second is the GeoIP endpoint of Arch Linux ARM.
# ⚠ mirror.archlinuxarm.org serves plain http only.
Server = https://ghcr.mirror.archlinux.pkgforge.dev/$arch/$repo
Server = http://mirror.archlinuxarm.org/$arch/$repo
