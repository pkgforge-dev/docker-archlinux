# Anchors for the [base-any] repository of ppc64. scripts/gen-mirrorlist writes
# them in this order to rootfs/ppc64/etc/pacman.d/mirrorlist-any.
# At least one must answer.
#
# [base-any] holds the packages with no architecture, for example iana-etc.
# On the GHCR mirror, $arch/$repo gives /<arch>/base-any. On the origin and
# the proxy, the path is base/any.
# ⚠ The origin and the proxy answer HTTP 403 to GitHub runner addresses.
Server = https://ghcr.mirror.archlinux.pkgforge.dev/$arch/$repo
Server = https://repo.archlinuxpower.org/base/any
Server = https://api.rv.pkgforge.dev/https://repo.archlinuxpower.org/base/any
